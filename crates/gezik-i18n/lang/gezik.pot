msgctxt "setting:system.single-instance"
msgid "Single instance"
msgstr ""

#: crates/gezik-config/templates/settings.toml
msgctxt "setting:system.single-instance"
msgid "A second `gezik` (a folder from the command line, a script, another app) opens in the window used last instead of a new process; `gezik --new-window` opens a new window in it. Off: every `gezik` is a process of its own. Read at start."
msgstr ""

#: crates/gezik-config/templates/settings.toml
msgctxt "setting:system.quick-look"
msgid "Quick look"
msgstr ""

