#: crates/gezik-config/templates/settings.toml
msgctxt "setting:language"
msgid "Interface language: \"auto\" follows the system; or a code: \"en\", or the name of a file in the lang folder (lang/pl.po -> \"pl\"). \"pseudo\" shows every text marked and lengthened, for translators."
msgstr ""

#: crates/gezik-config/templates/settings.toml
msgctxt "setting:start-folder"
msgid "Start folder"
msgstr ""

#: crates/gezik-config/templates/settings.toml
msgctxt "setting:start-folder"
msgid "Where new tabs open: \"{home}\", \"drives\" (This PC), or any folder. Tokens like {home}, {documents}, {downloads} work on every OS."
msgstr ""

#: crates/gezik-config/templates/settings.toml
msgctxt "setting:max-fps"
msgid "Max fps"
msgstr ""

#: crates/gezik-config/templates/settings.toml
msgctxt "setting:max-fps"
msgid "Most frames drawn per second, e.g. while scrolling. Lower saves CPU on high refresh rate displays; 0 draws as many as the display shows."
msgstr ""

#: crates/gezik-config/templates/settings.toml
msgctxt "setting:session.restore"
msgid "Restore"
msgstr ""

#: crates/gezik-config/templates/settings.toml
msgctxt "setting:session.restore"
msgid "Open the tabs of last time at start, in order, with the one in front and the locks (kept in state.toml, this computer's own). false: one tab in start-folder, the kept tabs forgotten."
msgstr ""

#: crates/gezik-config/templates/settings.toml
msgctxt "setting:history.remember"
msgid "Remember"
msgstr ""

#: crates/gezik-config/templates/settings.toml
msgctxt "setting:history.remember"
msgid "Remember the folders you open, for the address bar's Recent and Frequent lists (kept in state.toml). false also forgets them; \"clear-history\" (no key by default) empties the list."
msgstr ""

