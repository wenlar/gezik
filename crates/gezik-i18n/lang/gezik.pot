msgstr ""

#: crates/gezik-config/templates/settings.toml
msgctxt "setting:keyboard.typing"
msgid "Jump | filter. What typing a letter on the file list does: \"jump\" goes to the first name starting with what you typed; \"filter\" opens the filter (Ctrl+F, or / ) with it."
msgstr ""

