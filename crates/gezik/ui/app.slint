                    // Grabbable over 5px, between the panes; a double-click puts it in the middle.
                    if root.dual: Rectangle {
                        x: root.split-x - self.width;
                        width: 5px;
                        height: parent.height;
                        accessible-role: none;
                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            width: 1px;
                            background: pane-splitter.has-hover || pane-splitter.pressed ? Theme.accent : transparent;
                        }
                        pane-splitter := TouchArea {
                            mouse-cursor: col-resize;
                            // From where the pointer is, not by steps: a pane at its minimum does not let the share run on.
                            moved => { root.pane-split-moved((parent.x + self.mouse-x - self.pressed-x) / max(1px, panes-row.width - 5px)); }
                            changed pressed => { if !self.pressed { root.pane-split-done(); } }
                            double-clicked => { root.pane-split-reset(); }
                        }
                        // Sync browsing: a link between the two address bars.
                        if root.view-sync: Path {
                            x: (parent.width - self.width) / 2;
                            y: Theme.tab-strip-height + (Theme.toolbar-height - self.height) / 2;
                            width: 12px;
                            height: 12px;
                            viewbox-width: 16;
                            viewbox-height: 16;
                            commands: Glyph.link;
                            stroke: Theme.accent;
                            stroke-width: 1.5px;
                            stroke-line-cap: round;
                        }
                    }
