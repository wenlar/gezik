        if root.info-open: InfoLayer {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            open: root.info-open;
            focus-request: root.info-focus-seq;
            dialog-open: root.dialog-open || root.conflicts-open;
            view: root.info-view;
