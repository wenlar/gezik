            owner-accepted => { root.info-owner-accepted(); }
            group-accepted => { root.info-group-accepted(); }
            octal-accepted => { root.info-octal-accepted(); }
            group-menu(x, y, r, t) => { root.info-group-menu(x, y, r, t); }
            enclosed => { root.info-enclosed(); }
            app-menu(x, y, r, t) => { root.info-app-menu(x, y, r, t); }
            change-all => { root.info-change-all(); }
            as-admin => { root.info-as-admin(); }
            close => { root.info-close(); }
        }
        if root.conflicts-open: ConflictList {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            open: root.conflicts-open;
            focus-request: root.conflict-focus-seq;
            reveal-index: root.conflict-reveal-index;
            reveal-request: root.conflict-reveal-seq;
            dialog-open: root.dialog-open;
            title: root.conflict-title;
            rows: root.conflict-rows;
            identical-count: root.conflict-identical-count;
            hide-identical: root.conflict-hide-identical;
            apply-all: root.conflict-apply-all;
            footer: root.conflict-footer;
            scroll <=> root.conflict-scroll;
            decide(i) => { root.conflict-decide(i); }
            set-apply-all(all) => { root.conflict-set-apply-all(all); }
            toggle-identical => { root.conflict-toggle-identical(); }
            pressed(i, ctrl, shift) => { root.conflict-pressed(i, ctrl, shift); }
            row-menu(i, x, y) => { root.conflict-row-menu(i, x, y); }
            start => { root.conflict-start(); }
            cancel-operation => { root.conflict-cancel(); }
            key(event) => { return root.conflict-key(event); }
        }
        if root.path-rows.length > 0: PathSuggestions {
            x: root.address-box.address-x;
            y: root.address-box.address-y + root.address-box.address-height + 2px;
            width: max(root.address-box.address-width, 320px);
            rows: root.path-rows;
            current: root.path-current;
            chosen(path) => { root.path-chosen(path); }
        }
        if root.dialog-open: Dialog {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            title: root.dialog-title;
            message: root.dialog-message;
            buttons: root.dialog-buttons;
            escape: root.dialog-escape;
            has-input: root.dialog-has-input;
            input <=> root.dialog-input;
            input-secret: root.dialog-input-secret;
            show-secret <=> root.dialog-show-secret;
            note: root.dialog-note;
            note-error: root.dialog-note-error;
            chosen(i) => { root.dialog-chosen(i); }
            edited(text) => { root.dialog-edited(text); }
        }
        if root.offer-label != "": Rectangle {
            x: root.drag-x + 14px;
            y: root.drag-y + 24px;
            width: offer-text.preferred-width + Theme.spacing * 2;
            height: offer-text.preferred-height + Theme.spacing;
            border-radius: Theme.radius;
            background: Theme.surface-raised;
            border-width: 1px;
            border-color: Theme.border;
            accessible-role: none;
            offer-text := Text {
                x: Theme.spacing;
                y: Theme.spacing / 2;
                text: root.offer-label;
                color: Theme.foreground;
            }
        }
        // What is being dragged, just below and right of the pointer. Takes no input.
        if root.drag-active: Rectangle {
            x: root.drag-x + 14px;
            y: root.drag-y + 14px;
            width: max(Theme.icon-size * 2 + 8px, label-box.width);
            height: Theme.icon-size * 2 + (root.drag-label != "" ? label-box.height + 4px : 0px);
            accessible-role: none;
            FileIcon {
                x: 0;
                y: 0;
                width: Theme.icon-size * 2;
                height: Theme.icon-size * 2;
                opacity: root.drag-forbidden ? 0.4 : 0.85;
                kind: root.drag-kind;
                picture: root.drag-icon;
                has-picture: root.drag-has-icon;
            }
            if root.drag-count > 1: Rectangle {
                x: Theme.icon-size * 2 - self.width / 2;
                y: -4px;
                width: max(self.height, count-text.preferred-width + 8px);
                height: count-text.preferred-height + 2px;
                border-radius: self.height / 2;
                background: Theme.accent;
                count-text := Text {
                    text: root.drag-count;
                    color: Theme.accent-foreground;
                    font-size: Theme.font-size * 0.85;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            label-box := Rectangle {
                x: 0;
                y: Theme.icon-size * 2 + 4px;
                visible: root.drag-label != "";
                width: label-text.preferred-width + Theme.spacing * 2;
                height: label-text.preferred-height + Theme.spacing;
                border-radius: Theme.radius;
                background: Theme.surface-raised;
                border-width: 1px;
                border-color: Theme.border;
                label-text := Text {
                    x: Theme.spacing;
                    y: Theme.spacing / 2;
                    text: root.drag-label;
                    color: Theme.foreground;
                }
            }
        }
        // The sidebar's tip, inside the window.
        if root.sidebar-tip != "": Rectangle {
            x: max(4px, min(root.sidebar-tip-x, root.width - self.width - 4px));
            y: min(root.sidebar-tip-y, root.height - self.height - 4px);
            width: tip-label.preferred-width + 12px;
            height: tip-label.preferred-height + 8px;
            background: Theme.surface-raised;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius;
            accessible-role: none;
            // Fades in as it opens (it is made by an `if`, so it starts hidden).
            property <bool> shown;
            init => { self.shown = true; }
            opacity: self.shown ? 1 : 0;
            animate opacity { duration: Theme.motion-popup; }
            tip-label := Text {
                x: 6px;
                y: 4px;
                text: root.sidebar-tip;
                color: Theme.foreground;
            }
        }
    }

    // Gezik's own menu (where Slint has no system one), over everything.
    popup-menu := PopupMenu {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        lines: root.menu-lines;
        subs: root.menu-subs;
        place(x, y, fx, fy, w, h, aw, ah) => { return root.place-menu(x, y, fx, fy, w, h, aw, ah); }
        step(lines, from, down) => { return root.menu-step(lines, from, down); }
        activated(id) => { root.menu-activated(id); }
        closed => {
            root.menu-closed();
            if !root.dialog-open {
                root.menu-gives-keyboard-back();
            }
        }
    }
}

// Space on the file list: the selection, big. Space or Esc closes it; the arrow keys move
// in the list underneath.
export component QuickLookWindow inherits Window {
    in property <PreviewInfo> info;
    in property <string> mono-font;
    title: root.info.title == "" ? "Gezik" : root.info.title + " — Gezik";
    background: Theme.background;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size;
    // Every key press; returns whether it was used.
    callback key(KeyEvent) -> bool;

    init => { scope.focus(); }

    scope := FocusScope {
        key-pressed(event) => {
            if root.key(event) {
                return accept;
            }
            return reject;
        }
        PreviewPane {
            info: root.info;
            mono-font: root.mono-font;
        }
    }
}
