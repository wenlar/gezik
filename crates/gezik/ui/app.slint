import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Glyph } from "glyphs.slint";
import { CrumbItem } from "widgets/breadcrumb.slint";
import { TabItem } from "widgets/tab-bar.slint";
import { Sidebar, SidebarRow } from "widgets/sidebar.slint";
import { PreviewPane, PreviewInfo } from "widgets/preview-pane.slint";
import { FileRow, ItemRow } from "widgets/file-view.slint";
import { OpsPanel, OpRow } from "widgets/ops-panel.slint";
import { DropStack, StackRow } from "widgets/drop-stack.slint";
import { Dialog } from "widgets/dialog.slint";
import { ConflictList, ConflictRow } from "widgets/conflict-list.slint";
import { RenameBatch, RuleRow, RenamePreviewRow, RuleOptions } from "widgets/rename-batch.slint";
import { FileIcon } from "widgets/file-icon.slint";
import { CompressLayer } from "widgets/compress.slint";
import { ConvertLayer, ConvertView } from "widgets/convert.slint";
import { InfoLayer, InfoView } from "widgets/info.slint";
import { PopupMenu, MenuEntry, MenuPlace, MenuSub } from "widgets/popup-menu.slint";
import { Picker, PickRow } from "widgets/picker.slint";
import { PathSuggestions, PathRow } from "widgets/path-suggestions.slint";
import { PaneView, PaneData, PaneGeometry, PaneFocus } from "widgets/pane.slint";
import { ColumnItem } from "widgets/column-view.slint";

// Re-exported so Rust can set it with `window.global::<Theme>()` and build crumbs, tabs
// and sidebar rows.
export { Theme, PreviewInfo, CrumbItem, TabItem, SidebarRow, FileRow, ItemRow, OpRow, StackRow, ConflictRow, RuleRow, RenamePreviewRow, RuleOptions, ConvertView, InfoView, MenuEntry, MenuPlace, MenuSub, PickRow, PathRow, PaneData, PaneGeometry, PaneFocus, ColumnItem }

// Where the window's drop targets are, in window coordinates (drag.rs reads it while files
// are dragged; every field is computed when read). The pane's are in its `PaneGeometry`.
export struct DropGeometry {
    window-width: length,
    window-height: length,
    sidebar-scroll: length,
    stack-y: length,
    stack-height: length,
}

export component AppWindow inherits Window {
    // Set from Rust: "<location> — Gezik".
    in-out property <string> title-text: "Gezik";
    title: root.title-text;
    preferred-width: 900px;
    preferred-height: 600px;
    background: Theme.chrome;

    // macOS: the menu bar at the top of the screen (set from Rust there only; elsewhere there
    // is none). An item names the action whose shortcut it stands for; Rust plays that
    // shortcut to the window, so it does what the keys would do where the focus is.
    in property <bool> native-menu-bar;
    // Off while Rust plays an item's shortcut: Slint would take it for the item again.
    in property <bool> menu-keys: true;
    // The View menu's marks on macOS (view_options.rs keeps them as the options are). Two-way:
    // Slint flips a checkable item's mark itself when it is chosen.
    in-out property <bool> view-hide-extensions;
    in-out property <bool> view-folders-first;
    in-out property <bool> view-single-click;
    in-out property <bool> view-show-hidden;
    in-out property <bool> view-date-relative;
    in-out property <bool> view-date-short;
    in-out property <bool> view-date-iso;
    in-out property <bool> view-date-system;
    in-out property <bool> view-size-binary;
    in-out property <bool> view-size-decimal;
    in-out property <bool> view-two-panes;
    // Sync browsing (spec 10 §4.7): the menu's mark, the link between the panes, the strips' line.
    in-out property <bool> view-sync;
    // The Commands menu: the `[[commands]]` with a key (id: the command's index, -1 a heading).
    in property <[MenuEntry]> bar-commands;
    // The Window menu's "Open Tab Set": the tab sets to open, to replace the tabs with, to delete.
    in property <[MenuEntry]> bar-tab-sets;
    callback menu-command(string);
    if root.native-menu-bar: MenuBar {
        Menu {
            title: "File";
            MenuItem { title: "New Window"; shortcut: root.menu-keys ? @keys(Control + N) : @keys(); activated => { root.menu-command("new-window"); } }
            MenuItem { title: "New Tab"; shortcut: root.menu-keys ? @keys(Control + T) : @keys(); activated => { root.menu-command("new-tab"); } }
            MenuItem { title: "New Folder"; shortcut: root.menu-keys ? @keys(Control + Shift + N) : @keys(); activated => { root.menu-command("new-folder"); } }
            MenuItem { title: "New Folder with Selection"; shortcut: root.menu-keys ? @keys(Control + Meta + N) : @keys(); activated => { root.menu-command("new-folder-with-selection"); } }
            MenuItem { title: "Open Terminal"; shortcut: root.menu-keys ? @keys(Control + Alt + T) : @keys(); activated => { root.menu-command("open-terminal"); } }
            MenuSeparator { }
            MenuItem { title: "Get Info"; shortcut: root.menu-keys ? @keys(Control + I) : @keys(); activated => { root.menu-command("get-info"); } }
            MenuItem { title: "Quick Look"; activated => { root.menu-command("quick-look"); } }
            MenuItem { title: "Rename"; activated => { root.menu-command("rename"); } }
            MenuItem { title: "Rename Items…"; activated => { root.menu-command("batch-rename"); } }
            MenuItem { title: "Duplicate"; shortcut: root.menu-keys ? @keys(Control + D) : @keys(); activated => { root.menu-command("duplicate"); } }
            MenuItem { title: "Copy to the Other Pane"; activated => { root.menu-command("copy-to-other-pane"); } }
            MenuItem { title: "Move to the Other Pane"; activated => { root.menu-command("move-to-other-pane"); } }
            MenuItem { title: "Make Alias"; shortcut: root.menu-keys ? @keys(Control + Meta + A) : @keys(); activated => { root.menu-command("make-alias"); } }
            MenuItem { title: "Show Package Contents"; activated => { root.menu-command("show-package-contents"); } }
            MenuItem { title: "Share…"; activated => { root.menu-command("share"); } }
            MenuItem { title: "Eject"; shortcut: root.menu-keys ? @keys(Control + E) : @keys(); activated => { root.menu-command("eject"); } }
            MenuSeparator { }
            MenuItem { title: "Put Back"; activated => { root.menu-command("put-back"); } }
            MenuItem { title: "Empty Trash…"; shortcut: root.menu-keys ? @keys(Control + Shift + Backspace) : @keys(); activated => { root.menu-command("empty-trash"); } }
            MenuItem { title: "Move to Trash"; shortcut: root.menu-keys ? @keys(Control + Backspace) : @keys(); activated => { root.menu-command("trash"); } }
            MenuItem { title: "Delete Immediately…"; shortcut: root.menu-keys ? @keys(Control + Alt + Backspace) : @keys(); activated => { root.menu-command("delete-permanently"); } }
            MenuSeparator { }
            MenuItem { title: "Close Tab"; shortcut: root.menu-keys ? @keys(Control + W) : @keys(); activated => { root.menu-command("close-tab"); } }
        }
        Menu {
            title: "Edit";
            MenuItem { title: "Undo"; shortcut: root.menu-keys ? @keys(Control + Z) : @keys(); activated => { root.menu-command("undo"); } }
            MenuItem { title: "Redo"; shortcut: root.menu-keys ? @keys(Control + Shift + Z) : @keys(); activated => { root.menu-command("redo"); } }
            MenuSeparator { }
            MenuItem { title: "Cut"; shortcut: root.menu-keys ? @keys(Control + X) : @keys(); activated => { root.menu-command("cut"); } }
            MenuItem { title: "Copy"; shortcut: root.menu-keys ? @keys(Control + C) : @keys(); activated => { root.menu-command("copy"); } }
            MenuItem { title: "Copy with Folders"; activated => { root.menu-command("copy-with-folders"); } }
            MenuItem { title: "Cut with Folders"; activated => { root.menu-command("cut-with-folders"); } }
            MenuItem { title: "Copy Path"; shortcut: root.menu-keys ? @keys(Control + Alt + C) : @keys(); activated => { root.menu-command("copy-path"); } }
            MenuItem { title: "Add to Drop Stack"; shortcut: root.menu-keys ? @keys(Control + Shift + S) : @keys(); activated => { root.menu-command("add-to-stack"); } }
            MenuItem { title: "Paste"; shortcut: root.menu-keys ? @keys(Control + V) : @keys(); activated => { root.menu-command("paste"); } }
            MenuItem { title: "Move Item Here"; shortcut: root.menu-keys ? @keys(Control + Alt + V) : @keys(); activated => { root.menu-command("paste-move"); } }
            MenuItem { title: "Select All"; shortcut: root.menu-keys ? @keys(Control + A) : @keys(); activated => { root.menu-command("select-all"); } }
            MenuSeparator { }
            MenuItem { title: "Find…"; shortcut: root.menu-keys ? @keys(Control + Shift + F) : @keys(); activated => { root.menu-command("search"); } }
            MenuItem { title: "Filter…"; shortcut: root.menu-keys ? @keys(Control + F) : @keys(); activated => { root.menu-command("filter"); } }
            MenuItem { title: "Invert Selection"; shortcut: root.menu-keys ? @keys(Control + Shift + I) : @keys(); activated => { root.menu-command("invert-selection"); } }
            MenuItem { title: "Select by Pattern…"; shortcut: root.menu-keys ? @keys(Control + "=") : @keys(); activated => { root.menu-command("select-pattern"); } }
            MenuItem { title: "Deselect by Pattern…"; shortcut: root.menu-keys ? @keys(Control + "-") : @keys(); activated => { root.menu-command("deselect-pattern"); } }
            MenuItem { title: "Select Same Type"; activated => { root.menu-command("select-same-type"); } }
            MenuItem { title: "Restore Selection"; activated => { root.menu-command("restore-selection"); } }
        }
        Menu {
            title: "View";
            MenuItem { title: "as List"; shortcut: root.menu-keys ? @keys(Control + Shift + "1") : @keys(); activated => { root.menu-command("view-list"); } }
            MenuItem { title: "as Grid"; shortcut: root.menu-keys ? @keys(Control + Shift + "2") : @keys(); activated => { root.menu-command("view-grid"); } }
            MenuItem { title: "as Columns"; shortcut: root.menu-keys ? @keys(Control + Meta + "3") : @keys(); activated => { root.menu-command("view-columns"); } }
            Menu {
                title: "Group By";
                MenuItem { title: "None"; activated => { root.menu-command("group-none"); } }
                MenuItem { title: "Type"; activated => { root.menu-command("group-type"); } }
                MenuItem { title: "Date"; activated => { root.menu-command("group-date"); } }
                MenuItem { title: "Size"; activated => { root.menu-command("group-size"); } }
            }
            MenuItem { title: "Collapse All Groups"; activated => { root.menu-command("collapse-groups"); } }
            MenuItem { title: "Expand All Groups"; activated => { root.menu-command("expand-groups"); } }
            MenuSeparator { }
            MenuItem { title: "Flat View"; shortcut: root.menu-keys ? @keys(Control + B) : @keys(); activated => { root.menu-command("flat-view"); } }
            MenuItem { title: "Show Preview"; activated => { root.menu-command("toggle-preview"); } }
            MenuItem { title: "Two Panes"; checkable: true; checked <=> root.view-two-panes; shortcut: root.menu-keys ? @keys(Control + Meta + P) : @keys(); activated => { root.menu-command("toggle-dual-pane"); } }
            MenuItem { title: "Sync Browsing"; checkable: true; checked <=> root.view-sync; activated => { root.menu-command("sync-browsing"); } }
            MenuItem { title: "Swap Panes"; shortcut: root.menu-keys ? @keys(Control + Meta + U) : @keys(); activated => { root.menu-command("swap-panes"); } }
            MenuItem { title: "Same Folder in the Other Pane"; activated => { root.menu-command("other-pane-same-folder"); } }
            MenuItem { title: "Drop Stack"; activated => { root.menu-command("toggle-stack"); } }
            MenuItem { title: "Operation History"; activated => { root.menu-command("show-history"); } }
            MenuItem { title: "Calculate Folder Sizes"; activated => { root.menu-command("calculate-folder-sizes"); } }
            MenuItem { title: "Show in Sidebar Tree"; activated => { root.menu-command("reveal-in-tree"); } }
            MenuItem { title: "Show Hidden Items"; checkable: true; checked <=> root.view-show-hidden; shortcut: root.menu-keys ? @keys(Control + Shift + ".") : @keys(); activated => { root.menu-command("toggle-hidden"); } }
            MenuItem { title: "Hide Extensions"; checkable: true; checked <=> root.view-hide-extensions; activated => { root.menu-command("view-option:1300"); } }
            MenuItem { title: "Folders First"; checkable: true; checked <=> root.view-folders-first; activated => { root.menu-command("view-option:1301"); } }
            MenuItem { title: "Single-Click to Open"; checkable: true; checked <=> root.view-single-click; activated => { root.menu-command("view-option:1302"); } }
            Menu {
                title: "Date Format";
                MenuItem { title: "Relative"; checkable: true; checked <=> root.view-date-relative; activated => { root.menu-command("view-option:1310"); } }
                MenuItem { title: "Short"; checkable: true; checked <=> root.view-date-short; activated => { root.menu-command("view-option:1311"); } }
                MenuItem { title: "ISO"; checkable: true; checked <=> root.view-date-iso; activated => { root.menu-command("view-option:1312"); } }
                MenuItem { title: "System"; checkable: true; checked <=> root.view-date-system; activated => { root.menu-command("view-option:1313"); } }
            }
            Menu {
                title: "Size Format";
                MenuItem { title: "Binary (1 KB = 1024 bytes)"; checkable: true; checked <=> root.view-size-binary; activated => { root.menu-command("view-option:1320"); } }
                MenuItem { title: "Decimal (1 kB = 1000 bytes)"; checkable: true; checked <=> root.view-size-decimal; activated => { root.menu-command("view-option:1321"); } }
            }
            MenuSeparator { }
            MenuItem { title: "Refresh"; shortcut: root.menu-keys ? @keys(Control + R) : @keys(); activated => { root.menu-command("refresh"); } }
            MenuItem { title: "System Integration…"; activated => { root.menu-command("system-integration"); } }
        }
        Menu {
            title: "Go";
            MenuItem { title: "Back"; shortcut: root.menu-keys ? @keys(Control + "[") : @keys(); activated => { root.menu-command("back"); } }
            MenuItem { title: "Forward"; shortcut: root.menu-keys ? @keys(Control + "]") : @keys(); activated => { root.menu-command("forward"); } }
            MenuItem { title: "Enclosing Folder"; shortcut: root.menu-keys ? @keys(Control + UpArrow) : @keys(); activated => { root.menu-command("up"); } }
            MenuItem { title: "Show in Folder"; shortcut: root.menu-keys ? @keys(Control + Shift + E) : @keys(); activated => { root.menu-command("show-in-folder"); } }
            MenuItem { title: "Show Trash"; activated => { root.menu-command("show-trash"); } }
            MenuItem { title: "Connect to Server…"; shortcut: root.menu-keys ? @keys(Control + K) : @keys(); activated => { root.menu-command("connect-to-server"); } }
            MenuSeparator { }
            MenuItem { title: "Go to Folder…"; shortcut: root.menu-keys ? @keys(Control + L) : @keys(); activated => { root.menu-command("focus-path"); } }
            MenuItem { title: "Quick Open…"; shortcut: root.menu-keys ? @keys(Control + P) : @keys(); activated => { root.menu-command("quick-open"); } }
            MenuItem { title: "Command Palette…"; shortcut: root.menu-keys ? @keys(Control + Shift + P) : @keys(); activated => { root.menu-command("command-palette"); } }
            MenuSeparator { }
            MenuItem { title: "Pinned 1"; shortcut: root.menu-keys ? @keys(Control + Alt + "1") : @keys(); activated => { root.menu-command("pin-1"); } }
            MenuItem { title: "Pinned 2"; shortcut: root.menu-keys ? @keys(Control + Alt + "2") : @keys(); activated => { root.menu-command("pin-2"); } }
            MenuItem { title: "Pinned 3"; shortcut: root.menu-keys ? @keys(Control + Alt + "3") : @keys(); activated => { root.menu-command("pin-3"); } }
            MenuItem { title: "Pinned 4"; shortcut: root.menu-keys ? @keys(Control + Alt + "4") : @keys(); activated => { root.menu-command("pin-4"); } }
            MenuItem { title: "Pinned 5"; shortcut: root.menu-keys ? @keys(Control + Alt + "5") : @keys(); activated => { root.menu-command("pin-5"); } }
            MenuItem { title: "Pinned 6"; shortcut: root.menu-keys ? @keys(Control + Alt + "6") : @keys(); activated => { root.menu-command("pin-6"); } }
            MenuItem { title: "Pinned 7"; shortcut: root.menu-keys ? @keys(Control + Alt + "7") : @keys(); activated => { root.menu-command("pin-7"); } }
            MenuItem { title: "Pinned 8"; shortcut: root.menu-keys ? @keys(Control + Alt + "8") : @keys(); activated => { root.menu-command("pin-8"); } }
            MenuItem { title: "Pinned 9"; shortcut: root.menu-keys ? @keys(Control + Alt + "9") : @keys(); activated => { root.menu-command("pin-9"); } }
            MenuSeparator { }
            MenuItem { title: "Clear Folder History"; activated => { root.menu-command("clear-history"); } }
        }
        if root.bar-commands.length > 0: Menu {
            title: "Commands";
            for entry in root.bar-commands: MenuItem {
                title: entry.title;
                enabled: entry.enabled;
                activated => { root.menu-command("command:" + entry.id); }
            }
        }
        Menu {
            title: "Window";
            MenuItem { title: "Minimize"; shortcut: root.menu-keys ? @keys(Control + M) : @keys(); activated => { root.menu-command("minimize"); } }
            MenuItem { title: "Zoom"; activated => { root.menu-command("zoom"); } }
            MenuSeparator { }
            MenuItem { title: "Show Next Tab"; activated => { root.menu-command("next-tab"); } }
            MenuItem { title: "Show Previous Tab"; activated => { root.menu-command("prev-tab"); } }
            MenuSeparator { }
            MenuItem { title: "Reopen Closed Tab"; shortcut: root.menu-keys ? @keys(Control + Shift + T) : @keys(); activated => { root.menu-command("reopen-tab"); } }
            MenuItem { title: "Show All Tabs…"; shortcut: root.menu-keys ? @keys(Control + Shift + A) : @keys(); activated => { root.menu-command("tab-picker"); } }
            MenuItem { title: root.active-tab-locked ? "Unlock Tab" : "Lock Tab"; activated => { root.menu-command("toggle-tab-lock"); } }
            MenuSeparator { }
            MenuItem { title: "Save Tabs As…"; activated => { root.menu-command("save-tab-set"); } }
            if root.bar-tab-sets.length > 0: Menu {
                title: "Open Tab Set";
                for entry in root.bar-tab-sets: MenuItem {
                    title: entry.title;
                    enabled: entry.enabled;
                    activated => { root.menu-command("tab-set:" + entry.id); }
                }
            }
            MenuSeparator { }
            MenuItem { title: "Tab 1"; shortcut: root.menu-keys ? @keys(Control + "1") : @keys(); activated => { root.menu-command("tab-1"); } }
            MenuItem { title: "Tab 2"; shortcut: root.menu-keys ? @keys(Control + "2") : @keys(); activated => { root.menu-command("tab-2"); } }
            MenuItem { title: "Tab 3"; shortcut: root.menu-keys ? @keys(Control + "3") : @keys(); activated => { root.menu-command("tab-3"); } }
            MenuItem { title: "Tab 4"; shortcut: root.menu-keys ? @keys(Control + "4") : @keys(); activated => { root.menu-command("tab-4"); } }
            MenuItem { title: "Tab 5"; shortcut: root.menu-keys ? @keys(Control + "5") : @keys(); activated => { root.menu-command("tab-5"); } }
            MenuItem { title: "Tab 6"; shortcut: root.menu-keys ? @keys(Control + "6") : @keys(); activated => { root.menu-command("tab-6"); } }
            MenuItem { title: "Tab 7"; shortcut: root.menu-keys ? @keys(Control + "7") : @keys(); activated => { root.menu-command("tab-7"); } }
            MenuItem { title: "Tab 8"; shortcut: root.menu-keys ? @keys(Control + "8") : @keys(); activated => { root.menu-command("tab-8"); } }
            MenuItem { title: "Last Tab"; shortcut: root.menu-keys ? @keys(Control + "9") : @keys(); activated => { root.menu-command("tab-last"); } }
        }
    }
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size;

    // The panes (spec 10 §3.2): one row each (panes.rs). Their callbacks below come with the
    // pane's index first.
    in property <[PaneData]> panes;
    // Two panes (spec 10 §4): open, the active one (its row in `panes`), and the left one's share
    // of their width (0.2–0.8), dragged with the splitter between them.
    in property <bool> dual;
    in property <int> active-pane;
    in property <percent> pane-split: 50%;
    // Where the right pane starts (the splitter is just left of it).
    property <length> split-x;
    // The panes' room (their row's width), copied when it changes: read in the panes' widths
    // directly, it would loop through the row's layout.
    property <length> panes-room;
    // The left pane's width: its share of the room, but each pane at least 240 px while the
    // room allows (spec 10 §4.1), so neither is pushed out of the window.
    property <length> left-width: max(0px, min(max((root.panes-room - 5px) * (root.pane-split / 100%), 240px), root.panes-room - 5px - 240px));
    // The splitter between the panes was dragged to this share of their room (Rust sets
    // `pane-split`), was let go, or was double-clicked (back to the middle).
    callback pane-split-moved(float);
    callback pane-split-done();
    callback pane-split-reset();
    // Two panes with the preview open came down to their narrowest: the preview closes first.
    callback panes-cramped();
    property <bool> cramped: root.dual && root.preview-open && panes-row.width <= panes-row.min-width + 1px;
    changed cramped => {
        if self.cramped { root.panes-cramped(); }
    }
    callback scrolled(int, length);
    callback revealed(int, int, length);
    callback pane-geometry(int, PaneGeometry);
    callback pane-focus(int, PaneFocus);
    callback grid-columns-changed(int, int);
    // Ctrl+wheel in the view: true for bigger.
    callback zoom(int, bool);
    // Renaming in place (view/mod.rs, operations.rs).
    callback rename-accepted(int, string);
    callback rename-cancelled(int);
    callback rename-tab(int, string, bool);
    callback rename-edited(int, string);
    callback rename-blurred(int, string, int);
    // The View button, with its box for its menu: (left, bottom, right, top), as for every
    // menu that opens under a button (the menu flips above it or to its right edge).
    callback view-menu(int, length, length, length, length);
    in property <string> status;
    // Settings/theme problems, shown on the right of the status bar.
    in property <string> notice;
    // The active tab is locked (the menu bar's Lock/Unlock Tab).
    in property <bool> active-tab-locked;
    // The address bar's suggestions while a path is typed (path_box.rs) and the chosen one
    // (-1: none, the text is what counts). Rust empties them when typing ends.
    in property <[PathRow]> path-rows;
    in property <int> path-current: -1;
    // Where the active pane's address bar is (it says; Rust when another pane becomes active),
    // for the suggestions under it.
    in-out property <PaneGeometry> address-box;
    // The address text as typed; a suggestion clicked (its path); typing began or ended.
    callback path-edited(int, string);
    callback path-chosen(string);
    callback path-editing-changed(int, bool);
    callback filter-edited(int, string);
    // The saved filters' button, with its box (as `view-menu`).
    callback filter-menu(int, length, length, length, length);
    callback search-edited(int, string);
    callback search-content-edited(int, string);
    callback search-content-toggle(int);
    callback search-go(int);
    // One of its menus (the bar's `menu`: 0 ▾, 1 the scope, 2 Filters), with its button's box.
    callback search-menu(int, int, length, length, length, length);
    // The filter bar's "Search subfolders".
    callback filter-search(int);
    in property <[SidebarRow]> sidebar-rows;
    // Position in `sidebar-rows` of the pinned part's first row (a heading; -1 if none), and the
    // row after its last pin.
    in property <int> sidebar-pinned-first-row: -1;
    in property <int> sidebar-pinned-end-row: -1;
    // The sidebar's tip (sidebar.slint), drawn over everything.
    in-out property <string> sidebar-tip;
    in-out property <length> sidebar-tip-x;
    in-out property <length> sidebar-tip-y;
    // 0 left, 1 right, 2 hidden (`layout.sidebar`).
    in property <int> sidebar-position;
    // A sidebar taken away or moved while it had the keyboard: the list takes it (no stale
    // `sidebar-focused`, no keyboard left nowhere).
    changed sidebar-position => {
        if root.sidebar-focused {
            root.sidebar-focused = false;
            root.focus-list();
        }
    }
    // The sidebar tree's keyboard (spec 10 §5.1): its row, whether the sidebar has the
    // keyboard, and a counter whose change gives it the keyboard.
    in property <int> sidebar-cursor: -1;
    in-out property <bool> sidebar-focused;
    in-out property <int> sidebar-focus-seq;
    // The menu open came from the sidebar's menu key: closing it gives the sidebar the
    // keyboard back, not the list. Opening any menu clears it.
    in-out property <bool> menu-from-sidebar;
    // Dragged with the splitter (120–480px); saved in state.toml on close.
    in-out property <length> sidebar-width: 200px;
    // What the Slint context menu shows; set from Rust before `show-menu`: the items, then
    // up to four submenus, each with the items after it.
    in property <[MenuEntry]> menu-entries;
    in property <[MenuSub]> menu-subs;
    // The same for Gezik's own menu, in one list: the submenus' items have ids -1…-4.
    in property <[MenuEntry]> menu-lines;
    // Whether Slint shows menus as the system's (Windows, macOS); else Gezik draws its own.
    in property <bool> native-menus;
    // Where Gezik's own menu goes (popup.rs): (x, y, flip-x, flip-y, width, height, area
    // width, area height).
    pure callback place-menu(length, length, length, length, length, length, length, length) -> MenuPlace;
    // The line Up/Down moves to in Gezik's own menu, past greyed ones (popup.rs).
    pure callback menu-step([MenuEntry], int, bool) -> int;

    // Follows the OS light/dark mode (Palette is left to the system on purpose; see
    // theme_bridge.rs). Rust re-resolves the theme when it flips.
    out property <bool> system-dark: Palette.color-scheme == ColorScheme.dark;
    changed system-dark => { root.system-scheme-changed(); }

    callback open-row(int, int);
    callback go-back(int);
    callback go-forward(int);
    callback go-up(int);
    callback navigate(int, string);
    callback refresh(int);
    callback crumb-clicked(int, int);
    callback system-scheme-changed();
    callback tab-activate(int, int);
    callback tab-close(int, int);
    callback tab-new(int);
    // Moves tab `from` to position `to`.
    callback tab-move(int, int, int);
    // Right-click on a tab, at a window position.
    callback tab-menu(int, int, length, length);
    // Pane `int`'s tab `int` dragged to a window position (released: dropped; tab -1: the drag
    // ended): whether the other pane is under it (Rust moves the tab there on the drop).
    callback tab-out(int, int, length, length, bool) -> bool;
    // Middle-click on a row: opens a folder in a background tab.
    callback row-middle-clicked(int, int);
    // Sidebar item (section, index): click, middle-click, right-click at a window position.
    callback sidebar-clicked(int, int);
    callback sidebar-middle-clicked(int, int);
    callback sidebar-menu(int, int, length, length);
    // A pinned row (a row of sidebar-rows) was dropped on the line above another row.
    callback pinned-drop(int, int);
    // The splitter was released.
    callback sidebar-resized();
    // The arrow of sidebar row `i` (a row of sidebar-rows): its branch opens or closes (spec 10 §5).
    callback sidebar-toggled(int);
    // The preview pane on the right (Alt+P); its width is dragged (200-600px) and saved
    // in state.toml on close.
    in property <bool> preview-open;
    in-out property <length> preview-width: 280px;
    in property <PreviewInfo> preview;
    // A fixed-width font for text previews.
    in property <string> mono-font;
    // The preview splitter was released.
    callback preview-resized();
    // Every pane's Miller column width (spec 10 §7.1), dragged at a column's edge (120-600px)
    // and saved in state.toml on close; a column's press, menu, middle-click and scroll
    // (PaneView's `column-*`); the columns a pane shows (pane, first, past the last).
    in-out property <length> column-width: 220px;
    callback column-pressed(int, int, int, length, length, length, bool);
    callback column-menu(int, bool, length, length);
    callback column-middle(int, int, int);
    callback column-scrolled(int, int, length);
    callback columns-shown(int, int, int);
    // A Slint context menu item was chosen (its `MenuEntry.id`).
    callback menu-activated(int);
    // Gezik's own menu closed (chosen, Esc or a press outside it).
    callback menu-closed();
    // Left press on an entry with Ctrl (Cmd on macOS) and Shift; left click on empty space with Ctrl.
    callback item-pressed(int, int, bool, bool);
    callback background-pressed(int, bool);
    // Column widths (0: hidden), set by Rust; dragging an edge changes them here. Every
    // pane shows them (spec 10 §3.3).
    in-out property <length> col-modified;
    in-out property <length> col-created;
    in-out property <length> col-type;
    in-out property <length> col-size;
    in-out property <length> col-folder;
    in-out property <length> col-match;
    callback header-clicked(int, int);
    // Right-click on the column header, at a window position.
    callback header-menu(int, length, length);
    // Grouped lists (spec 10 §6): where an entry's line is, and its group header's presses.
    pure callback list-line-of(int, int) -> int;
    pure callback list-column-of(int, int) -> int;
    callback list-group-toggled(int, int);
    callback list-group-menu(int, length, length);
    // A column edge was released: Rust reads the widths.
    callback columns-resized(int);
    // A rubber-band drag in the file view; see FileView.
    callback marquee(int, length, length, length, length, bool);
    callback marquee-done(int);
    // Right-click on an entry (Rust selects it first if it was not selected) / on empty space, at a window position.
    callback row-menu(int, int, length, length);
    callback background-menu(int, length, length);
    // Shift+F10 or the Menu key on the list: the menu of row `int` (-1: the background), at
    // a window position.
    callback keyboard-menu(int, int, length, length);
    // Every key press, before the focused item sees it. Returns whether it was handled
    // (shortcuts, list keys; see keys.rs and main.rs).
    // File operations (operations.rs): the panel above the status bar, folded into the
    // summary on the status bar's right when `ops-collapsed`.
    in property <[OpRow]> op-rows;
    in property <bool> ops-panel-open;
    in property <string> ops-summary;
    in property <bool> ops-collapsed;
    // The panel's tab (0 Current, 1 History), the History's rows, and whether the status
    // bar shows its History button (once a job ended this session).
    in property <int> ops-tab;
    in property <[OpRow]> history-rows;
    in property <bool> history-available;
    callback ops-tab-chosen(int);
    callback history-show(int);
    callback history-details(int);
    callback history-toggle();
    callback op-pause(int);
    callback op-resume(int);
    callback op-cancel(int);
    callback op-start-now(int);
    callback op-details(int);
    callback op-retry(int);
    callback op-dismiss(int);
    callback ops-toggle();
    // The drop stack (stack.rs): open, its first items, "12 items", "+900 more", and a drop
    // landing on it.
    in property <bool> stack-open;
    in property <[StackRow]> stack-rows;
    in property <string> stack-count;
    in property <string> stack-more;
    in property <bool> drop-stack;
    callback stack-down(int, length, length);
    callback stack-hovered(int);
    callback stack-remove(int);
    callback stack-copy();
    callback stack-move();
    callback stack-clear();
    // The conflict list over the window (conflicts.rs).
    in property <bool> conflicts-open;
    in property <string> conflict-title;
    in property <[ConflictRow]> conflict-rows;
    in property <int> conflict-identical-count;
    in property <bool> conflict-hide-identical;
    in property <bool> conflict-apply-all;
    in property <string> conflict-footer;
    in-out property <length> conflict-scroll;
    callback conflict-decide(int);
    callback conflict-set-apply-all(bool);
    callback conflict-toggle-identical();
    callback conflict-pressed(int, bool, bool);
    callback conflict-row-menu(int, length, length);
    callback conflict-start();
    callback conflict-cancel();
    callback conflict-key(KeyEvent) -> bool;

    // The batch layers below exist only while open (Slint builds an `if` element when its
    // condition turns true): Rust reaches into them through these counters, which each
    // layer watches, never by calling into the element.
    property <int> conflict-focus-seq;
    property <int> conflict-reveal-index;
    property <int> conflict-reveal-seq;

    public function conflict-ensure-visible(index: int) {
        root.conflict-reveal-index = index;
        root.conflict-reveal-seq += 1;
    }

    // The batch rename layer (batch_rename.rs).
    in property <bool> rb-open;
    in property <string> rb-title;
    in property <[RuleRow]> rb-rules;
    in property <int> rb-selected-rule: -1;
    in property <RuleOptions> rb-options;
    in-out property <string> rb-opt-find;
    in-out property <string> rb-opt-with;
    in-out property <string> rb-opt-start;
    in-out property <string> rb-opt-step;
    in-out property <string> rb-opt-digits;
    in-out property <string> rb-opt-separator;
    in-out property <string> rb-opt-prefix;
    in-out property <string> rb-opt-suffix;
    in-out property <string> rb-opt-text;
    in property <[RenamePreviewRow]> rb-rows;
    in property <bool> rb-include-extension;
    in property <bool> rb-only-changed;
    in property <string> rb-footer;
    in property <bool> rb-can-rename;
    in-out property <length> rb-scroll;
    in-out property <string> rb-name-text;
    in property <bool> rb-name-enabled;
    // Whether the layer's name field has the keyboard (told by the layer while it is open).
    out property <bool> rb-name-focused;
    property <int> rb-focus-seq;
    property <int> rb-focus-name-seq;
    property <int> rb-reveal-index;
    property <int> rb-reveal-seq;
    callback rb-add-rule(length, length, length, length);
    callback rb-select-rule(int);
    callback rb-toggle-rule(int);
    callback rb-move-rule(int);
    callback rb-remove-rule();
    callback rb-option-text(string, string);
    callback rb-option-flag(string, bool);
    callback rb-option-mode(int);
    callback rb-toggle-extension();
    callback rb-toggle-only-changed();
    callback rb-row-pressed(int, bool, bool);
    callback rb-rename();
    callback rb-cancel();
    callback rb-presets(length, length, length, length);
    callback rb-name-edited(string);
    callback rb-name-reset();
    callback rb-reorder(int, int);
    pure callback rb-drop-row(length, length, int) -> int;
    callback rb-sort(int);
    callback rb-key(KeyEvent) -> bool;

    public function rb-ensure-visible(index: int) {
        root.rb-reveal-index = index;
        root.rb-reveal-seq += 1;
    }
    public function rb-focus-name() {
        root.rb-focus-name-seq += 1;
    }
    changed rb-open => {
        if !self.rb-open {
            root.rb-name-focused = false;
        }
    }

    // The Compress layer (archives.rs).
    in property <bool> cp-open;
    property <int> cp-focus-seq;
    in property <string> cp-title;
    in-out property <string> cp-name;
    // Selected when the layer opens: the name up to its ending (bytes).
    in property <int> cp-name-select;
    in-out property <string> cp-folder;
    in property <[string]> cp-formats;
    in property <int> cp-format;
    in property <int> cp-level;
    in-out property <string> cp-password;
    in property <bool> cp-can-encrypt;
    in property <bool> cp-is-7z;
    in property <bool> cp-encrypt-names;
    in property <int> cp-split;
    in-out property <string> cp-split-mb;
    in property <string> cp-size-text;
    in property <string> cp-error;
    in property <string> cp-note;
    callback cp-set-format(int);
    callback cp-set-level(int);
    callback cp-toggle-encrypt-names();
    callback cp-set-split(int);
    callback cp-add-existing();
    callback cp-compress();
    callback cp-cancel();
    callback cp-edited();

    // The Convert layer (convert.rs).
    in property <bool> cv-open;
    property <int> cv-focus-seq;
    in property <ConvertView> cv-view;
    in-out property <string> cv-quality;
    in-out property <string> cv-resize-value;
    in-out property <string> cv-background;
    in-out property <string> cv-pdf-every;
    in-out property <string> cv-pdf-ranges;
    callback cv-presets(length, length, length, length);
    callback cv-set-format(int);
    callback cv-set-resize(int);
    callback cv-toggle(string);
    callback cv-from(length, length, length, length);
    callback cv-to(length, length, length, length);
    callback cv-set-eol(int);
    callback cv-set-output(int);
    callback cv-edited();
    callback cv-convert();
    callback cv-cancel();
    callback cv-pdf-set(string, int);
    callback cv-pdf-reorder(int, int);
    pure callback cv-pdf-drop-row(length, length, int) -> int;
    // The Info window (info.rs, spec 9 §4.4).
    in property <bool> info-open;
    property <int> info-focus-seq;
    in property <InfoView> info-view;
    in-out property <string> info-owner;
    in-out property <string> info-group;
    in-out property <string> info-octal;
    callback info-toggle-bit(int);
    callback info-toggle-flag(int);
    callback info-owner-accepted();
    callback info-group-accepted();
    callback info-octal-accepted();
    callback info-group-menu(length, length, length, length);
    callback info-enclosed();
    callback info-app-menu(length, length, length, length);
    callback info-change-all();
    callback info-as-admin();
    callback info-close();

    // The tab picker (tab_tools.rs): the tabs the query lets through, the row Enter picks.
    in property <bool> tp-open;
    property <int> tp-focus-seq;
    in-out property <string> tp-query;
    in property <[PickRow]> tp-rows;
    in property <string> tp-label: "Tabs";
    in property <string> tp-empty: "No tabs match";
    in property <int> tp-current;
    callback tp-edited(string);
    callback tp-chosen(int);

    // A question over the window (dialog.rs); `dialog-chosen` gets the button's index.
    in property <bool> dialog-open;
    in property <string> dialog-title;
    in property <string> dialog-message;
    in property <[string]> dialog-buttons;
    in property <int> dialog-escape;
    // A question that asks for a text too (dialog.rs `ask_text`): the field and its text.
    in property <bool> dialog-has-input;
    in-out property <string> dialog-input;
    // The text is a password: dots, with "Show".
    in property <bool> dialog-input-secret;
    in-out property <bool> dialog-show-secret;
    // The line under the field (dialog.rs `ask_text_noted`), red if an error; `dialog-edited`
    // gets the field's text as it is typed.
    in property <string> dialog-note;
    in property <bool> dialog-note-error;
    callback dialog-chosen(int);
    callback dialog-edited(string);
    callback key-event(KeyEvent) -> bool;

    // Dragging files (drag.rs). Presses, moves and releases on entries; see FileView.
    callback item-down(int, int, length, length, bool, bool);
    callback item-drag(length, length, bool, bool, bool);
    callback item-up(int, length, length, bool) -> bool;
    callback item-cancel();
    // An address bar part moved (index, window x, width).
    callback crumb-span(int, int, length, length);
    // A key went down or up while files are dragged (Shift, Ctrl, Alt held now).
    callback drag-keys(bool, bool, bool);
    // What is dragged, drawn at the pointer (`drag-x`, `drag-y`): the first item's icon, how
    // many there are, and what dropping here would do ("Move to Documents"; empty: nothing).
    in property <bool> drag-active;
    in property <length> drag-x;
    in property <length> drag-y;
    in property <image> drag-icon;
    in property <bool> drag-has-icon;
    in property <int> drag-kind;
    in property <int> drag-count;
    in property <string> drag-label;
    in property <bool> drag-forbidden;
    // What dropping files from another program here would do, next to the system's drag
    // image (macOS, whose image has no such text; empty: nothing to say).
    in property <string> offer-label;
    // The drop target, highlighted (-1: none): an entry (in Miller column `drop-column`, -1: in
    // the file view), a sidebar row (and the row a pin line is drawn above), a tab, an address
    // bar part.
    in property <int> drop-entry: -1;
    in property <int> drop-column: -1;
    in property <int> drop-sidebar-row: -1;
    in property <int> drop-pin-row: -1;
    in property <int> drop-tab: -1;
    in property <int> drop-crumb: -1;
    // The pane those are in; and where a tab dragged from the other pane would go in its strip.
    in property <int> drop-pane: -1;
    in property <int> tab-insert: -1;
    in-out property <length> sidebar-scroll;
    out property <DropGeometry> drop-geometry: {
        window-width: root.width,
        window-height: root.height,
        sidebar-scroll: root.sidebar-scroll,
        stack-y: root.stack-open ? root.height - Theme.row-height - (Theme.row-height + 6px) : 0px,
        stack-height: root.stack-open ? Theme.row-height + 6px : 0px,
    };

    // Whether the file list has keyboard focus (and not the address bar or a button).
    out property <bool> list-focused: keys.has-focus;

    init => { keys.focus(); }

    // A menu closed: the keyboard goes back to the sidebar if its menu key opened it, else to
    // the list.
    public function menu-gives-keyboard-back() {
        if root.menu-from-sidebar {
            root.sidebar-focus-seq += 1;
        } else {
            root.focus-list();
        }
    }

    // Gives the keyboard to the file list.
    public function focus-list() {
        if root.conflicts-open {
            root.conflict-focus-seq += 1;
        } else if root.rb-open {
            root.rb-focus-seq += 1;
        } else if root.cp-open {
            root.cp-focus-seq += 1;
        } else if root.cv-open {
            root.cv-focus-seq += 1;
        } else if root.info-open {
            root.info-focus-seq += 1;
        } else if root.tp-open {
            root.tp-focus-seq += 1;
        } else {
            keys.focus();
        }
    }

    // Shows `menu-entries` at a window position: at `x`, `y` (its top left) when there is
    // room, else flipped to end at `flip-x` or `flip-y`. A system menu places itself.
    public function show-menu(x: length, y: length, flip-x: length, flip-y: length) {
        if root.native-menus {
            menu-area.show({ x: x, y: y });
        } else {
            popup-menu.show(x, y, flip-x, flip-y);
        }
    }

    // Covers the whole window, but only opens when Rust calls `show-menu`: right-clicks
    // themselves are handled by rows, tabs and the sidebar (`enabled` only blocks input).
    menu-area := ContextMenuArea {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        enabled: false;
        Menu {
            for entry in root.menu-entries: MenuItem {
                title: entry.title;
                enabled: entry.enabled;
                activated => { root.menu-activated(entry.id); }
            }
            if root.menu-subs[0].entries.length > 0: Menu {
                title: root.menu-subs[0].title;
                for entry in root.menu-subs[0].entries: MenuItem {
                    title: entry.title;
                    enabled: entry.enabled;
                    activated => { root.menu-activated(entry.id); }
                }
            }
            for entry in root.menu-subs[0].after: MenuItem {
                title: entry.title;
                enabled: entry.enabled;
                activated => { root.menu-activated(entry.id); }
            }
            if root.menu-subs[1].entries.length > 0: Menu {
                title: root.menu-subs[1].title;
                for entry in root.menu-subs[1].entries: MenuItem {
                    title: entry.title;
                    enabled: entry.enabled;
                    activated => { root.menu-activated(entry.id); }
                }
            }
            for entry in root.menu-subs[1].after: MenuItem {
                title: entry.title;
                enabled: entry.enabled;
                activated => { root.menu-activated(entry.id); }
            }
            if root.menu-subs[2].entries.length > 0: Menu {
                title: root.menu-subs[2].title;
                for entry in root.menu-subs[2].entries: MenuItem {
                    title: entry.title;
                    enabled: entry.enabled;
                    activated => { root.menu-activated(entry.id); }
                }
            }
            for entry in root.menu-subs[2].after: MenuItem {
                title: entry.title;
                enabled: entry.enabled;
                activated => { root.menu-activated(entry.id); }
            }
            if root.menu-subs[3].entries.length > 0: Menu {
                title: root.menu-subs[3].title;
                for entry in root.menu-subs[3].entries: MenuItem {
                    title: entry.title;
                    enabled: entry.enabled;
                    activated => { root.menu-activated(entry.id); }
                }
            }
            for entry in root.menu-subs[3].after: MenuItem {
                title: entry.title;
                enabled: entry.enabled;
                activated => { root.menu-activated(entry.id); }
            }
        }
    }

    // Sees every key press first (capture), so shortcuts work wherever the focus is.
    // Takes the focus only when asked (`focus-list`), never by itself on a click.
    keys := FocusScope {
        focus-on-click: false;
        capture-key-pressed(event) => {
            if root.drag-active {
                root.drag-keys(event.modifiers.shift, event.modifiers.control, event.modifiers.alt);
            }
            if root.key-event(event) { return accept; }
            return reject;
        }
        capture-key-released(event) => {
            if root.drag-active {
                root.drag-keys(event.modifiers.shift, event.modifiers.control, event.modifiers.alt);
            }
            return reject;
        }

        VerticalLayout {
            // One pane: it holds the sidebar and the preview in the row under its toolbar. Two:
            // the sidebar runs the window's height beside them, the preview after them (spec 10 §4.1).
            HorizontalLayout {
                // Left or right of the panes (`layout-order`), as in one pane.
                if root.dual && root.sidebar-position != 2: Sidebar {
                    layout-order: root.sidebar-position == 0 ? -2 : 2;
                    width: root.sidebar-width;
                    rows: root.sidebar-rows;
                    pinned-first-row: root.sidebar-pinned-first-row;
                    pinned-end-row: root.sidebar-pinned-end-row;
                    cursor: root.sidebar-cursor;
                    focused <=> root.sidebar-focused;
                    focus-seq: root.sidebar-focus-seq;
                    tip-text <=> root.sidebar-tip;
                    tip-x <=> root.sidebar-tip-x;
                    tip-y <=> root.sidebar-tip-y;
                    scroll <=> root.sidebar-scroll;
                    drop-row: root.drop-sidebar-row;
                    pin-line: root.drop-pin-row;
                    clicked(s, i) => { root.sidebar-clicked(s, i); }
                    middle-clicked(s, i) => { root.sidebar-middle-clicked(s, i); }
                    toggled(i) => { root.sidebar-toggled(i); }
                    menu(s, i, x, y) => { root.sidebar-menu(s, i, x, y); }
                    pinned-drop(a, b) => { root.pinned-drop(a, b); }
                }
                if root.dual && root.sidebar-position != 2: Rectangle {
                    layout-order: root.sidebar-position == 0 ? -1 : 1;
                    width: 5px;
                    accessible-role: none;
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        width: 1px;
                        background: dual-splitter.has-hover || dual-splitter.pressed ? Theme.accent : transparent;
                    }
                    dual-splitter := TouchArea {
                        mouse-cursor: col-resize;
                        moved => {
                            let delta = self.mouse-x - self.pressed-x;
                            root.sidebar-width = clamp(root.sidebar-width + (root.sidebar-position == 0 ? delta : -delta), 120px, 480px);
                        }
                        changed pressed => { if !self.pressed { root.sidebar-resized(); } }
                    }
                }
                Rectangle {
                    init => { root.panes-room = self.width; }
                    changed width => { root.panes-room = self.width; }
                    panes-row := HorizontalLayout {
                        spacing: 5px;
                        for pane-data[i] in root.panes: pane := PaneView {
                            data: pane-data;
                            index: i;
                            dual: root.dual;
                            active: i == root.active-pane;
                            synced: root.view-sync;
                            // The left one's share of the room (the layout fills it); one pane has all of it.
                            preferred-width: !root.dual ? root.panes-room : i == 0 ? root.left-width : root.panes-room - 5px - root.left-width;
                            init => {
                                if i == 1 { root.split-x = self.x; }
                            }
                            changed x => {
                                if i == 1 { root.split-x = self.x; }
                            }
                            list-focused: keys.has-focus && i == root.active-pane;
                            drag-active: root.drag-active;
                            drag-forbidden: root.drag-forbidden;
                            drop-entry: i == root.drop-pane ? root.drop-entry : -1;
                            drop-column: i == root.drop-pane ? root.drop-column : -1;
                            drop-tab: i == root.drop-pane ? root.drop-tab : -1;
                            drop-crumb: i == root.drop-pane ? root.drop-crumb : -1;
                            tab-insert: i == root.drop-pane ? root.tab-insert : -1;
                            col-modified <=> root.col-modified;
                            col-created <=> root.col-created;
                            col-type <=> root.col-type;
                            col-size <=> root.col-size;
                            col-folder <=> root.col-folder;
                            col-match <=> root.col-match;
                            sheet-x: sheet-place.x;
                            sheet-y: sheet-place.y;
                            sheet-width: sheet-place.width;
                            sheet-height: sheet-place.height;
                            focus-requested => { keys.focus(); }
                            keyboard-menu(p, row, x, y) => { root.keyboard-menu(p, row, x, y); }
                            scrolled(p, y) => { root.scrolled(p, y); }
                            revealed(p, entry, y) => { root.revealed(p, entry, y); }
                            geometry-changed(p, g) => {
                                if p == root.active-pane { root.address-box = g; }
                                root.pane-geometry(p, g);
                            }
                            focus-changed(p, f) => { root.pane-focus(p, f); }
                            path-editing-changed(p, on) => { root.path-editing-changed(p, on); }
                            go-back(p) => { root.go-back(p); }
                            go-forward(p) => { root.go-forward(p); }
                            go-up(p) => { root.go-up(p); }
                            refresh(p) => { root.refresh(p); }
                            navigate(p, path) => { root.navigate(p, path); }
                            crumb-clicked(p, c) => { root.crumb-clicked(p, c); }
                            crumb-span(p, c, x, w) => { root.crumb-span(p, c, x, w); }
                            path-edited(p, text) => { root.path-edited(p, text); }
                            tab-activate(p, t) => { root.tab-activate(p, t); }
                            tab-close(p, t) => { root.tab-close(p, t); }
                            tab-new(p) => { root.tab-new(p); }
                            tab-move(p, from, to) => { root.tab-move(p, from, to); }
                            tab-menu(p, t, x, y) => { root.tab-menu(p, t, x, y); }
                            tab-out(p, t, x, y, r) => { return root.tab-out(p, t, x, y, r); }
                            view-menu(p, x, y, r, t) => { root.view-menu(p, x, y, r, t); }
                            filter-edited(p, t) => { root.filter-edited(p, t); }
                            filter-menu(p, x, y, r, t) => { root.filter-menu(p, x, y, r, t); }
                            filter-search(p) => { root.filter-search(p); }
                            search-edited(p, t) => { root.search-edited(p, t); }
                            search-content-edited(p, t) => { root.search-content-edited(p, t); }
                            search-content-toggle(p) => { root.search-content-toggle(p); }
                            search-go(p) => { root.search-go(p); }
                            search-menu(p, which, x, y, r, t) => { root.search-menu(p, which, x, y, r, t); }
                            grid-columns-changed(p, n) => { root.grid-columns-changed(p, n); }
                            zoom(p, bigger) => { root.zoom(p, bigger); }
                            list-line-of(p, e) => { return root.list-line-of(p, e); }
                            list-column-of(p, e) => { return root.list-column-of(p, e); }
                            list-group-toggled(p, first) => { root.list-group-toggled(p, first); }
                            list-group-menu(p, x, y) => { root.list-group-menu(p, x, y); }
                            header-clicked(p, c) => { root.header-clicked(p, c); }
                            header-menu(p, x, y) => { root.header-menu(p, x, y); }
                            columns-resized(p) => { root.columns-resized(p); }
                            rename-accepted(p, t) => { root.rename-accepted(p, t); }
                            rename-cancelled(p) => { root.rename-cancelled(p); }
                            rename-tab(p, t, back) => { root.rename-tab(p, t, back); }
                            rename-edited(p, t) => { root.rename-edited(p, t); }
                            rename-blurred(p, t, g) => { root.rename-blurred(p, t, g); }
                            item-pressed(p, e, ctrl, shift) => { root.item-pressed(p, e, ctrl, shift); }
                            item-down(p, e, x, y, right, can-drag) => { root.item-down(p, e, x, y, right, can-drag); }
                            item-drag(x, y, shift, ctrl, alt) => { root.item-drag(x, y, shift, ctrl, alt); }
                            item-up(e, x, y, right) => { return root.item-up(e, x, y, right); }
                            item-cancel => { root.item-cancel(); }
                            open-row(p, e) => { root.open-row(p, e); }
                            row-middle-clicked(p, e) => { root.row-middle-clicked(p, e); }
                            row-menu(p, e, x, y) => { root.row-menu(p, e, x, y); }
                            background-pressed(p, ctrl) => { root.background-pressed(p, ctrl); }
                            background-menu(p, x, y) => { root.background-menu(p, x, y); }
                            marquee(p, x, y, w, h, additive) => { root.marquee(p, x, y, w, h, additive); }
                            marquee-done(p) => { root.marquee-done(p); }
                            preview-open: root.preview-open;
                            preview: root.preview;
                            mono-font: root.mono-font;
                            column-width <=> root.column-width;
                            column-pressed(p, c, r, s, x, y, right) => { root.column-pressed(p, c, r, s, x, y, right); }
                            column-menu(p, row, x, y) => { root.column-menu(p, row, x, y); }
                            column-middle(p, c, r) => { root.column-middle(p, c, r); }
                            column-scrolled(p, c, y) => { root.column-scrolled(p, c, y); }
                            columns-shown(p, first, end) => { root.columns-shown(p, first, end); }

                            // The row under the toolbar; the pane lays its bars and sheet over `sheet-place`.
                            HorizontalLayout {
                                // The sheets' gap from the chrome: below them, and on the side away from the
                                // sidebar (on its side the splitter is the gap). None in the classic themes.
                                // With two panes the splitters are the gaps between them and what is beside them.
                                padding-left: root.dual ? (i == 0 && root.sidebar-position != 0 ? Theme.inset : 0px) : root.sidebar-position == 0 ? 0px : Theme.inset;
                                padding-right: root.dual ? (i == 1 && !root.preview-open && root.sidebar-position != 1 ? Theme.inset : 0px) : root.sidebar-position == 1 ? 0px : Theme.inset;
                                padding-bottom: Theme.inset;
                                if !root.dual && root.sidebar-position == 0: Sidebar {
                                    width: root.sidebar-width;
                                    rows: root.sidebar-rows;
                                    pinned-first-row: root.sidebar-pinned-first-row;
                                    pinned-end-row: root.sidebar-pinned-end-row;
                                    cursor: root.sidebar-cursor;
                                    focused <=> root.sidebar-focused;
                                    focus-seq: root.sidebar-focus-seq;
                                    tip-text <=> root.sidebar-tip;
                                    tip-x <=> root.sidebar-tip-x;
                                    tip-y <=> root.sidebar-tip-y;
                                    scroll <=> root.sidebar-scroll;
                                    drop-row: root.drop-sidebar-row;
                                    pin-line: root.drop-pin-row;
                                    clicked(s, i) => { root.sidebar-clicked(s, i); }
                                    middle-clicked(s, i) => { root.sidebar-middle-clicked(s, i); }
                                    toggled(i) => { root.sidebar-toggled(i); }
                                    menu(s, i, x, y) => {
                                        pane.end-path-editing();
                                        root.sidebar-menu(s, i, x, y);
                                    }
                                    pinned-drop(a, b) => { root.pinned-drop(a, b); }
                                }
                                // Grabbable over 5px; the line shows only while hovered or dragged.
                                if !root.dual && root.sidebar-position == 0: Rectangle {
                                    width: 5px;
                                    accessible-role: none;
                                    Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        width: 1px;
                                        background: splitter-left.has-hover || splitter-left.pressed ? Theme.accent : transparent;
                                    }
                                    splitter-left := TouchArea {
                                        mouse-cursor: col-resize;
                                        moved => { root.sidebar-width = clamp(root.sidebar-width + (self.mouse-x - self.pressed-x), 120px, 480px); }
                                        changed pressed => { if !self.pressed { root.sidebar-resized(); } }
                                    }
                                }
                                sheet-place := Rectangle {
                                    horizontal-stretch: 1;
                                    // With two panes the pane's own minimum rules (its bars fit or are cut off).
                                    min-width: root.dual ? 0px : pane.sheet-min-width;
                                    min-height: pane.sheet-min-height;
                                }
                                // Grabbable over 5px; the line shows only while hovered or dragged.
                                if !root.dual && root.preview-open: Rectangle {
                                    width: 5px;
                                    accessible-role: none;
                                    Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        width: 1px;
                                        background: preview-splitter.has-hover || preview-splitter.pressed ? Theme.accent : transparent;
                                    }
                                    preview-splitter := TouchArea {
                                        mouse-cursor: col-resize;
                                        moved => { root.preview-width = clamp(root.preview-width - (self.mouse-x - self.pressed-x), 200px, 600px); }
                                        changed pressed => { if !self.pressed { root.preview-resized(); } }
                                    }
                                }
                                if !root.dual && root.preview-open: PreviewPane {
                                    width: root.preview-width;
                                    info: root.preview;
                                    mono-font: root.mono-font;
                                    // Its own sheet, like the list's.
                                    background: Theme.background;
                                    border-radius: Theme.sheet-radius;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                }
                                // Grabbable over 5px; the line shows only while hovered or dragged.
                                if !root.dual && root.sidebar-position == 1: Rectangle {
                                    width: 5px;
                                    accessible-role: none;
                                    Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        width: 1px;
                                        background: splitter-right.has-hover || splitter-right.pressed ? Theme.accent : transparent;
                                    }
                                    splitter-right := TouchArea {
                                        mouse-cursor: col-resize;
                                        moved => { root.sidebar-width = clamp(root.sidebar-width - (self.mouse-x - self.pressed-x), 120px, 480px); }
                                        changed pressed => { if !self.pressed { root.sidebar-resized(); } }
                                    }
                                }
                                if !root.dual && root.sidebar-position == 1: Sidebar {
                                    width: root.sidebar-width;
                                    rows: root.sidebar-rows;
                                    pinned-first-row: root.sidebar-pinned-first-row;
                                    pinned-end-row: root.sidebar-pinned-end-row;
                                    cursor: root.sidebar-cursor;
                                    focused <=> root.sidebar-focused;
                                    focus-seq: root.sidebar-focus-seq;
                                    tip-text <=> root.sidebar-tip;
                                    tip-x <=> root.sidebar-tip-x;
                                    tip-y <=> root.sidebar-tip-y;
                                    scroll <=> root.sidebar-scroll;
                                    drop-row: root.drop-sidebar-row;
                                    pin-line: root.drop-pin-row;
                                    clicked(s, i) => { root.sidebar-clicked(s, i); }
                                    middle-clicked(s, i) => { root.sidebar-middle-clicked(s, i); }
                                    toggled(i) => { root.sidebar-toggled(i); }
                                    menu(s, i, x, y) => {
                                        pane.end-path-editing();
                                        root.sidebar-menu(s, i, x, y);
                                    }
                                    pinned-drop(a, b) => { root.pinned-drop(a, b); }
                                }
                            }
                        }
