                    padding-bottom: Theme.inset;
                    PreviewPane {
                        width: root.preview-width;
                        info: root.preview;
                        mono-font: root.mono-font;
                        background: Theme.background;
                        border-radius: Theme.sheet-radius;
                        border-width: 1px;
                        border-color: Theme.border;
                    }
                }
            }

            if root.ops-panel-open: OpsPanel {
                rows: root.op-rows;
                tab: root.ops-tab;
                history: root.history-rows;
                history-available: root.history-available;
                tab-chosen(i) => { root.ops-tab-chosen(i); }
                history-show(i) => { root.history-show(i); }
                history-details(i) => { root.history-details(i); }
                pause(i) => { root.op-pause(i); }
                resume(i) => { root.op-resume(i); }
                cancel(i) => { root.op-cancel(i); }
                start-now(i) => { root.op-start-now(i); }
                details(i) => { root.op-details(i); }
                retry(i) => { root.op-retry(i); }
                dismiss(i) => { root.op-dismiss(i); }
            }
            if root.stack-open: DropStack {
                rows: root.stack-rows;
                count: root.stack-count;
                more: root.stack-more;
                highlight: root.drop-stack;
                down(i, x, y) => { root.stack-down(i, x, y); }
                drag(x, y, shift, ctrl, alt) => { root.item-drag(x, y, shift, ctrl, alt); }
                up(x, y) => { root.item-up(-1, x, y, false); }
                cancel => { root.item-cancel(); }
                hovered(i) => { root.stack-hovered(i); }
                remove(i) => { root.stack-remove(i); }
                copy-here => { root.stack-copy(); }
                move-here => { root.stack-move(); }
                clear => { root.stack-clear(); }
            }
            Rectangle {
                height: Theme.row-height;
                background: Theme.chrome;
                HorizontalLayout {
                    padding-left: Theme.inset + 4px;
                    padding-right: Theme.inset + 4px;
                    spacing: Theme.spacing * 2;
                    Text {
                        text: root.status;
                        font-size: Theme.font-size-small;
                        vertical-alignment: center;
                        color: Theme.foreground-muted;
                    }
                    if root.ops-summary != "": Rectangle {
                        width: summary-text.preferred-width + 26px;
                        border-radius: Theme.radius;
                        background: summary-touch.has-hover ? Theme.hover : transparent;
                        animate background { duration: Theme.motion-hover; }
                        accessible-role: button;
                        accessible-label: root.ops-summary;
                        accessible-action-default => { root.ops-toggle(); }
                        summary-text := Text {
                            x: 4px;
                            height: parent.height;
                            text: root.ops-summary;
                            font-size: Theme.font-size-small;
                            vertical-alignment: center;
                            color: Theme.foreground-muted;
                        }
                        Path {
                            x: parent.width - 14px;
                            y: (parent.height - 8px) / 2;
                            width: 8px;
                            height: 8px;
                            viewbox-width: 8;
                            viewbox-height: 8;
                            stroke: Theme.foreground-muted;
                            stroke-width: 1.2px;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                            commands: root.ops-collapsed ? Glyph.chevron-up : Glyph.chevron-down;
                        }
                        summary-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.ops-toggle(); }
                        }
                    }
                    if root.history-available: Rectangle {
                        width: history-text.preferred-width + 26px;
                        border-radius: Theme.radius;
                        background: history-touch.has-hover ? Theme.hover : transparent;
                        animate background { duration: Theme.motion-hover; }
                        accessible-role: button;
                        accessible-label: "History";
                        accessible-action-default => { root.history-toggle(); }
                        Path {
                            x: 4px;
                            y: (parent.height - 12px) / 2;
                            width: 12px;
                            height: 12px;
                            viewbox-width: 16;
                            viewbox-height: 16;
                            commands: Glyph.history;
                            stroke: Theme.foreground-muted;
                            stroke-width: 1.5px;
                            stroke-line-cap: round;
                        }
                        history-text := Text {
                            x: 22px;
                            height: parent.height;
                            text: "History";
                            font-size: Theme.font-size-small;
                            vertical-alignment: center;
                            color: Theme.foreground-muted;
                        }
                        history-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.history-toggle(); }
                        }
                    }
                    Text {
                        text: root.notice;
                        font-size: Theme.font-size-small;
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                        color: Theme.danger;
