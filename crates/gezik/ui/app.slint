            opt-text <=> root.rb-opt-text;
            rows: root.rb-rows;
            include-extension: root.rb-include-extension;
            only-changed: root.rb-only-changed;
            footer: root.rb-footer;
            can-rename: root.rb-can-rename;
            scroll <=> root.rb-scroll;
