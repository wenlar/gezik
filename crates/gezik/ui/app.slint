            pdf-reorder(from, to) => { root.cv-pdf-reorder(from, to); }
            pdf-drop-row(y, h, count) => { return root.cv-pdf-drop-row(y, h, count); }
        }
        if root.tp-open: Picker {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            open: root.tp-open;
            focus-request: root.tp-focus-seq;
            dialog-open: root.dialog-open || root.conflicts-open;
            query <=> root.tp-query;
            rows: root.tp-rows;
            label: root.tp-label;
