import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ToolButton } from "widgets/button.slint";
import { Breadcrumb, CrumbItem } from "widgets/breadcrumb.slint";
import { TabBar, TabItem } from "widgets/tab-bar.slint";
import { Sidebar, SidebarRow } from "widgets/sidebar.slint";
import { PreviewPane, PreviewInfo } from "widgets/preview-pane.slint";
import { FileView, FileRow, ItemRow } from "widgets/file-view.slint";
import { OpsPanel, OpRow } from "widgets/ops-panel.slint";
import { Dialog } from "widgets/dialog.slint";

// Re-exported so Rust can set it with `window.global::<Theme>()` and build crumbs, tabs
// and sidebar rows.
export { Theme, PreviewInfo, CrumbItem, TabItem, SidebarRow, FileRow, ItemRow, OpRow }

// One item of the Slint context menu (tabs everywhere; also rows and the sidebar on
// macOS/Linux). `id` is one of the ids in context_menu.rs.
export struct MenuEntry {
    id: int,
    title: string,
}

export component AppWindow inherits Window {
    // Set from Rust: "<location> — Gezik".
    in-out property <string> title-text: "Gezik";
    title: root.title-text;
    preferred-width: 900px;
    preferred-height: 600px;
    background: Theme.background;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size;

    in property <[ItemRow]> items;
    // The entry with the keyboard focus (-1: none), and whether it is selected.
    in property <int> focus-row: -1;
    in property <bool> focus-selected;
    out property <length> item-height: file-view.item-height;
    // 0: list, 1: grid; the grid's picture size.
    in property <int> view-mode;
    in property <length> grid-size: 96px;
    out property <length> cell-width: file-view.cell-width;
    out property <length> cell-height: file-view.cell-height;
    out property <int> grid-columns: file-view.grid-columns;
    callback grid-columns-changed(int);
    // Ctrl+wheel in the view: true for bigger.
    callback zoom(bool);
    // Renaming in place (view/mod.rs, operations.rs).
    in property <int> renaming-index: -1;
    in-out property <string> rename-text;
    in property <int> rename-select;
    in property <string> rename-error;
    callback rename-accepted(string);
    callback rename-cancelled();
    callback rename-tab(string, bool);
    callback rename-edited(string);
    callback rename-blurred(string);
    in property <int> rename-generation;
    out property <bool> rename-focused: file-view.rename-focused;
    // The View button, with the window position for its menu.
    callback view-menu(length, length);
    in-out property <string> current-path;
    in property <string> status;
    // Settings/theme problems, shown on the right of the status bar.
    in property <string> notice;
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    in property <bool> can-go-up;
    in property <[CrumbItem]> crumbs;
    in property <[TabItem]> tabs;
    // The file list's scroll offset (content-y), saved and restored per history entry.
    in-out property <length> list-scroll;
    in-out property <bool> path-editing;
    in property <[SidebarRow]> sidebar-rows;
    // Position in `sidebar-rows` of the first pinned item (-1 if none), and how many there are.
    in property <int> sidebar-pinned-first-row: -1;
    in property <int> sidebar-pinned-count;
    // 0 left, 1 right, 2 hidden (`layout.sidebar`).
    in property <int> sidebar-position;
    // Dragged with the splitter (120–480px); saved in state.toml on close.
    in-out property <length> sidebar-width: 200px;
    // What the Slint context menu shows; set from Rust before `show-menu`.
    in property <[MenuEntry]> menu-entries;

    // Follows the OS light/dark mode (Palette is left to the system on purpose; see
    // theme_bridge.rs). Rust re-resolves the theme when it flips.
    out property <bool> system-dark: Palette.color-scheme == ColorScheme.dark;
    changed system-dark => { root.system-scheme-changed(); }

    callback open-row(int);
    callback go-back();
    callback go-forward();
    callback go-up();
    callback navigate(string);
    callback refresh();
    callback crumb-clicked(int);
    callback system-scheme-changed();
    callback tab-activate(int);
    callback tab-close(int);
    callback tab-new();
    // Moves tab `from` to position `to`.
    callback tab-move(int, int);
    // Right-click on a tab, at a window position.
    callback tab-menu(int, length, length);
    // Middle-click on a row: opens a folder in a background tab.
    callback row-middle-clicked(int);
    // Sidebar item (section, index): click, middle-click, right-click at a window position.
    callback sidebar-clicked(int, int);
    callback sidebar-middle-clicked(int, int);
    callback sidebar-menu(int, int, length, length);
    // Moves pinned item `from` to position `to`.
    callback pinned-move(int, int);
    // The splitter was released.
    callback sidebar-resized();
    // The preview pane on the right (Alt+P); its width is dragged (200-600px) and saved
    // in state.toml on close.
    in property <bool> preview-open;
    in-out property <length> preview-width: 280px;
    in property <PreviewInfo> preview;
    // A fixed-width font for text previews.
    in property <string> mono-font;
    // The preview splitter was released.
    callback preview-resized();
    // A Slint context menu item was chosen (its `MenuEntry.id`).
    callback menu-activated(int);
    // Left press on an entry with Ctrl (Cmd on macOS) and Shift; left click on empty space with Ctrl.
    callback item-pressed(int, bool, bool);
    callback background-pressed(bool);
    // Column widths (0: hidden), set by Rust; dragging an edge changes them here.
    in-out property <length> col-modified;
    in-out property <length> col-created;
    in-out property <length> col-type;
    in-out property <length> col-size;
    // The sort column (0 Name, 1-4 Modified, Created, Type, Size) and direction.
    in property <int> sort-column;
    in property <bool> sort-desc;
    callback header-clicked(int);
    // Right-click on the column header, at a window position.
    callback header-menu(length, length);
    // A column edge was released: Rust reads the widths.
    callback columns-resized();
    // A rubber-band drag in the file view; see FileView.
    callback marquee(length, length, length, length, bool);
    callback marquee-done();
    // Right-click on an entry (Rust selects it first if it was not selected) / on empty space, at a window position.
    callback row-menu(int, length, length);
    callback background-menu(length, length);
    // Shift+F10 or the Menu key on the list: the menu of row `int` (-1: the background), at
    // a window position.
    callback keyboard-menu(int, length, length);
    // Every key press, before the focused item sees it. Returns whether it was handled
    // (shortcuts, list keys; see keys.rs and main.rs).
    // File operations (operations.rs): the panel above the status bar, folded into the
    // summary on the status bar's right when `ops-collapsed`.
    in property <[OpRow]> op-rows;
    in property <bool> ops-panel-open;
    in property <string> ops-summary;
    in property <bool> ops-collapsed;
    callback op-pause(int);
    callback op-resume(int);
    callback op-cancel(int);
    callback op-start-now(int);
    callback op-details(int);
    callback op-retry(int);
    callback op-dismiss(int);
    callback ops-toggle();
    // A question over the window (dialog.rs); `dialog-chosen` gets the button's index.
    in property <bool> dialog-open;
    in property <string> dialog-title;
    in property <string> dialog-message;
    in property <[string]> dialog-buttons;
    in property <int> dialog-escape;
    callback dialog-chosen(int);
    callback key-event(KeyEvent) -> bool;

    // Whether the file list has keyboard focus (and not the address bar or a button).
    out property <bool> list-focused: keys.has-focus;
    // How many rows PgUp/PgDn move: one screen, less one row.
    out property <int> list-page-rows: file-view.page-rows;

    init => { keys.focus(); }
    // However typing ends (Enter, Esc, a click elsewhere, switching windows, a menu opening),
    // the keyboard goes back to the list. The hidden text box cannot keep the focus: Slint
    // drops the focus of an item that becomes invisible, and then no key reaches
    // `key-event` at all. Done even while the window is inactive, so the list gets the focus
    // back when the window is activated again.
    changed path-editing => {
        if !self.path-editing && !keys.has-focus { keys.focus(); }
    }

    // Gives the keyboard to the file list.
    public function focus-list() {
        keys.focus();
    }

    // Called before any context menu opens: like Explorer, a menu ends typing in the address
    // bar (cancelling it), so the list has the keyboard once the menu closes. The focus moves
    // here, before the menu takes it, rather than later in `changed path-editing`.
    function end-path-editing() {
        if root.path-editing {
            root.path-editing = false;
            keys.focus();
        }
    }

    // Scrolls the view so entry `index` is visible.
    public function ensure-visible(index: int) {
        file-view.ensure-visible(index);
    }

    // Opens the context menu from the keyboard: the selection's (just below the focused
    // entry, scrolled into view) if the focused entry is selected, else the background's.
    public function open-keyboard-menu() {
        if root.focus-row >= 0 && root.focus-selected {
            file-view.ensure-visible(root.focus-row);
            root.keyboard-menu(root.focus-row, file-view.menu-x(root.focus-row), file-view.menu-y(root.focus-row));
        } else {
            root.keyboard-menu(-1, file-view.menu-x(-1), file-view.menu-y(-1));
        }
    }

    // Switches the address bar to typing, with the whole path selected.
    public function edit-path() {
        address.edit();
    }

    // Shows `menu-entries` at a window position.
    public function show-menu(x: length, y: length) {
        menu-area.show({ x: x, y: y });
    }

    // Covers the whole window, but only opens when Rust calls `show-menu`: right-clicks
    // themselves are handled by rows, tabs and the sidebar (`enabled` only blocks input).
    menu-area := ContextMenuArea {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        enabled: false;
        Menu {
            for entry in root.menu-entries: MenuItem {
                title: entry.title;
                activated => { root.menu-activated(entry.id); }
            }
        }
    }

    // Sees every key press first (capture), so shortcuts work wherever the focus is.
    // Takes the focus only when asked (`focus-list`), never by itself on a click.
    keys := FocusScope {
        focus-on-click: false;
        capture-key-pressed(event) => {
            if root.key-event(event) { return accept; }
            return reject;
        }

        VerticalLayout {
            TabBar {
                tabs: root.tabs;
                activate(i) => { root.tab-activate(i); }
                close(i) => { root.tab-close(i); }
                new-tab => { root.tab-new(); }
                move-tab(from, to) => { root.tab-move(from, to); }
                tab-menu(i, x, y) => {
                    root.end-path-editing();
                    root.tab-menu(i, x, y);
                }
            }
            Rectangle {
                background: Theme.surface;
                HorizontalLayout {
                    padding: Theme.spacing;
                    spacing: Theme.spacing;
                    ToolButton {
                        text: "←";
                        enabled: root.can-go-back;
                        clicked => { root.go-back(); }
                    }
                    ToolButton {
                        text: "→";
                        enabled: root.can-go-forward;
                        clicked => { root.go-forward(); }
                    }
                    ToolButton {
                        text: "↑";
                        enabled: root.can-go-up;
                        clicked => { root.go-up(); }
                    }
                    ToolButton {
                        text: "Refresh";
                        // A circular arrow.
                        icon: "M 13.5 8 A 5.5 5.5 0 1 1 11.9 4.1 M 12.2 1.2 L 12.2 4.4 L 9 4.4";
                        clicked => { root.refresh(); }
                    }
                    address := Breadcrumb {
                        crumbs: root.crumbs;
                        path-text: root.current-path;
                        editing <=> root.path-editing;
                        crumb-clicked(i) => { root.crumb-clicked(i); }
                        accepted(path) => {
                            keys.focus();
                            root.navigate(path);
                        }
                    }
                    ToolButton {
                        text: "View";
                        // Four squares.
                        icon: "M 2 2 L 7 2 L 7 7 L 2 7 Z M 9 2 L 14 2 L 14 7 L 9 7 Z M 2 9 L 7 9 L 7 14 L 2 14 Z M 9 9 L 14 9 L 14 14 L 9 14 Z";
                        clicked => {
                            root.end-path-editing();
                            root.view-menu(self.absolute-position.x, self.absolute-position.y + self.height);
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }

            HorizontalLayout {
                if root.sidebar-position == 0: Sidebar {
                    width: root.sidebar-width;
                    rows: root.sidebar-rows;
                    pinned-first-row: root.sidebar-pinned-first-row;
                    pinned-count: root.sidebar-pinned-count;
                    clicked(s, i) => { root.sidebar-clicked(s, i); }
                    middle-clicked(s, i) => { root.sidebar-middle-clicked(s, i); }
                    menu(s, i, x, y) => {
                        root.end-path-editing();
                        root.sidebar-menu(s, i, x, y);
                    }
                    pinned-move(a, b) => { root.pinned-move(a, b); }
                }
                // A 1px line, grabbable over 5px.
                if root.sidebar-position == 0: Rectangle {
                    width: 5px;
                    accessible-role: none;
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        width: 1px;
                        background: splitter-left.has-hover || splitter-left.pressed ? Theme.accent : Theme.border;
                    }
                    splitter-left := TouchArea {
                        mouse-cursor: col-resize;
                        moved => { root.sidebar-width = clamp(root.sidebar-width + (self.mouse-x - self.pressed-x), 120px, 480px); }
                        changed pressed => { if !self.pressed { root.sidebar-resized(); } }
                    }
                }
                file-view := FileView {
                    horizontal-stretch: 1;
                    items: root.items;
                    mode: root.view-mode;
                    picture-size: root.grid-size;
                    grid-columns-changed(n) => { root.grid-columns-changed(n); }
                    zoom(bigger) => { root.zoom(bigger); }
                    has-focus: keys.has-focus;
                    scroll <=> root.list-scroll;
                    focus-requested => { keys.focus(); }
                    col-modified <=> root.col-modified;
                    col-created <=> root.col-created;
                    col-type <=> root.col-type;
                    renaming-index: root.renaming-index;
                    rename-text <=> root.rename-text;
                    rename-select: root.rename-select;
                    rename-error: root.rename-error;
                    rename-accepted(t) => { root.rename-accepted(t); }
                    rename-cancelled => { root.rename-cancelled(); }
                    rename-tab(t, back) => { root.rename-tab(t, back); }
                    rename-edited(t) => { root.rename-edited(t); }
                    rename-blurred(t) => { root.rename-blurred(t); }
                    rename-generation: root.rename-generation;
                    col-size <=> root.col-size;
                    sort-column: root.sort-column;
                    sort-desc: root.sort-desc;
                    header-clicked(i) => { root.header-clicked(i); }
                    header-menu(x, y) => {
                        root.end-path-editing();
                        root.header-menu(x, y);
                    }
                    columns-resized => { root.columns-resized(); }
                    item-pressed(i, ctrl, shift) => { root.item-pressed(i, ctrl, shift); }
                    item-double-clicked(i) => { root.open-row(i); }
                    item-middle-clicked(i) => { root.row-middle-clicked(i); }
                    item-menu(i, x, y) => {
                        root.end-path-editing();
                        root.row-menu(i, x, y);
                    }
                    background-pressed(ctrl) => { root.background-pressed(ctrl); }
                    marquee(x, y, w, h, additive) => { root.marquee(x, y, w, h, additive); }
                    marquee-done => { root.marquee-done(); }
                    background-menu(x, y) => {
                        root.end-path-editing();
                        root.background-menu(x, y);
                    }
                }
                // A 1px line, grabbable over 5px.
                if root.preview-open: Rectangle {
                    width: 5px;
                    accessible-role: none;
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        width: 1px;
                        background: preview-splitter.has-hover || preview-splitter.pressed ? Theme.accent : Theme.border;
                    }
                    preview-splitter := TouchArea {
                        mouse-cursor: col-resize;
                        moved => { root.preview-width = clamp(root.preview-width - (self.mouse-x - self.pressed-x), 200px, 600px); }
                        changed pressed => { if !self.pressed { root.preview-resized(); } }
                    }
                }
                if root.preview-open: PreviewPane {
                    width: root.preview-width;
                    info: root.preview;
                    mono-font: root.mono-font;
                }
                // A 1px line, grabbable over 5px.
                if root.sidebar-position == 1: Rectangle {
                    width: 5px;
                    accessible-role: none;
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        width: 1px;
                        background: splitter-right.has-hover || splitter-right.pressed ? Theme.accent : Theme.border;
                    }
                    splitter-right := TouchArea {
                        mouse-cursor: col-resize;
                        moved => { root.sidebar-width = clamp(root.sidebar-width - (self.mouse-x - self.pressed-x), 120px, 480px); }
                        changed pressed => { if !self.pressed { root.sidebar-resized(); } }
                    }
                }
                if root.sidebar-position == 1: Sidebar {
                    width: root.sidebar-width;
                    rows: root.sidebar-rows;
                    pinned-first-row: root.sidebar-pinned-first-row;
                    pinned-count: root.sidebar-pinned-count;
                    clicked(s, i) => { root.sidebar-clicked(s, i); }
                    middle-clicked(s, i) => { root.sidebar-middle-clicked(s, i); }
                    menu(s, i, x, y) => {
                        root.end-path-editing();
                        root.sidebar-menu(s, i, x, y);
                    }
                    pinned-move(a, b) => { root.pinned-move(a, b); }
                }
            }

            if root.ops-panel-open: Rectangle { height: 1px; background: Theme.border; }
            if root.ops-panel-open: OpsPanel {
                rows: root.op-rows;
                pause(i) => { root.op-pause(i); }
                resume(i) => { root.op-resume(i); }
                cancel(i) => { root.op-cancel(i); }
                start-now(i) => { root.op-start-now(i); }
                details(i) => { root.op-details(i); }
                retry(i) => { root.op-retry(i); }
                dismiss(i) => { root.op-dismiss(i); }
            }
            Rectangle { height: 1px; background: Theme.border; }
            Rectangle {
                height: Theme.row-height;
                background: Theme.surface;
                HorizontalLayout {
                    padding-left: Theme.spacing + 4px;
                    padding-right: Theme.spacing + 4px;
                    spacing: Theme.spacing * 2;
                    Text {
                        text: root.status;
                        vertical-alignment: center;
                        color: Theme.foreground-muted;
                    }
                    if root.ops-summary != "": Rectangle {
                        width: summary-text.preferred-width + 26px;
                        border-radius: Theme.radius;
                        background: summary-touch.has-hover ? Theme.hover : transparent;
                        accessible-role: button;
                        accessible-label: root.ops-summary;
                        accessible-action-default => { root.ops-toggle(); }
                        summary-text := Text {
                            x: 4px;
                            height: parent.height;
                            text: root.ops-summary;
                            vertical-alignment: center;
                            color: Theme.foreground-muted;
                        }
                        Path {
                            x: parent.width - 14px;
                            y: (parent.height - 8px) / 2;
                            width: 8px;
                            height: 8px;
                            viewbox-width: 8;
                            viewbox-height: 8;
                            stroke: Theme.foreground-muted;
                            stroke-width: 1.5px;
                            commands: root.ops-collapsed ? "M 1 5.5 L 4 2.5 L 7 5.5" : "M 1 2.5 L 4 5.5 L 7 2.5";
                        }
                        summary-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.ops-toggle(); }
                        }
                    }
                    Text {
                        text: root.notice;
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                        color: Theme.danger;
                    }
                }
            }
        }
        if root.dialog-open: Dialog {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            title: root.dialog-title;
            message: root.dialog-message;
            buttons: root.dialog-buttons;
            escape: root.dialog-escape;
            chosen(i) => { root.dialog-chosen(i); }
        }
    }
}

// Space on the file list: the selection, big. Space or Esc closes it; the arrow keys move
// in the list underneath.
export component QuickLookWindow inherits Window {
    in property <PreviewInfo> info;
    in property <string> mono-font;
    title: root.info.title == "" ? "Gezik" : root.info.title + " — Gezik";
    background: Theme.background;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size;
    // Every key press; returns whether it was used.
    callback key(KeyEvent) -> bool;

    init => { scope.focus(); }

    scope := FocusScope {
        key-pressed(event) => {
            if root.key(event) {
                return accept;
            }
            return reject;
        }
        PreviewPane {
            info: root.info;
            mono-font: root.mono-font;
        }
    }
}
