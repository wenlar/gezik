            set-format(i) => { root.cv-set-format(i); }
            set-resize(i) => { root.cv-set-resize(i); }
            toggle(key) => { root.cv-toggle(key); }
            from(x, y, r, t) => { root.cv-from(x, y, r, t); }
            to(x, y, r, t) => { root.cv-to(x, y, r, t); }
