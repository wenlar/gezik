import { Theme } from "../theme.slint";
import { Glyph } from "../glyphs.slint";

// An entry's icon: the system's picture when Rust has one (`has-picture`), else Gezik's own
// shape for `kind` (`Kind` in gezik-core kind.rs), colored by the theme.
export component FileIcon inherits Rectangle {
    in property <int> kind;
    in property <image> picture;
    in property <bool> has-picture;
    // The cloud badge (spec 9 §7.3): 1 a cloud, 2 an outlined tick, 3 a filled tick; 0 none.
    in property <int> cloud;
    // The Git mark (spec 16 §8.3), `GitMark` in gezik-core git.rs: 2 untracked `?` (grey), 3
    // added `+` (green), 4 renamed `→` (blue), 5 staged and 6 modified dots, 7 both (half and
    // half), 8 conflict `!` (red); 0 none, 1 ignored (the row is faint instead).
    in property <int> git;
    property <bool> git-symbol: root.git == 2 || root.git == 3 || root.git == 4 || root.git == 8;
    accessible-role: none;

    pure function kind-color(kind: int) -> color {
        return kind == 0 ? Theme.icon-folder
            : kind == 2 ? Theme.icon-image
            : kind == 3 ? Theme.icon-video
            : kind == 4 ? Theme.icon-audio
            : kind == 5 || kind == 14 ? Theme.icon-archive
            : (kind >= 6 && kind <= 9) || kind == 11 ? Theme.icon-document
            : kind == 10 || kind == 12 ? Theme.icon-code
            : Theme.icon-other;
    }

    if root.has-picture: Image {
        width: root.width;
        height: root.height;
        source: root.picture;
        image-fit: contain;
    }

    // A folder, or a page with a folded corner (the design's shapes, one path each).
    if !root.has-picture: Path {
        width: root.width;
        height: root.height;
        viewbox-width: 16;
        viewbox-height: 16;
        fill: root.kind-color(root.kind);
        commands: root.kind == 0 ? Glyph.folder : Glyph.page;
    }

    // Bottom left, one element only where a mark is: rows elsewhere cost nothing.
    // A symbol needs room to read: 11 px at the list's 16 px icons; a dot stays small.
    if root.git > 1: Rectangle {
        width: min(root.git-symbol ? 16px : 12px, root.git-symbol ? max(11px, root.width * 0.7) : max(8px, root.width * 0.5));
        height: self.width;
        x: -self.width * 0.25;
        y: root.height - self.height * 0.8;
        border-radius: self.width / 2;
        background: root.git == 2 ? Theme.git-untracked
            : root.git == 4 ? Theme.git-renamed
            : root.git == 6 ? Theme.git-modified
            : root.git == 8 ? Theme.git-conflict
            : Theme.git-staged;
        // A ring in the list's own color sets it off the icon under it.
        border-width: 1px;
        border-color: Theme.background;
        if root.git == 7: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 8;
            viewbox-height: 8;
            commands: "M 4 0 A 4 4 0 0 1 4 8 Z";
            fill: Theme.git-modified;
        }
        if root.git-symbol: Text {
            width: parent.width;
            height: parent.height;
            text: root.git == 2 ? "?" : root.git == 3 ? "+" : root.git == 4 ? "→" : "!";
            color: #ffffff;
            font-size: parent.height * 0.82;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // One element only where a badge is drawn: rows elsewhere cost nothing.
    if root.cloud != 0: Rectangle {
        // Capped: on a grid's large thumbnails a share of the icon would cover the picture.
        width: min(16px, max(9px, root.width * 0.45));
        height: self.width;
        x: root.width - self.width * 0.8;
        y: root.height - self.height * 0.8;
        border-radius: self.width / 2;
        background: root.cloud == 3 ? Theme.success : Theme.background;
        Path {
            width: parent.width * 0.78;
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            viewbox-width: root.cloud == 1 ? 16 : 8;
            viewbox-height: root.cloud == 1 ? 16 : 8;
            commands: root.cloud == 1 ? Glyph.cloud : Glyph.check;
            fill: transparent;
            stroke: root.cloud == 1 ? Theme.foreground-muted : root.cloud == 3 ? Theme.background : Theme.success;
            stroke-width: 1.2px;
        }
    }
}
