import { Theme } from "../theme.slint";
import { TextField } from "text-field.slint";
import { ScrollView } from "scrollbar.slint";

// One setting (settings_window.rs builds them from the schema and settings.toml).
export struct SettingItem {
    // 0 on/off, 1 a choice (a theme too), 2 typed (a number, text, a path), 3 a list (edited in
    // settings.toml), 4 System Integration's.
    kind: int,
    title: string,
    // `layout.density`: under the title, and Copy Key's text.
    key: string,
    description: string,
    value: string,
    // Not in settings.toml: the default shows.
    is-default: bool,
    // The default as shown ("" for a list).
    default: string,
    options: [string],
}

// A plain button. No `if` inside (TextButton has two): every `if` and every inlined copy of one
// is code of its own, and this window had cost the exe more than its budget.
component PlainButton inherits Rectangle {
    in property <string> text;
    // The choice button's arrow.
    in property <bool> arrow;
    in property <bool> enabled: true;
    callback clicked();
    height: Theme.row-height + 4px;
    min-width: caption.preferred-width + 4 * Theme.spacing;
    border-radius: Theme.radius;
    border-width: scope.has-focus ? Theme.focus-width : 1px;
    border-color: scope.has-focus ? Theme.focus-ring : Theme.control-border;
    background: touch.has-hover ? Theme.hover : transparent;
    forward-focus: scope;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    opacity: root.enabled ? 1 : 0.5;
    caption := Text {
        x: 2 * Theme.spacing;
        width: parent.width - 4 * Theme.spacing - (root.arrow ? 12px : 0px);
        height: parent.height;
        text: root.text;
        color: Theme.foreground;
        vertical-alignment: center;
        overflow: elide;
    }
    Path {
        visible: root.arrow;
        x: parent.width - 2 * Theme.spacing - 8px;
        y: (parent.height - 8px) / 2;
        width: 8px;
        height: 8px;
        viewbox-width: 8;
        viewbox-height: 8;
        stroke: Theme.foreground-muted;
        stroke-width: 1.2px;
        commands: "M 1 3 L 4 6 L 7 3";
    }
    scope := FocusScope {
        key-pressed(event) => {
            if root.enabled && (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A row: the title, the key and the description on the left, the control on the right; its
// right-click menu. Typed values are written on Enter or when the field loses the keyboard. What
// the row has to say (a refused value, a change made in the file) goes to the status line.
component SettingLine inherits Rectangle {
    in property <SettingItem> item;
    in property <bool> read-only;
    // The text the control speaks: the title, the value, and "default" when it is one, else the
    // default.
    property <string> spoken: root.item.title + ", " + root.item.value
        + (root.item.is-default ? ", default" : root.item.default == "" ? "" : ", default " + root.item.default);
    property <string> value: root.item.value;
    property <bool> on: root.value == "true";
    // The choices or the right-click menu, under the row (no popup window: less code).
    property <[string]> lines;
    property <bool> menu-shown;
    property <bool> lines-open;
    // The line the arrow keys are on (-1: none yet).
    property <int> cursor: -1;
    // Writes `text` (Rust says in the status line why it did not).
    callback commit(string);
    // The pointer is over a choice ("" when it left them): a theme previews.
    callback hovered(string);
    // The list's or System Integration's button.
    callback button();
    // The right-click menu's item (2810 Reset to Default, 2811 Copy Key, 2812 Edit in settings.toml).
    callback action(int);
    // For the status line.
    callback say(string);

    changed value => {
        if root.item.kind == 2 && field.has-focus {
            if field.text != root.value {
                root.say(root.item.title + " changed in settings.toml: " + root.value);
            }
        } else {
            field.text = root.value;
        }
    }

    function write(text: string) {
        root.commit(text);
        root.close-lines();
    }

    function close-lines() {
        if root.lines-open && !root.menu-shown {
            root.hovered("");
        }
        root.lines-open = false;
    }

    // Line `i` of the open list: a choice is written, a menu item done.
    function choose(i: int) {
        if root.menu-shown {
            root.close-lines();
            root.action(2810 + i);
        } else {
            root.write(root.lines[i]);
        }
        root.refocus();
    }

    // The keyboard back to the row's control once its list closes.
    function refocus() {
        if root.item.kind == 0 {
            box-scope.focus();
        } else if root.item.kind == 2 {
            field.focus();
        } else {
            button.focus();
        }
    }

    function open-lines(menu: bool) {
        root.lines = menu ? ["Reset to Default", "Copy Key", "Edit in settings.toml"] : root.item.options;
        root.menu-shown = menu;
        root.cursor = -1;
        root.lines-open = true;
    }

    background: touch.has-hover ? Theme.hover : transparent;
    border-radius: Theme.radius;

    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.open-lines(true);
            }
        }
    }

    VerticalLayout {
        padding: Theme.spacing + 2px;
        spacing: 2px;
        HorizontalLayout {
            spacing: 2 * Theme.spacing;
            Text {
                text: root.item.title;
                color: Theme.foreground;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle {
                width: 240px;
                height: Theme.row-height + 4px;
                // On/off: a box of its own, filled when on (Check has two `if`s and a check mark).
                Rectangle {
                    visible: root.item.kind == 0;
                    x: parent.width - 18px;
                    y: (parent.height - 18px) / 2;
                    width: 18px;
                    height: 18px;
                    border-radius: 3px;
                    border-width: box-scope.has-focus ? Theme.focus-width : 1px;
                    border-color: box-scope.has-focus ? Theme.focus-ring : root.on ? Theme.accent : Theme.control-border;
                    background: root.on ? Theme.accent : transparent;
                    accessible-role: checkbox;
                    accessible-checkable: true;
                    accessible-checked: root.on;
                    accessible-label: root.spoken;
                    accessible-enabled: !root.read-only;
                    accessible-action-default => { box-touch.clicked(); }
                    box-scope := FocusScope {
                        enabled: root.item.kind == 0;
                        key-pressed(event) => {
                            if event.text == " " && !root.read-only {
                                box-touch.clicked();
                                return accept;
                            }
                            return reject;
                        }
                    }
                    box-touch := TouchArea {
                        enabled: !root.read-only;
                        mouse-cursor: pointer;
                        clicked => { root.write(root.on ? "false" : "true"); }
                    }
                }
                // A list's count.
                Text {
                    visible: root.item.kind >= 3;
                    width: parent.width - button.width - Theme.spacing;
                    height: parent.height;
                    text: root.value;
                    color: Theme.foreground-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }
                // A choice's button (its value and an arrow), or the list's and System Integration's.
                button := PlainButton {
                    visible: root.item.kind == 1 || root.item.kind >= 3;
                    width: root.item.kind == 1 ? parent.width : self.min-width;
                    x: parent.width - self.width;
                    text: root.item.kind == 1 ? root.value : root.item.kind == 3 ? "Edit in settings.toml" : "System Integration…";
                    arrow: root.item.kind == 1;
                    enabled: root.item.kind != 1 || !root.read-only;
                    accessible-label: root.item.kind == 1 ? root.spoken : self.text;
                    clicked => {
                        if root.item.kind != 1 {
                            root.button();
                        } else if root.lines-open {
                            root.close-lines();
                        } else {
                            root.open-lines(false);
                        }
                    }
                }
                field := TextField {
                    visible: root.item.kind == 2;
                    width: parent.width;
                    enabled: !root.read-only;
                    text: root.value;
                    accessible-label: root.spoken;
                    accepted(text) => { root.write(text); }
                    changed has-focus => {
                        if !self.has-focus && self.visible && self.text != root.value {
                            root.write(self.text);
                        }
                    }
                }
            }
        }
        // The key, "default", the template's comment: one text (each element is code).
        Text {
            text: root.item.key + (root.item.is-default ? "  ·  default" : "") + (root.item.description == "" ? "" : "  —  " + root.item.description);
            color: Theme.foreground-muted;
            font-size: Theme.font-size-small;
            wrap: word-wrap;
        }
        // The choices, or the right-click menu: Up and Down move, Enter takes the line, Esc, a
        // choice or a second click closes it.
        if root.lines-open: Rectangle {
            background: Theme.surface-raised;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius;
            accessible-role: list;
            FocusScope {
                init => { self.focus(); }
                key-pressed(event) => {
                    if event.text == Key.DownArrow || event.text == Key.UpArrow {
                        root.cursor = event.text == Key.DownArrow ? min(root.cursor + 1, root.lines.length - 1) : max(root.cursor - 1, 0);
                        if !root.menu-shown {
                            root.hovered(root.lines[root.cursor]);
                        }
                        return accept;
                    }
                    if event.text == Key.Return && root.cursor >= 0 {
                        root.choose(root.cursor);
                        return accept;
                    }
                    if event.text == Key.Escape {
                        root.close-lines();
                        root.refocus();
                        return accept;
                    }
                    return reject;
                }
            }
            VerticalLayout {
                padding: 4px;
                for line[i] in root.lines: Rectangle {
                    height: Theme.row-height;
                    border-radius: Theme.radius-small;
                    background: line-touch.has-hover || i == root.cursor ? Theme.selection : transparent;
                    accessible-role: list-item;
                    accessible-label: line;
                    accessible-item-selected: i == root.cursor;
                    accessible-action-default => { root.choose(i); }
                    Text {
                        x: Theme.spacing;
                        text: (!root.menu-shown && line == root.value ? "• " : "    ") + line;
                        color: line-touch.has-hover || i == root.cursor ? Theme.selection-foreground : Theme.foreground;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    line-touch := TouchArea {
                        clicked => { root.choose(i); }
                        changed has-hover => {
                            if !root.menu-shown {
                                root.hovered(self.has-hover ? line : "");
                            }
                        }
                    }
                }
            }
        }
    }
}

// Settings… (spec 14 §4): the pages on the left, the search on top, the rows on the right.
// Every change is written at once; nothing waits for an OK.
export component SettingsWindow inherits Window {
    title: "Settings — Gezik";
    preferred-width: 820px;
    preferred-height: 600px;
    background: Theme.background;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size;
    // The pages, then Open settings.toml and Open Config Folder (one list: less code).
    in property <[string]> pages;
    in property <int> page;
    in property <[SettingItem]> rows;
    // settings.toml does not read: the rows are read-only (the status line says the line).
    in property <bool> read-only;
    // A refused value, a write that failed, settings.toml's error, the unknown keys.
    in-out property <string> status;
    // The status is a problem: red.
    in-out property <bool> status-bad;
    callback page-chosen(int);
    callback search(string);
    callback commit(int, string);
    callback hovered(int, string);
    callback button(int);
    callback row-action(int, int);
    // Esc with no list open.
    callback escape();
    // The page the arrow keys are on in the page list (it may be one of the two links).
    property <int> page-cursor: root.page;
    // The pages without the two links.
    property <int> page-count: root.pages.length - 2;

    function step-page(by: int) {
        root.page-chosen(root.page + by < 0 ? root.page-count - 1 : root.page + by >= root.page-count ? 0 : root.page + by);
    }

    init => { search-field.focus(); }

    // Esc closes the window; Ctrl+PageDown, Ctrl+PageUp and Ctrl+Tab go through the pages.
    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.escape();
                return accept;
            }
            if event.modifiers.control && (event.text == Key.PageDown || (event.text == Key.Tab && !event.modifiers.shift)) {
                root.step-page(1);
                return accept;
            }
            if event.modifiers.control && (event.text == Key.PageUp || event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) {
                root.step-page(-1);
                return accept;
            }
            return reject;
        }
    HorizontalLayout {
        Rectangle {
            width: 180px;
            background: Theme.chrome;
            accessible-role: tab-list;
            // The page list is one stop of Tab; Up and Down choose a page, Enter the links.
            pages-scope := FocusScope {
                key-pressed(event) => {
                    if event.text == Key.DownArrow || event.text == Key.UpArrow {
                        root.page-cursor = event.text == Key.DownArrow ? min(root.page-cursor + 1, root.pages.length - 1) : max(root.page-cursor - 1, 0);
                        if root.page-cursor < root.page-count {
                            root.page-chosen(root.page-cursor);
                        }
                        return accept;
                    }
                    if (event.text == Key.Return || event.text == " ") && root.page-cursor >= root.page-count {
                        root.page-chosen(root.page-cursor);
                        return accept;
                    }
                    return reject;
                }
            }
            VerticalLayout {
                padding: Theme.spacing * 2;
                spacing: 2px;
                alignment: start;
                for title[i] in root.pages: Rectangle {
                    height: Theme.row-height + 2px;
                    border-radius: Theme.radius;
                    background: i == root.page ? Theme.selection : page-touch.has-hover ? Theme.hover : transparent;
                    border-width: pages-scope.has-focus && i == root.page-cursor ? Theme.focus-width : 0px;
                    border-color: Theme.focus-ring;
                    accessible-role: tab;
                    accessible-label: title;
                    accessible-item-selected: i == root.page;
                    accessible-action-default => { root.page-chosen(i); }
                    Text {
                        x: Theme.spacing * 2;
                        height: parent.height;
                        text: title;
                        vertical-alignment: center;
                        color: i == root.page ? Theme.selection-foreground : Theme.foreground;
                    }
                    page-touch := TouchArea {
                        clicked => {
                            root.page-cursor = i;
                            root.page-chosen(i);
                        }
                    }
                }
            }
        }
        VerticalLayout {
            padding: Theme.spacing * 2;
            spacing: Theme.spacing;
            // Its hint is the status line's when nothing else is said there.
            search-field := TextField {
                accessible-label: "Search settings";
                // Not `edited`: a screen reader's or a test's set value searches too.
                changed text => { root.search(self.text); }
            }
            ScrollView {
                content-width: self.visible-width;
                content-height: column.preferred-height;
                column := VerticalLayout {
                    width: parent.width;
                    spacing: 2px;
                    for row[i] in root.rows: SettingLine {
                        item: row;
                        read-only: root.read-only;
                        commit(text) => { root.commit(i, text); }
                        hovered(option) => { root.hovered(i, option); }
                        button => { root.button(i); }
                        action(id) => { root.row-action(i, id); }
                        say(text) => {
                            root.status = text;
                            root.status-bad = false;
                        }
                    }
                }
            }
            Text {
                text: root.status;
                color: root.status-bad ? Theme.danger : Theme.foreground-muted;
                wrap: word-wrap;
            }
        }
    }
    }
}
