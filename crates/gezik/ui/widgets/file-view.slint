import { ListView } from "scrollbar.slint";
import { Theme } from "../theme.slint";
import { FileIcon } from "file-icon.slint";
import { RenameField } from "rename-field.slint";
import { Glyph } from "../glyphs.slint";

// One entry, as Rust (view/model.rs) builds it for the entries on screen.
export struct FileRow {
    name: string,
    is-dir: bool,
    // `Kind` in gezik-core kind.rs: Gezik's icon and its color.
    kind: int,
    size: string,
    // A folder's size older than five minutes, being worked out again: drawn faint.
    size-stale: bool,
    modified: string,
    created: string,
    type-name: string,
    // The system's icon or the thumbnail (`has-icon`), else Gezik's own for `kind`.
    icon: image,
    has-icon: bool,
    selected: bool,
    // Has the keyboard focus; the ring shows only while the view has the keyboard.
    focused: bool,
    // On the clipboard as cut: drawn faded until it is pasted.
    cut: bool,
    // Under a cloud root (spec 9 §7.3): 1 only in the cloud, 2 on this device, 3 always on
    // this device; 0 elsewhere.
    cloud: int,
    // A search result's folder under the scope, and a content search's line ("12: …").
    folder: string,
    found: string,
}

// One line of the view: one entry in the list, a row of cells in the grid, or a group's
// header (spec 10 §6.2): its text with the count (`Today (12)`), no cells.
export struct ItemRow {
    // The index of its first entry (a header's: its group's first entry).
    first: int,
    cells: [FileRow],
    // A group header's text; empty on a line of entries.
    header: string,
    // The header's group is closed.
    collapsed: bool,
}

// A column title: click sorts, right-click opens the header menu, the left edge drags to
// resize (the columns sit right of Name, so their left edge is the one between them).
component HeaderCell inherits Rectangle {
    in property <string> text;
    in property <bool> sorted;
    in property <bool> descending;
    in property <bool> right-aligned;
    in property <bool> resizable: true;
    // The gap to the previous cell; the resize edge covers it and a little of this cell.
    in property <length> gap-before;
    // Space before the title (Name: the icon's width).
    in property <length> indent;
    callback clicked();
    callback menu(length, length);
    // The new width while the left edge is dragged, then once when it is released.
    callback resize(length);
    callback resize-done();

    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.sorted ? (root.descending ? "sorted descending" : "sorted ascending") : "";
    accessible-action-default => { root.clicked(); }
    background: touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        padding-left: root.indent;
        spacing: 4px;
        alignment: root.right-aligned ? end : start;
        Text {
            text: root.text;
            vertical-alignment: center;
            overflow: elide;
            font-size: Theme.font-size-small;
            color: root.sorted ? Theme.foreground : Theme.foreground-muted;
        }
        if root.sorted: VerticalLayout {
            alignment: center;
            Path {
                width: 8px;
                height: 8px;
                viewbox-width: 8;
                viewbox-height: 8;
                stroke: Theme.foreground;
                stroke-width: 1.2px;
                stroke-line-cap: round;
                stroke-line-join: round;
                commands: root.descending ? Glyph.chevron-down : Glyph.chevron-up;
            }
        }
    }

    if root.resizable: Rectangle {
        x: -root.gap-before;
        width: root.gap-before + 4px;
        accessible-role: none;
        edge := TouchArea {
            mouse-cursor: col-resize;
            // The width and the pointer (window x) when the drag started. Absolute, because
            // the edge itself moves as the column grows.
            property <length> start-width;
            property <length> start-x;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    self.start-width = root.width;
                    self.start-x = self.absolute-position.x + self.mouse-x;
                }
                if event.kind == PointerEventKind.up {
                    root.resize-done();
                }
            }
            moved => { root.resize(self.start-width - (self.absolute-position.x + self.mouse-x - self.start-x)); }
        }
    }
}

// The folder's entries, as a list with columns or a grid. Rust owns the selection: this
// reports presses and draws.
export component FileView inherits Rectangle {
    in property <[ItemRow]> items;
    // 0: list, 1: grid.
    in property <int> mode;
    // The grid's picture size.
    in property <length> picture-size: 96px;
    // The view has the keyboard: the focused entry shows a ring.
    in property <bool> has-focus;
    // Scroll offset (content-y: zero or negative).
    in-out property <length> scroll;
    // Column widths (0: hidden); Rust sets them, a dragged edge changes them here.
    in-out property <length> col-modified;
    in-out property <length> col-created;
    in-out property <length> col-type;
    in-out property <length> col-size;
    in-out property <length> col-folder;
    in-out property <length> col-match;
    // The trash is shown: Folder and Modified are where items were and when they were deleted.
    in property <bool> trash;
    // The sort column (0 Name, 1-4 Modified, Created, Type, Size, 5 Folder) and direction.
    in property <int> sort-column;
    in property <bool> sort-desc;
    // The entry being renamed (-1: none): its name shows as a text field.
    in property <int> renaming-index: -1;
    in-out property <string> rename-text;
    // Where the selection ends when renaming starts (bytes).
    in property <int> rename-select;
    // Why the typed name cannot be used; shown under the field.
    in property <string> rename-error;
    callback rename-accepted(string);
    callback rename-cancelled();
    // Tab (false) or Shift+Tab (true): keep the name, go on to the next or previous entry.
    callback rename-tab(string, bool);
    callback rename-edited(string);
    callback rename-blurred(string, int);
    in property <int> rename-generation;
    property <int> rename-applied: -1;
    in-out property <bool> rename-has-focus;
    // The field has the keyboard. A field whose row scrolled out is gone and says nothing, so
    // it only counts while its row is on screen.
    out property <bool> rename-focused: root.rename-has-focus && root.renaming-index >= 0 && root.rename-shown;
    // The renamed entry's line is on screen.
    property <bool> rename-shown: (root.rename-line + 1) * root.item-height > -root.scroll
        && root.rename-line * root.item-height < -root.scroll + list.visible-height;
    // The renamed entry's line; reading `groups-version` (never negative) makes it update.
    property <int> rename-line: root.groups-version < 0 ? -1 : root.line-of(root.renaming-index);
    out property <length> cell-width: max(root.picture-size + 24px, 96px);
    // The grid's first column starts here: the cells are inset from the sheet's edge
    // (`Geometry::Grid.left` in gezik-core layout.rs).
    out property <length> grid-left: Theme.inset;
    out property <length> cell-height: root.picture-size + 24px + Theme.font-size * 2.8;
    // Grid cells per line.
    out property <int> grid-columns: max(1, floor((list.visible-width - 2 * root.grid-left) / root.cell-width));
    out property <length> item-height: root.mode == 0 ? Theme.row-height : root.cell-height;
    // How many lines PgUp/PgDn move: one screen, less one line.
    out property <int> page-rows: max(1, floor(list.visible-height / self.item-height) - 1);

    // Left press on entry `index`, with Ctrl (Cmd on macOS) and Shift.
    callback item-pressed(int, bool, bool);
    // Dragging entries (drag.rs). A left or right press on entry `index` at a window
    // position; `can-drag`: a drag from there moves files (in the list, only from the name).
    callback item-down(int, length, length, bool, bool);
    // The pointer moved with a button down after `item-down` (window position, Shift, Ctrl, Alt).
    callback item-drag(length, length, bool, bool, bool);
    // The button came up (right: the right one). Returns whether a drag used it: then the
    // release opens no menu.
    callback item-up(int, length, length, bool) -> bool;
    // The press was taken away (the pointer left the window, a menu opened).
    callback item-cancel();
    // While files are dragged: the entry they would drop on (-1: none), and whether the
    // drop would be refused (the pointer shows it).
    in property <bool> drag-active;
    in property <bool> drag-forbidden;
    in property <int> drop-entry: -1;
    // Where the entries are, for drag.rs: the visible list's top (under the header and its gap) and size.
    out property <length> list-top: root.header-height + root.list-pad;
    out property <length> list-width: list.visible-width;
    out property <length> list-height: list.visible-height;
    callback item-double-clicked(int);
    callback item-middle-clicked(int);
    // Right-click on an entry, at a window position.
    callback item-menu(int, length, length);
    // Left click on empty space, with Ctrl.
    callback background-pressed(bool);
    callback background-menu(length, length);
    // A press in the view: the keyboard should go to it.
    callback focus-requested();

    // A rubber-band drag: the rectangle in content coordinates (`Rect` in gezik-core
    // layout.rs), on every pointer move; Ctrl adds to the selection the drag started with.
    callback marquee(length, length, length, length, bool);
    callback marquee-done();
    callback header-clicked(int);
    callback header-menu(length, length);
    callback columns-resized();
    callback grid-columns-changed(int);
    // Ctrl+wheel: true for bigger pictures.
    callback zoom(bool);
    // The line entry `index` is on and its column (the grid's), from Rust (`View::place_of`):
    // with groups an entry's line is not `index / per-row`. -1: in a closed group.
    pure callback line-of(int) -> int;
    pure callback column-of(int) -> int;
    // Bumped by Rust whenever the groups change: bindings that call `line-of` read it to update.
    in property <int> groups-version;
    // A click on a group's header (its first entry), and its right-click (window position).
    callback group-toggled(int);
    callback group-menu(int, length, length);

    changed grid-columns => { root.grid-columns-changed(self.grid-columns); }
    // The field's row went off screen while the field had the keyboard: the list drops the
    // field without a blur, and with nothing focused Slint delivers key presses nowhere. The
    // list takes the keyboard and the rename stays open: Enter and Esc are still its own
    // (main.rs), any other key or a click ends it as a blur; scrolled back, the field takes
    // the keyboard again.
    changed rename-focused => {
        if !self.rename-focused && root.rename-has-focus && root.renaming-index >= 0 {
            root.focus-requested();
        }
    }

    property <int> per-row: root.mode == 0 ? 1 : root.grid-columns;
    // The selection shows in full while the view or its rename field has the keyboard, and
    // in the inactive color otherwise.
    property <bool> active: root.has-focus || root.rename-has-focus;
    // The inactive one of two panes (spec 10 §4.3): its selection in the selection color at 45%.
    in property <bool> dimmed;
    // What a screen reader calls the list ("Left pane, C:\Work" with two panes).
    in property <string> label: "Files";
    // The gap above and below the visible list (the rows' inset leaves room for it); the
    // grid's is its inset (Theme.inset + the cells' 4px above the first line); none
    // in the classic themes.
    property <length> list-pad: root.mode == 0 ? min(Theme.inset, 2px) : Theme.inset;
    property <length> header-height: root.mode == 0 ? Theme.row-height : 0px;
    property <length> gap: Theme.spacing + 2px;
    property <length> side: Theme.spacing + 4px;
    property <int> shown-columns: (root.col-modified > 0 ? 1 : 0) + (root.col-created > 0 ? 1 : 0)
        + (root.col-type > 0 ? 1 : 0) + (root.col-size > 0 ? 1 : 0) + (root.col-folder > 0 ? 1 : 0)
        + (root.col-match > 0 ? 1 : 0);

    // Right edge of the Name column, in a row's own coordinates (rows are inset from the
    // list's edges): a drag that starts right of it, on a row, selects with a rectangle; from
    // the name it is kept for dragging files (sub-project 4).
    property <length> name-end: max(root.side + 150px, list.visible-width - 2 * Theme.inset - root.side - root.col-modified - root.col-created
        - root.col-type - root.col-size - root.col-folder - root.col-match - root.gap * root.shown-columns);

    property <bool> marquee-active;
    property <bool> marquee-additive;
    // Where the drag started, in content coordinates, and where the pointer is, in the
    // list's own coordinates (it stays put while the list scrolls under it).
    property <length> start-x;
    property <length> start-y;
    property <length> pointer-x;
    property <length> pointer-y;

    // `x`, `y`: the press, in the list's coordinates.
    function begin-marquee(x: length, y: length, additive: bool) {
        root.start-x = x;
        root.start-y = y - root.scroll;
        root.pointer-x = x;
        root.pointer-y = y;
        root.marquee-additive = additive;
        root.marquee-active = true;
    }

    function track-marquee(x: length, y: length) {
        root.pointer-x = x;
        root.pointer-y = y;
        let content-y = y - root.scroll;
        root.marquee(min(root.start-x, x), min(root.start-y, content-y), abs(x - root.start-x), abs(content-y - root.start-y), root.marquee-additive);
    }

    function end-marquee() {
        if root.marquee-active {
            root.marquee-active = false;
            root.marquee-done();
        }
    }

    // A move or release seen by any entry or the background while a drag runs: the entry
    // that started it may have scrolled away (the list drops lines off screen) and taken
    // the pointer grab with it.
    function marquee-pointer(kind: PointerEventKind, x: length, y: length) {
        if !root.marquee-active {
            return;
        }
        if kind == PointerEventKind.move {
            root.track-marquee(x, y);
        }
        if kind == PointerEventKind.up || kind == PointerEventKind.cancel {
            root.end-marquee();
        }
    }

    // Ctrl+wheel anywhere in the view; a plain wheel scrolls. A sideways-only scroll
    // (no vertical delta) does not zoom.
    function wheel(event: PointerScrollEvent) -> EventResult {
        if event.modifiers.control && event.delta-y != 0 {
            root.zoom(event.delta-y > 0);
            return accept;
        }
        return reject;
    }

    clip: true;
    accessible-role: AccessibleRole.list;
    accessible-label: root.label;

    // Scrolls so entry `index` is fully visible.
    public function ensure-visible(index: int) {
        if index < 0 {
            return;
        }
        let line = root.line-of(index);
        if line < 0 {
            return;
        }
        if line * root.item-height < -root.scroll {
            root.scroll = -line * root.item-height;
        } else if (line + 1) * root.item-height > -root.scroll + list.visible-height {
            root.scroll = -((line + 1) * root.item-height - list.visible-height);
        }
    }

    // Where the keyboard menu of entry `index` opens (a window position): just below it.
    // -1: the background's, at the top left.
    public function menu-x(index: int) -> length {
        if index < 0 {
            return list.absolute-position.x + Theme.spacing * 2;
        }
        if root.mode == 0 {
            return list.absolute-position.x + Theme.spacing * 6;
        }
        return list.absolute-position.x + root.grid-left + root.column-of(index) * root.cell-width + root.cell-width / 2;
    }

    public function menu-y(index: int) -> length {
        if index < 0 {
            return list.absolute-position.y + Theme.spacing * 2;
        }
        return list.absolute-position.y + root.scroll + (root.line-of(index) + 1) * root.item-height;
    }

    // The column header, in the list only.
    if root.mode == 0: Rectangle {
        x: list.x;
        y: 0;
        width: list.visible-width;
        height: root.header-height;

        HorizontalLayout {
            padding-left: Theme.inset + root.side;
            padding-right: Theme.inset + root.side;
            spacing: root.gap;
            HeaderCell {
                horizontal-stretch: 1;
                min-width: 150px;
                text: "Name";
                indent: Theme.icon-size + root.gap;
                resizable: false;
                sorted: root.sort-column == 0;
                descending: root.sort-desc;
                clicked => { root.header-clicked(0); }
                menu(x, y) => { root.header-menu(x, y); }
            }
            if root.col-folder > 0: HeaderCell {
                gap-before: root.gap;
                width: root.col-folder;
                text: root.trash ? "Original location" : "Folder";
                sorted: root.sort-column == 5;
                descending: root.sort-desc;
                clicked => { root.header-clicked(5); }
                menu(x, y) => { root.header-menu(x, y); }
                resize(w) => { root.col-folder = clamp(w, 50px, 600px); }
                resize-done => { root.columns-resized(); }
            }
            if root.col-match > 0: HeaderCell {
                gap-before: root.gap;
                width: root.col-match;
                text: "Match";
                clicked => { root.header-clicked(6); }
                menu(x, y) => { root.header-menu(x, y); }
                resize(w) => { root.col-match = clamp(w, 50px, 600px); }
                resize-done => { root.columns-resized(); }
            }
            if root.col-modified > 0: HeaderCell {
                gap-before: root.gap;
                width: root.col-modified;
                text: root.trash ? "Date deleted" : "Modified";
                sorted: root.sort-column == 1;
                descending: root.sort-desc;
                clicked => { root.header-clicked(1); }
                menu(x, y) => { root.header-menu(x, y); }
                resize(w) => { root.col-modified = clamp(w, 50px, 600px); }
                resize-done => { root.columns-resized(); }
            }
            if root.col-created > 0: HeaderCell {
                gap-before: root.gap;
                width: root.col-created;
                text: "Created";
                sorted: root.sort-column == 2;
                descending: root.sort-desc;
                clicked => { root.header-clicked(2); }
                menu(x, y) => { root.header-menu(x, y); }
                resize(w) => { root.col-created = clamp(w, 50px, 600px); }
                resize-done => { root.columns-resized(); }
            }
            if root.col-type > 0: HeaderCell {
                gap-before: root.gap;
                width: root.col-type;
                text: "Type";
                sorted: root.sort-column == 3;
                descending: root.sort-desc;
                clicked => { root.header-clicked(3); }
                menu(x, y) => { root.header-menu(x, y); }
                resize(w) => { root.col-type = clamp(w, 50px, 600px); }
                resize-done => { root.columns-resized(); }
            }
            if root.col-size > 0: HeaderCell {
                gap-before: root.gap;
                width: root.col-size;
                text: "Size";
                right-aligned: true;
                sorted: root.sort-column == 4;
                descending: root.sort-desc;
                clicked => { root.header-clicked(4); }
                menu(x, y) => { root.header-menu(x, y); }
                resize(w) => { root.col-size = clamp(w, 50px, 600px); }
                resize-done => { root.columns-resized(); }
            }
        }

        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.border;
        }
    }

    // Behind the entries: presses on empty space (the list passes them through). A drag
    // from here selects with a rectangle; a click clears the selection.
    TouchArea {
        x: list.x;
        y: list.y;
        width: list.width;
        height: list.height;
        property <bool> ctrl;
        // The left button is down (a drag with another button never starts a rectangle).
        property <bool> left-down;
        scroll-event(event) => { return root.wheel(event); }
        pointer-event(event) => {
            // A drag whose entry scrolled away (taking the pointer grab with it) goes on here.
            if root.drag-active && event.kind == PointerEventKind.move {
                root.item-drag(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y,
                    event.modifiers.shift, event.modifiers.control, event.modifiers.alt);
            }
            let drag-used = root.drag-active && event.kind == PointerEventKind.up
                && (event.button == PointerEventButton.left || event.button == PointerEventButton.right)
                && root.item-up(-1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y,
                    event.button == PointerEventButton.right);
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                self.ctrl = event.modifiers.control;
                self.left-down = true;
                root.focus-requested();
            }
            if event.kind == PointerEventKind.up {
                let was-left = self.left-down && event.button == PointerEventButton.left;
                self.left-down = false;
                if root.marquee-active {
                    root.end-marquee();
                } else if was-left {
                    root.background-pressed(self.ctrl);
                }
            }
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.right && !drag-used {
                root.background-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if event.kind == PointerEventKind.move && !self.pressed {
                root.marquee-pointer(event.kind, self.mouse-x, self.mouse-y);
            }
        }
        moved => {
            if self.left-down && !root.marquee-active && (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px) {
                root.begin-marquee(self.pressed-x, self.pressed-y, self.ctrl);
            }
            if root.marquee-active {
                root.track-marquee(self.mouse-x, self.mouse-y);
            }
        }
    }

    // ListView only instantiates the lines on screen, so huge folders stay cheap.
    list := ListView {
        x: 0;
        y: root.header-height + root.list-pad;
        width: root.width;
        height: root.height - root.header-height - 2 * root.list-pad;
        content-y <=> root.scroll;
        for item in root.items: line := Rectangle {
            height: root.item-height;

            // The list: one entry with its columns.
            if root.mode == 0 && item.header == "": entry := Rectangle {
                property <FileRow> file: item.cells[0];
                property <int> index: item.first;
                property <color> text-color: self.file.selected ? Theme.selection-foreground : Theme.foreground;
                property <color> muted-color: self.file.selected ? Theme.selection-foreground-muted : Theme.foreground-muted;
                // Inset from the list's edges and rounded (both 0 in the classic themes).
                x: Theme.inset;
                width: parent.width - 2 * Theme.inset;
                border-radius: Theme.row-radius;
                background: root.drop-entry == self.index ? Theme.drop-target
                    : self.file.selected ? (root.dimmed ? Theme.selection.transparentize(0.55) : root.active ? Theme.selection : Theme.selection-inactive)
                    : touch.has-hover && !root.drag-active ? Theme.hover : transparent;
                border-width: root.drop-entry == self.index ? 1px : 0px;
                border-color: Theme.accent;
                accessible-role: list-item;
                accessible-label: self.file.name;
                accessible-item-selectable: true;
                accessible-item-selected: self.file.selected;
                accessible-item-index: self.index;

                touch := TouchArea {
                    property <bool> ctrl;
                    property <bool> left-down;
                    // A left or right button is down after a press here.
                    property <bool> button-down;
                    mouse-cursor: root.drag-active && root.drag-forbidden ? MouseCursor.not-allowed : MouseCursor.default;
                    double-clicked => { root.item-double-clicked(entry.index); }
                    scroll-event(event) => { return root.wheel(event); }
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            self.ctrl = event.modifiers.control;
                            self.left-down = true;
                            root.focus-requested();
                            root.item-pressed(entry.index, event.modifiers.control, event.modifiers.shift);
                        }
                        if event.kind == PointerEventKind.down && (event.button == PointerEventButton.left || event.button == PointerEventButton.right) {
                            self.button-down = true;
                            root.item-down(entry.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y,
                                event.button == PointerEventButton.right, self.mouse-x <= root.name-end);
                        }
                        // Also from another entry: the one pressed may have scrolled away
                        // during the drag, taking the pointer grab with it.
                        if event.kind == PointerEventKind.move && (self.button-down || root.drag-active) {
                            root.item-drag(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y,
                                event.modifiers.shift, event.modifiers.control, event.modifiers.alt);
                        }
                        if event.kind == PointerEventKind.cancel && self.button-down {
                            self.button-down = false;
                            root.item-cancel();
                        }
                        if event.kind == PointerEventKind.up && event.button == PointerEventButton.middle {
                            root.item-middle-clicked(entry.index);
                        }
                        // Every release, without `button-down` too: a re-read (the pane just made
                        // active) makes the entry anew under the press; Rust knows the press.
                        if event.kind == PointerEventKind.up && (event.button == PointerEventButton.left || event.button == PointerEventButton.right) {
                            self.button-down = false;
                            let used = root.item-up(entry.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y,
                                event.button == PointerEventButton.right);
                            if !used && event.button == PointerEventButton.right {
                                root.item-menu(entry.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                        if event.kind == PointerEventKind.up {
                            self.left-down = false;
                        }
                        if !self.pressed || event.kind == PointerEventKind.up {
                            root.marquee-pointer(event.kind, entry.x + self.mouse-x, line.y + root.scroll + self.mouse-y);
                        }
                    }
                    moved => {
                        if self.left-down && !root.marquee-active && self.pressed-x > root.name-end
                            && (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px) {
                            root.begin-marquee(entry.x + self.pressed-x, line.y + root.scroll + self.pressed-y, self.ctrl);
                        }
                        if root.marquee-active {
                            root.track-marquee(entry.x + self.mouse-x, line.y + root.scroll + self.mouse-y);
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: root.side;
                    padding-right: root.side;
                    spacing: root.gap;
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        min-width: 150px;
                        spacing: root.gap;
                        VerticalLayout {
                            alignment: center;
                            FileIcon {
                                width: Theme.icon-size;
                                height: Theme.icon-size;
                                opacity: entry.file.cut ? 0.5 : 1;
                                kind: entry.file.kind;
                                cloud: entry.file.cloud;
                                picture: entry.file.icon;
                                has-picture: entry.file.has-icon;
                            }
                        }
                        if entry.index != root.renaming-index: Text {
                            text: entry.file.name;
                            opacity: entry.file.cut ? 0.5 : 1;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                            color: entry.text-color;
                        }
                        if entry.index == root.renaming-index: RenameField {
                            horizontal-stretch: 1;
                            text <=> root.rename-text;
                            select-end: root.rename-select;
                            invalid: root.rename-error != "";
                            accepted(t) => { root.rename-accepted(t); }
                            cancelled => { root.rename-cancelled(); }
                            tab(t, back) => { root.rename-tab(t, back); }
                            edited(t) => { root.rename-edited(t); }
                            // Off screen the field loses the keyboard to the list (`rename-focused`):
                            // no blur, the rename stays open.
                            blurred(t, g) => {
                                if root.rename-shown {
                                    root.rename-blurred(t, g);
                                }
                            }
                            shown: root.rename-shown;
                            generation: root.rename-generation;
                            applied <=> root.rename-applied;
                            focused <=> root.rename-has-focus;
                        }
                    }
                    if root.col-folder > 0: Text {
                        width: root.col-folder;
                        text: entry.file.folder;
                        vertical-alignment: center;
                        overflow: elide;
                        color: entry.muted-color;
                    }
                    if root.col-match > 0: Text {
                        width: root.col-match;
                        text: entry.file.found;
                        vertical-alignment: center;
                        overflow: elide;
                        color: entry.text-color;
                    }
                    if root.col-modified > 0: Text {
                        width: root.col-modified;
                        text: entry.file.modified;
                        vertical-alignment: center;
                        overflow: elide;
                        color: entry.muted-color;
                    }
                    if root.col-created > 0: Text {
                        width: root.col-created;
                        text: entry.file.created;
                        vertical-alignment: center;
                        overflow: elide;
                        color: entry.muted-color;
                    }
                    if root.col-type > 0: Text {
                        width: root.col-type;
                        text: entry.file.type-name;
                        vertical-alignment: center;
                        overflow: elide;
                        color: entry.muted-color;
                    }
                    if root.col-size > 0: Text {
                        width: root.col-size;
                        text: entry.file.size;
                        opacity: entry.file.size-stale ? 0.55 : 1;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                        color: entry.muted-color;
                    }
                }

                if entry.file.focused && root.has-focus: Rectangle {
                    border-width: Theme.focus-width;
                    border-radius: Theme.row-radius;
                    border-color: Theme.focus-ring;
                }
            }

            // The grid: a row of cells. The gaps between them let presses through to the
            // background, where a drag selects with a rectangle. One tile per column, not
            // per cell: a changed line (a new selection) brings a new cells model, a
            // repeater over a new model rebuilds its tiles, and a rebuilt tile loses the
            // press under the pointer and with it a double-click.
            if root.mode == 1 && item.header == "": Rectangle {
                for c in root.per-row: Rectangle {
                    if c < item.cells.length: tile := Rectangle {
                        property <FileRow> cell: item.cells[c];
                        property <int> index: item.first + c;
                        x: root.grid-left + c * root.cell-width;
                        y: 0;
                        width: root.cell-width;
                        height: root.cell-height;
                        accessible-role: list-item;
                        accessible-label: tile.cell.name;
                        accessible-item-selectable: true;
                        accessible-item-selected: tile.cell.selected;
                        accessible-item-index: self.index;

                        Rectangle {
                            x: 4px;
                            y: 4px;
                            width: parent.width - 8px;
                            height: parent.height - 8px;
                            border-radius: Theme.radius;
                            background: root.drop-entry == tile.index ? Theme.drop-target
                                : tile.cell.selected ? (root.dimmed ? Theme.selection.transparentize(0.55) : root.active ? Theme.selection : Theme.selection-inactive)
                                : tile-touch.has-hover && !root.drag-active ? Theme.hover : transparent;
                            border-width: root.drop-entry == tile.index ? 1px : tile.cell.focused && root.has-focus ? Theme.focus-width : 0px;
                            border-color: root.drop-entry == tile.index ? Theme.accent : Theme.focus-ring;
                        }

                        FileIcon {
                            x: (parent.width - self.width) / 2;
                            y: 10px;
                            width: root.picture-size;
                            height: root.picture-size;
                            opacity: tile.cell.cut ? 0.5 : 1;
                            kind: tile.cell.kind;
                            cloud: tile.cell.cloud;
                            picture: tile.cell.icon;
                            has-picture: tile.cell.has-icon;
                        }

                        if tile.index != root.renaming-index: Text {
                            x: 8px;
                            y: 14px + root.picture-size;
                            width: parent.width - 16px;
                            height: parent.height - self.y - 8px;
                            text: tile.cell.name;
                            opacity: tile.cell.cut ? 0.5 : 1;
                            wrap: word-wrap;
                            overflow: elide;
                            horizontal-alignment: center;
                            vertical-alignment: top;
                            color: tile.cell.selected ? Theme.selection-foreground : Theme.foreground;
                        }
                        if tile.index == root.renaming-index: RenameField {
                            x: 8px;
                            y: 14px + root.picture-size;
                            width: parent.width - 16px;
                            height: Theme.row-height;
                            centered: true;
                            text <=> root.rename-text;
                            select-end: root.rename-select;
                            invalid: root.rename-error != "";
                            accepted(t) => { root.rename-accepted(t); }
                            cancelled => { root.rename-cancelled(); }
                            tab(t, back) => { root.rename-tab(t, back); }
                            edited(t) => { root.rename-edited(t); }
                            // Off screen the field loses the keyboard to the list (`rename-focused`):
                            // no blur, the rename stays open.
                            blurred(t, g) => {
                                if root.rename-shown {
                                    root.rename-blurred(t, g);
                                }
                            }
                            shown: root.rename-shown;
                            generation: root.rename-generation;
                            applied <=> root.rename-applied;
                            focused <=> root.rename-has-focus;
                        }

                        // Cells never start a rectangle (a drag from an entry is kept for
                        // dragging files); they only pass moves and releases on to a running one.
                        tile-touch := TouchArea {
                            x: 4px;
                            y: 4px;
                            width: parent.width - 8px;
                            height: parent.height - 8px;
                            property <bool> button-down;
                            mouse-cursor: root.drag-active && root.drag-forbidden ? MouseCursor.not-allowed : MouseCursor.default;
                            double-clicked => { root.item-double-clicked(tile.index); }
                            scroll-event(event) => { return root.wheel(event); }
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                    root.focus-requested();
                                    root.item-pressed(tile.index, event.modifiers.control, event.modifiers.shift);
                                }
                                if event.kind == PointerEventKind.down && (event.button == PointerEventButton.left || event.button == PointerEventButton.right) {
                                    self.button-down = true;
                                    root.item-down(tile.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y,
                                        event.button == PointerEventButton.right, true);
                                }
                                if event.kind == PointerEventKind.move && (self.button-down || root.drag-active) {
                                    root.item-drag(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y,
                                        event.modifiers.shift, event.modifiers.control, event.modifiers.alt);
                                }
                                if event.kind == PointerEventKind.cancel && self.button-down {
                                    self.button-down = false;
                                    root.item-cancel();
                                }
                                if event.kind == PointerEventKind.up && event.button == PointerEventButton.middle {
                                    root.item-middle-clicked(tile.index);
                                }
                                // Every release, as for list entries.
                                if event.kind == PointerEventKind.up && (event.button == PointerEventButton.left || event.button == PointerEventButton.right) {
                                    self.button-down = false;
                                    let used = root.item-up(tile.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y,
                                        event.button == PointerEventButton.right);
                                    if !used && event.button == PointerEventButton.right {
                                        root.item-menu(tile.index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                    }
                                }
                                if !self.pressed || event.kind == PointerEventKind.up {
                                    root.marquee-pointer(event.kind, tile.x + self.x + self.mouse-x, line.y + root.scroll + self.y + self.mouse-y);
                                }
                            }
                        }
                    }
                }
            }

            // A group's header (spec 10 §6.2): its name and count, at the bottom of the line (in
            // the grid the line is as high as a cell line). A click opens or closes the group;
            // it never takes the keyboard.
            if item.header != "": Rectangle {
                x: Theme.inset;
                width: parent.width - 2 * Theme.inset;
                accessible-role: button;
                accessible-label: item.header + (item.collapsed ? ", collapsed" : ", expanded");
                accessible-action-default => { root.group-toggled(item.first); }
                TouchArea {
                    scroll-event(event) => { return root.wheel(event); }
                    clicked => {
                        root.focus-requested();
                        root.group-toggled(item.first);
                    }
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                            root.group-menu(item.first, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                        if !self.pressed || event.kind == PointerEventKind.up {
                            root.marquee-pointer(event.kind, parent.x + self.mouse-x, line.y + root.scroll + self.mouse-y);
                        }
                    }
                }
                HorizontalLayout {
                    y: parent.height - Theme.row-height;
                    width: parent.width;
                    height: Theme.row-height;
                    padding-left: root.side;
                    padding-right: root.side;
                    spacing: root.gap;
                    VerticalLayout {
                        alignment: center;
                        Path {
                            width: 8px;
                            height: 8px;
                            viewbox-width: 8;
                            viewbox-height: 8;
                            commands: item.collapsed ? Glyph.chevron-right : Glyph.chevron-down;
                            stroke: Theme.foreground-muted;
                            stroke-width: 1.2px;
                            stroke-line-cap: round;
                            stroke-line-join: round;
                        }
                    }
                    Text {
                        text: item.header;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                        color: Theme.foreground;
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }
            }
        }
    }

    // Near the top or bottom edge, a running drag scrolls the list.
    Timer {
        interval: 30ms;
        running: root.marquee-active && (root.pointer-y < 24px || root.pointer-y > list.visible-height - 24px);
        triggered => {
            let step = root.item-height / 2;
            let lowest = min(0px, list.visible-height - list.content-height);
            root.scroll = clamp(root.pointer-y < 24px ? root.scroll + step : root.scroll - step, lowest, 0px);
            root.track-marquee(root.pointer-x, root.pointer-y);
        }
    }

    if root.marquee-active: Rectangle {
        property <length> top: root.start-y + root.scroll;
        x: list.x + min(root.start-x, root.pointer-x);
        y: list.y + min(self.top, root.pointer-y);
        width: abs(root.pointer-x - root.start-x);
        height: abs(root.pointer-y - self.top);
        background: Theme.marquee;
        border-width: 1px;
        border-color: Theme.focus-ring;
    }

    // Why the typed name cannot be used, just under the entry.
    if root.rename-error != "" && root.renaming-index >= 0: Rectangle {
        property <int> line: root.rename-line;
        x: list.x + (root.mode == 0 ? Theme.inset + root.side + Theme.icon-size + root.gap : root.grid-left + root.column-of(root.renaming-index) * root.cell-width + 8px);
        y: list.y + root.scroll + (self.line + 1) * root.item-height;
        width: error-text.preferred-width + Theme.spacing * 2;
        height: error-text.preferred-height + Theme.spacing;
        background: Theme.danger;
        border-radius: Theme.radius;
        accessible-role: text;
        accessible-label: root.rename-error;
        error-text := Text {
            x: Theme.spacing;
            y: Theme.spacing / 2;
            text: root.rename-error;
            color: Theme.background;
        }
    }
}
