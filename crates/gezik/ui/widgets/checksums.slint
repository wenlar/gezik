import { Theme } from "../theme.slint";
import { TextButton } from "text-button.slint";
import { TextField } from "text-field.slint";
import { Check } from "check.slint";
import { ListView } from "scrollbar.slint";

// A row of the Checksums layer (checksums.rs).
export struct ChecksumRow {
    name: string,
    size: string,
    // The shown values side by side in a fixed-width font, so they line up under `values-title`.
    values: string,
    status: string,
    // 0 plain, 1 good (OK, the expected value), 2 bad (FAILED, MISSING, UNREADABLE, not it).
    tone: int,
    selected: bool,
}

// The Checksums layer: the algorithms to compute, the expected value, a row per file with its
// values, and Copy / Save / Export CSV. In verify mode a checksum file's rows with their
// results. Esc closes, Ctrl+C copies, Ctrl+A selects all (main.rs routes them). Kept plain
// (one text for a row's values): each nested element costs the exe.
export component ChecksumsLayer inherits Rectangle {
    in property <bool> open;
    in property <bool> dialog-open;
    in property <int> focus-request;
    in property <string> title;
    in property <bool> verify;
    in property <string> mono-font;
    // Which of CRC32, MD5, SHA-1, SHA-256, SHA-512 are ticked.
    in property <[bool]> algos;
    in property <string> values-title;
    in property <[ChecksumRow]> rows;
    in-out property <string> expected;
    in property <string> summary;
    // 0 plain, 1 good, 2 bad.
    in property <int> summary-tone;
    in property <bool> only-failed;
    // The Expected field has the keyboard: Ctrl+C and Ctrl+A are its own then.
    in-out property <bool> field-focused;
    in-out property <length> scroll;
    callback toggle-algo(int);
    callback expected-edited();
    callback toggle-only-failed();
    callback pressed(int, bool, bool);
    callback copy();
    callback save();
    callback export();
    callback close();

    // Built when it opens (an `if` in app.slint): the list takes the keyboard then, and again
    // each time `focus-request` changes.
    init => {
        if root.open && !root.dialog-open {
            scope.focus();
        }
    }
    changed focus-request => {
        if !root.dialog-open {
            scope.focus();
        }
    }

    background: Theme.overlay;
    // Clicks outside the box go nowhere.
    TouchArea { }

    Rectangle {
        width: min(1100px, root.width - 48px);
        height: min(640px, root.height - 48px);
        x: (root.width - self.width) / 2;
        y: max(24px, (root.height - self.height) / 3);
        background: Theme.surface-raised;
        border-radius: Theme.radius * 1.5;
        border-width: 1px;
        border-color: Theme.border;
        accessible-role: groupbox;
        accessible-label: root.title;

        VerticalLayout {
            padding: Theme.spacing * 3;
            spacing: Theme.spacing * 1.5;

            HorizontalLayout {
                spacing: Theme.spacing * 2;
                Text {
                    text: root.title;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                    color: Theme.foreground;
                }
                for name[i] in root.verify ? [] : ["CRC32", "MD5", "SHA-1", "SHA-256", "SHA-512"]: Check {
                    text: name;
                    checked: root.algos[i];
                    toggled => { root.toggle-algo(i); }
                }
            }
            HorizontalLayout {
                spacing: Theme.spacing;
                // Verify has no expected value: the filter takes the row.
                Check {
                    visible: root.verify;
                    width: root.verify ? self.min-width : 0;
                    text: "Failed and missing only";
                    checked: root.only-failed;
                    toggled => { root.toggle-only-failed(); }
                }
                Text {
                    visible: !root.verify;
                    text: "Expected";
                    width: root.verify ? 0 : 72px;
                    vertical-alignment: center;
                    color: Theme.foreground-muted;
                }
                TextField {
                    visible: !root.verify;
                    text <=> root.expected;
                    edited => { root.expected-edited(); }
                    changed has-focus => { root.field-focused = self.has-focus; }
                }
            }

            header := HorizontalLayout {
                // The name's width; the values take what is left after size and status.
                property <length> name-width: (self.width - 190px) * 0.3;
                padding-left: Theme.spacing;
                padding-right: 10px;
                spacing: Theme.spacing * 2;
                Text { text: "Name"; width: header.name-width; color: Theme.foreground-muted; }
                Text { text: "Size"; width: 80px; horizontal-alignment: right; color: Theme.foreground-muted; }
                Text {
                    text: root.values-title;
                    font-family: root.mono-font;
                    overflow: elide;
                    color: Theme.foreground-muted;
                }
                Text { text: "Status"; width: 110px; color: Theme.foreground-muted; }
            }
            Rectangle { height: 1px; background: Theme.border; }

            scope := FocusScope {
                vertical-stretch: 1;
                ListView {
                    content-y <=> root.scroll;
                    for row[i] in root.rows: Rectangle {
                        height: Theme.row-height;
                        background: row.selected ? Theme.selection : touch.has-hover ? Theme.hover : transparent;
                        accessible-role: list-item;
                        accessible-label: row.name;
                        accessible-value: row.values;
                        accessible-description: row.status;
                        accessible-item-selectable: true;
                        accessible-item-selected: row.selected;
                        accessible-item-index: i;

                        touch := TouchArea {
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                    scope.focus();
                                    root.pressed(i, event.modifiers.control || event.modifiers.meta, event.modifiers.shift);
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: Theme.spacing;
                            spacing: Theme.spacing * 2;
                            Text {
                                text: row.name;
                                width: header.name-width;
                                vertical-alignment: center;
                                overflow: elide;
                                color: row.selected ? Theme.selection-foreground : Theme.foreground;
                            }
                            Text {
                                text: row.size;
                                width: 80px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                color: row.selected ? Theme.selection-foreground : Theme.foreground-muted;
                            }
                            Text {
                                text: row.values;
                                font-family: root.mono-font;
                                vertical-alignment: center;
                                overflow: elide;
                                color: row.selected ? Theme.selection-foreground : Theme.foreground;
                            }
                            Text {
                                text: row.status;
                                width: 110px;
                                vertical-alignment: center;
                                overflow: elide;
                                color: row.tone == 1 ? Theme.success : row.tone == 2 ? Theme.danger : row.selected ? Theme.selection-foreground : Theme.foreground-muted;
                            }
                        }
                    }
                }
            }

            Text {
                text: root.summary;
                wrap: word-wrap;
                color: root.summary-tone == 1 ? Theme.success : root.summary-tone == 2 ? Theme.danger : Theme.foreground-muted;
            }
            HorizontalLayout {
                spacing: Theme.spacing;
                // One repeated button (each placed one is code of its own).
                for label in root.verify ? ["Copy", "Export CSV…", "Close"] : ["Copy", "Save…", "Export CSV…", "Close"]: TextButton {
                    text: label;
                    primary: label == "Close";
                    clicked => {
                        if label == "Copy" {
                            root.copy();
                        } else if label == "Save…" {
                            root.save();
                        } else if label == "Export CSV…" {
                            root.export();
                        } else {
                            root.close();
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}
