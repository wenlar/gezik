import { Theme } from "../theme.slint";
import { Glyph } from "../glyphs.slint";
import { ListView } from "scrollbar.slint";
import { FileIcon } from "file-icon.slint";
import { FileRow, ItemRow } from "file-view.slint";
import { PreviewPane, PreviewInfo } from "preview-pane.slint";

// One Miller column (spec 10 §7, view/columns.rs): its rows (none while it is read, once it is
// released, and for the focused one, which the pane's file view is laid over) and its scroll.
export struct ColumnItem {
    rows: [ItemRow],
    scroll: length,
}

// The pane's Miller columns side by side, scrolling sideways. The focused column's place is
// left empty for the pane's file view; each other column lists its folder (icon, name, › for a
// folder). A selected file's preview comes last.
export component ColumnView inherits Rectangle {
    in property <[ColumnItem]> columns;
    in property <int> focused;
    in property <bool> preview-shown;
    in property <PreviewInfo> preview;
    in property <string> mono-font;
    // Every column's width: dragging any column's edge sets it.
    in-out property <length> column-width;
    // The sideways scroll offset (content-x: zero or negative).
    in-out property <length> scroll-x;
    in property <bool> drag-active;
    in property <bool> drag-forbidden;
    // The drop target: row `drop-row` of column `drop-column`.
    in property <int> drop-column: -1;
    in property <int> drop-row: -1;
    // A left or right press (`bool`: right) in column `int` (not the focused one) on row `int`
    // (-1: its empty space), with that column's offset, at a window point.
    callback pressed(int, int, length, length, length, bool);
    // The pointer moved with a button down (shift, ctrl, alt); the press was taken away.
    callback dragged(length, length, bool, bool, bool);
    callback cancelled();
    // The button came up at a window point (`bool`: right): whether a drag used it.
    callback released(length, length, bool) -> bool;
    // A right-click no drag used: the menu of the row (`bool`) or the column's folder.
    callback menu(bool, length, length);
    callback middle-clicked(int, int);
    // Column `int` scrolled to `length`.
    callback scrolled(int, length);
    // The columns on screen: the first and one past the last that fits (more than there are,
    // so a column added there counts as shown at once).
    callback shown(int, int);

    property <length> stride: root.column-width + 1px;
    property <int> count: root.columns.length + (root.preview-shown ? 1 : 0);
    property <length> pad: min(Theme.inset, 2px);
    property <int> first-shown: max(0, floor(-root.scroll-x / root.stride));
    property <int> end-shown: ceil((-root.scroll-x + root.width) / root.stride);
    changed first-shown => { root.shown(self.first-shown, root.end-shown); }
    changed end-shown => { root.shown(root.first-shown, self.end-shown); }

    // The focused column and the one after it (or the preview) in view, in one step: no
    // animation, so opening a column costs one frame (spec 10 §7.2).
    function keep-in-view() {
        let right = min(root.count, root.focused + 2) * root.stride;
        if right > -root.scroll-x + root.width {
            root.scroll-x = min(0px, root.width - right);
        }
        if root.focused * root.stride < -root.scroll-x {
            root.scroll-x = -root.focused * root.stride;
        }
        root.scroll-x = max(root.scroll-x, min(0px, root.width - root.count * root.stride));
    }
    changed focused => { root.keep-in-view(); }
    changed count => { root.keep-in-view(); }
    changed width => { root.keep-in-view(); }
    init => {
        root.keep-in-view();
        root.shown(root.first-shown, root.end-shown);
    }

    flick := Flickable {
        content-width: max(self.width, root.count * root.stride);
        content-height: self.height;
        content-x <=> root.scroll-x;
        // Dragging selects or moves files; it never pans.
        mouse-drag-pan-enabled: false;

        for column[i] in root.columns: Rectangle {
            x: i * root.stride;
            width: root.column-width;
            height: root.height;

            // Behind the rows (the list passes presses through): presses, drags, menus on a row
            // or on the column's empty space. Pressed, it keeps the pointer while its column
            // takes the focus and the file view is laid over it.
            touch := TouchArea {
                y: list.y;
                height: list.height;
                property <int> at-row: self.mouse-y < list.content-y + column.rows.length * Theme.row-height ? floor((self.mouse-y - list.content-y) / Theme.row-height) : -1;
                property <bool> button-down;
                property <bool> on-row;
                mouse-cursor: root.drag-active && root.drag-forbidden ? MouseCursor.not-allowed : MouseCursor.default;
                pointer-event(event) => {
                    let px = self.absolute-position.x + self.mouse-x;
                    let py = self.absolute-position.y + self.mouse-y;
                    let right = event.button == PointerEventButton.right;
                    if event.kind == PointerEventKind.down && (event.button == PointerEventButton.left || right) {
                        self.button-down = true;
                        self.on-row = self.at-row >= 0;
                        root.pressed(i, self.at-row, list.content-y, px, py, right);
                    }
                    if event.kind == PointerEventKind.move && (self.button-down || root.drag-active) {
                        root.dragged(px, py, event.modifiers.shift, event.modifiers.control, event.modifiers.alt);
                    }
                    if event.kind == PointerEventKind.cancel && self.button-down {
                        self.button-down = false;
                        root.cancelled();
                    }
                    if event.kind == PointerEventKind.up && event.button == PointerEventButton.middle && self.at-row >= 0 {
                        root.middle-clicked(i, self.at-row);
                    }
                    if event.kind == PointerEventKind.up && self.button-down && (event.button == PointerEventButton.left || right) {
                        self.button-down = false;
                        if !((self.on-row || root.drag-active) && root.released(px, py, right)) && right {
                            root.menu(self.on-row, px, py);
                        }
                    }
                }
            }

            list := ListView {
                y: root.pad;
                height: parent.height - 2 * root.pad;
                content-y: column.scroll;
                changed content-y => { root.scrolled(i, self.content-y); }
                for item in column.rows: row := Rectangle {
                    property <FileRow> file: item.cells[0];
                    property <bool> drop: root.drop-column == i && root.drop-row == item.first;
                    height: Theme.row-height;
                    Rectangle {
                        x: Theme.inset;
                        width: parent.width - 2 * Theme.inset;
                        border-radius: Theme.row-radius;
                        background: row.drop ? Theme.drop-target : row.file.selected ? Theme.selection-inactive : touch.has-hover && !root.drag-active && touch.at-row == item.first ? Theme.hover : transparent;
                        border-width: row.drop ? 1px : 0px;
                        border-color: Theme.accent;
                        accessible-role: list-item;
                        accessible-label: row.file.name;
                        accessible-item-selectable: true;
                        accessible-item-selected: row.file.selected;
                        HorizontalLayout {
                            padding-left: Theme.spacing + 4px;
                            padding-right: Theme.spacing + 4px;
                            spacing: Theme.spacing + 2px;
                            VerticalLayout {
                                alignment: center;
                                FileIcon {
                                    width: Theme.icon-size;
                                    height: Theme.icon-size;
                                    opacity: row.file.cut ? 0.5 : 1;
                                    kind: row.file.kind;
                                    cloud: row.file.cloud;
                                    picture: row.file.icon;
                                    has-picture: row.file.has-icon;
                                }
                            }
                            Text {
                                text: row.file.name;
                                opacity: row.file.cut ? 0.5 : 1;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                                color: row.file.selected ? Theme.selection-foreground : Theme.foreground;
                            }
                            if row.file.is-dir: VerticalLayout {
                                alignment: center;
                                Path {
                                    width: 8px;
                                    height: 8px;
                                    viewbox-width: 8;
                                    viewbox-height: 8;
                                    commands: Glyph.chevron-right;
                                    stroke: Theme.foreground-muted;
                                    stroke-width: 1.2px;
                                    stroke-line-cap: round;
                                    stroke-line-join: round;
                                }
                            }
                        }
                    }
                }
            }

            // The line after the column; dragged, every column takes the width that keeps
            // this edge under the pointer.
            Rectangle {
                x: parent.width;
                width: 1px;
                background: Theme.border;
            }
            TouchArea {
                x: parent.width - 3px;
                width: 7px;
                mouse-cursor: col-resize;
                moved => {
                    root.column-width = clamp((self.absolute-position.x + self.mouse-x - flick.absolute-position.x - root.scroll-x + 1px) / (i + 1) - 1px, 120px, 600px);
                }
            }
        }

        if root.preview-shown: PreviewPane {
            x: root.columns.length * root.stride;
            width: root.column-width;
            height: root.height;
            info: root.preview;
            mono-font: root.mono-font;
        }
    }
}
