import { Theme } from "../theme.slint";
import { TextButton } from "text-button.slint";
import { ListView } from "scrollbar.slint";

// One line of a command's output (command_line.rs): from its error output when `err`.
export struct CmdLine {
    text: string,
    err: bool,
}

// The command panel under a pane's list (spec 16 §7.3): the command, its folder, how it runs
// or ended, its output as it comes (the list follows the end unless scrolled up), and its
// buttons. Its top edge is dragged to change its height.
export component CommandOutput inherits Rectangle {
    in property <[CmdLine]> lines;
    in property <string> title;
    in property <string> folder;
    in property <string> status;
    // 0 running, 1 ended with 0, 2 ended otherwise (or stopped, or did not start).
    in property <int> state;
    in property <bool> dropped;
    in property <string> mono-font;
    in-out property <length> panel-height: 180px;
    // Bumped by each run: the list starts at its end and follows it.
    in property <int> run;
    // Open in Terminal is offered (a git command that wanted a password, spec 16 §9.4).
    in property <bool> terminal;
    // 0 Stop, 1 Run Again, 2 Copy Output, 3 Close, 4 Open in Terminal.
    callback button(int);
    // Where the list is scrolled, and where its end is (the last line whole at the bottom): the
    // tests' (`CommandOutputProbe`).
    out property <length> view-y: list.content-y;
    out property <length> view-end: min(0px, list.visible-height - root.lines.length * root.line-height);
    out property <length> line-step: root.line-height;

    property <length> line-height: Theme.font-size + 5px;
    property <length> pressed-height;
    // The list follows new lines while it is at the end, as a terminal does. Only the user's
    // scrolling (the wheel, the keys, the scroll bar) turns following off, when it leaves the
    // list short of its end; reaching the end again, End, or a new run turn it back on.
    property <bool> follow: true;
    property <length> end: min(0px, list.visible-height - list.content-height);
    function to-end() {
        list.content-y = root.end;
    }
    changed end => {
        if root.follow {
            root.to-end();
        }
    }
    changed run => {
        root.follow = true;
        root.to-end();
    }
    // The user scrolled to `y`.
    function scroll-to(y: length) {
        list.content-y = clamp(y, root.end, 0px);
        root.follow = list.content-y <= root.end + 1px;
    }

    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.sheet-radius;
    accessible-role: groupbox;
    accessible-label: @tr("Command Output");

    // The top edge: dragged, it sets the height (80 to 600 px).
    TouchArea {
        y: 0;
        height: 5px;
        mouse-cursor: row-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.pressed-height = root.panel-height;
            }
        }
        moved => {
            if self.pressed {
                root.panel-height = clamp(root.pressed-height - (self.mouse-y - self.pressed-y), 80px, 600px);
            }
        }
    }

    VerticalLayout {
        padding: Theme.spacing;
        spacing: 4px;
        HorizontalLayout {
            spacing: Theme.spacing;
            Text {
                text: root.title;
                font-family: root.mono-font;
                font-weight: 600;
                overflow: elide;
                horizontal-stretch: 1;
                min-width: 40px;
                vertical-alignment: center;
                color: Theme.foreground;
            }
            Text {
                text: root.folder;
                overflow: elide;
                horizontal-stretch: 1;
                min-width: 40px;
                vertical-alignment: center;
                color: Theme.foreground-muted;
            }
            Text {
                text: root.status;
                vertical-alignment: center;
                color: root.state == 1 ? Theme.success : root.state == 2 ? Theme.danger : Theme.foreground-muted;
            }
            if root.state == 0: TextButton {
                text: @tr("Stop");
                compact: true;
                clicked => { root.button(0); }
            }
            if root.terminal: TextButton {
                text: @tr("Open in Terminal");
                compact: true;
                clicked => { root.button(4); }
            }
            if root.state != 0: TextButton {
                text: @tr("Run Again");
                compact: true;
                clicked => { root.button(1); }
            }
            TextButton {
                text: @tr("Copy Output");
                compact: true;
                clicked => { root.button(2); }
            }
            TextButton {
                text: @tr("Close");
                compact: true;
                clicked => { root.button(3); }
            }
        }
        if root.dropped: Text {
            text: @tr("Earlier output dropped");
            color: Theme.foreground-muted;
            font-size: Theme.font-size-small;
        }
        // A click gives the output the keyboard: the arrows, PageUp/PageDown, Home and End
        // scroll it (End follows the end again).
        keys := FocusScope {
            key-pressed(event) => {
                if event.text == Key.PageUp {
                    root.scroll-to(list.content-y + list.visible-height);
                } else if event.text == Key.PageDown {
                    root.scroll-to(list.content-y - list.visible-height);
                } else if event.text == Key.UpArrow {
                    root.scroll-to(list.content-y + root.line-height);
                } else if event.text == Key.DownArrow {
                    root.scroll-to(list.content-y - root.line-height);
                } else if event.text == Key.Home {
                    root.scroll-to(0px);
                } else if event.text == Key.End {
                    root.scroll-to(root.end);
                } else {
                    return reject;
                }
                accept
            }
            list := ListView {
                width: parent.width;
                height: parent.height;
                accessible-label: @tr("Output");
                // Every line is one height: the list's own estimate came a line short at the end.
                content-height: root.lines.length * root.line-height;
                // Taking lines off the top moves the list (after `end` changed): back to the end.
                changed content-y => {
                    if root.follow && self.content-y != root.end {
                        root.to-end();
                    }
                }
                bar-moved => { root.follow = self.content-y <= root.end + 1px; }
                for line in root.lines: Text {
                    height: root.line-height;
                    text: line.text;
                    font-family: root.mono-font;
                    color: line.err ? Theme.warning : Theme.foreground;
                    overflow: clip;
                    vertical-alignment: center;
                    accessible-role: text;
                }
            }
            // Over the lines (not the scroll bar): a click gives the keyboard, the wheel scrolls.
            TouchArea {
                width: parent.width - 10px;
                height: parent.height;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        keys.focus();
                    }
                }
                scroll-event(event) => {
                    root.scroll-to(list.content-y + event.delta-y);
                    accept
                }
            }
            // Its ring while it has the keyboard.
            Rectangle {
                border-width: keys.has-focus ? Theme.focus-width : 0px;
                border-color: Theme.focus-ring;
                border-radius: Theme.radius-small;
            }
        }
    }
}
