import { Theme } from "../theme.slint";
import { Glyph } from "../glyphs.slint";

export struct TabItem {
    title: string,
    active: bool,
    // A locked tab does not close (no ×, Ctrl+W and middle-click say so).
    locked: bool,
}

// The tab strip: click to switch, middle-click or × to close, drag to reorder, + for a new tab.
// A locked tab shows a lock before its title and no ×.
export component TabBar inherits Rectangle {
    in property <[TabItem]> tabs;
    callback activate(int);
    callback close(int);
    callback new-tab();
    callback move-tab(int, int);
    // Right-click on tab `int`, at a window position.
    callback tab-menu(int, length, length);
    // Tab `int` dragged to a window position (released: dropped; -1: the drag ended): whether
    // it is over the other pane, which takes it on the drop (spec 10 §4.5).
    callback tab-out(int, length, length, bool) -> bool;
    // Where a tab dragged from the other pane would go (-1: none).
    in property <int> insert-at: -1;

    // Equal-width tabs that shrink as more are opened, down to a minimum; then the strip scrolls.
    out property <length> tab-width: clamp(strip.width / max(1, root.tabs.length), 90px, 220px);
    // For drag.rs: where the strip starts (it is inset from the window's edge), its scroll
    // offset (content-x) and width.
    out property <length> strip-x: strip.x;
    out property <length> scroll: strip.content-x;
    out property <length> strip-width: strip.width;
    // While files are dragged: the tab they would drop on (-1: none).
    in property <int> drop-tab: -1;
    // The strip of the active one of two panes: its active tab gets an accent line on top.
    in property <bool> marked;
    // Sync browsing is on (spec 10 §4.7): a thin accent line under the strip.
    in property <bool> synced;
    // While a tab is dragged: where it came from and where it would be dropped.
    property <int> drag-from: -1;
    property <int> drag-to: -1;
    // Set once the pointer moved far enough to count as a drag, so the release is no click.
    property <bool> dragged;
    // A drag in progress refers to tab indexes: when tabs are added or closed it is dropped.
    property <int> tab-count: root.tabs.length;
    // Set when a drag ends or is dropped; a new drag needs a new press.
    property <bool> drag-blocked;
    // The dragged tab is over the other pane: this strip does not reorder.
    property <bool> away;
    changed tab-count => { root.cancel-drag(); }

    height: Theme.tab-strip-height;
    background: Theme.chrome;
    accessible-role: tab-list;

    function cancel-drag() {
        root.drag-blocked = true;
        root.drag-from = -1;
        root.drag-to = -1;
        // The other pane's strip shows no insertion line any more.
        root.away = root.tab-out(-1, 0px, 0px, true);
    }

    // Scrolls the strip by `delta` (the wheel), staying within its content.
    function scroll-by(delta: length) {
        strip.content-x = clamp(strip.content-x + delta, min(0px, strip.width - strip.content-width), 0px);
    }

    // Scrolls the strip so that tab `i` is fully visible.
    function reveal(i: int) {
        if i * root.tab-width < -strip.content-x {
            strip.content-x = -i * root.tab-width;
        } else if (i + 1) * root.tab-width > strip.width - strip.content-x {
            strip.content-x = strip.width - (i + 1) * root.tab-width;
        }
    }

    // The wheel scrolls the strip; tabs pass the wheel through to here.
    TouchArea {
        x: strip.x;
        width: strip.width;
        scroll-event(event) => {
            root.scroll-by(event.delta-x + event.delta-y);
            accept
        }
    }

    strip := Flickable {
        x: Theme.inset;
        width: root.width - plus.width - 2 * Theme.inset;
        height: root.height;
        content-height: self.height;
        content-width: max(self.width, root.tabs.length * root.tab-width);
        // Scrolled by the wheel and `reveal`, so dragging a tab never pans the strip.
        interactive: false;
        // Keep the scroll position valid when tabs are closed or the window grows.
        changed content-width => { root.scroll-by(0px); }
        changed width => { root.scroll-by(0px); }

        for item[i] in root.tabs: Rectangle {
            property <bool> hovered: touch.has-hover || close-touch.has-hover;
            property <bool> is-active: item.active;
            changed is-active => {
                if self.is-active { root.reveal(i); }
            }
            init => {
                if self.is-active { root.reveal(i); }
            }

            x: i * root.tab-width;
            width: root.tab-width;
            height: parent.height;
            accessible-role: tab;
            accessible-label: item.title;
            accessible-item-selectable: true;
            accessible-item-selected: item.active;
            accessible-item-index: i;
            accessible-action-default => { root.activate(i); }

            Rectangle {
                x: 2px;
                y: (parent.height - self.height) / 2;
                width: parent.width - 4px;
                height: Theme.control-height;
                border-radius: Theme.radius;
                background: i == root.drop-tab ? Theme.drop-target : item.active ? Theme.tab-active : hovered ? Theme.hover : transparent;
                animate background { duration: Theme.motion-hover; }
                border-width: i == root.drop-tab || item.active ? 1px : 0px;
                border-color: i == root.drop-tab ? Theme.accent : Theme.border;

                touch := TouchArea {
                    clicked => {
                        if !root.dragged { root.activate(i); }
                    }
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            root.dragged = false;
                            root.drag-blocked = false;
                        }
                        if event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.drag-from >= 0 {
                            if !root.tab-out(root.drag-from, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, true) && root.drag-to != root.drag-from {
                                root.move-tab(root.drag-from, root.drag-to);
                            }
                            root.cancel-drag();
                        }
                        if event.kind == PointerEventKind.cancel {
                            root.cancel-drag();
                        }
                        if event.kind == PointerEventKind.up && event.button == PointerEventButton.middle {
                            root.close(i);
                        }
                        if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                            root.tab-menu(i, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                    moved => {
                        if self.pressed && !root.drag-blocked && (root.dragged || abs(self.mouse-x - self.pressed-x) > 6px) {
                            root.dragged = true;
                            root.drag-from = i;
                            root.drag-to = clamp(floor((i * root.tab-width + self.mouse-x) / root.tab-width), 0, root.tabs.length - 1);
                            root.away = root.tab-out(i, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, false);
                        }
                    }
                    scroll-event(event) => {
                        root.scroll-by(event.delta-x + event.delta-y);
                        accept
                    }
                }

                // The × takes room only while it is shown (active or hovered tab, not locked),
                // so a narrow tab keeps its title readable.
                property <bool> close-shown: !item.locked && (item.active || hovered);
                HorizontalLayout {
                    padding-left: Theme.spacing;
                    padding-right: 2px;
                    spacing: 0;
                    VerticalLayout {
                        alignment: center;
                        Path {
                            width: 12px;
                            height: 12px;
                            viewbox-width: 16;
                            viewbox-height: 16;
                            commands: Glyph.folder;
                            fill: Theme.icon-folder;
                        }
                    }
                    Rectangle { width: Theme.spacing; }
                    // Drawn, like the ×: a body and its shackle.
                    if item.locked: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            accessible-role: image;
                            accessible-label: "Locked";
                            Path {
                                width: parent.width;
                                height: parent.height;
                                viewbox-width: 8;
                                viewbox-height: 8;
                                commands: Glyph.lock;
                                stroke: Theme.foreground-muted;
                                stroke-width: 1px;
                                stroke-line-cap: round;
                                stroke-line-join: round;
                            }
                        }
                    }
                    if item.locked: Rectangle { width: Theme.spacing * 0.75; }
                    Text {
                        text: item.title;
                        overflow: elide;
                        horizontal-stretch: 1;
                        min-width: 0;
                        vertical-alignment: center;
                        color: item.active ? Theme.foreground : Theme.foreground-muted;
                    }
                    Rectangle {
                        width: close-shown ? Theme.icon-size + 6px : 0px;
                        visible: close-shown;
                        Rectangle {
                            x: parent.width - self.width;
                            y: (parent.height - self.height) / 2;
                            width: 20px;
                            height: self.width;
                            border-radius: Theme.radius-small;
                            background: close-touch.has-hover ? Theme.hover : transparent;
                            animate background { duration: Theme.motion-hover; }
                            accessible-role: button;
                            accessible-label: "Close " + item.title;
                            accessible-action-default => { root.close(i); }
                            // Drawn, not a "×" glyph: the software renderer has no font fallback.
                            Path {
                                width: 8px;
                                height: 8px;
                                viewbox-width: 8;
                                viewbox-height: 8;
                                commands: Glyph.close;
                                stroke: Theme.foreground-muted;
                                stroke-width: 1.5px;
                                stroke-line-cap: round;
                            }
                            close-touch := TouchArea {
                                clicked => { root.close(i); }
                                // Like the tab body: middle-click closes, right-click opens the menu.
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.up && event.button == PointerEventButton.middle {
                                        root.close(i);
                                    }
                                    if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                                        root.tab-menu(i, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                    }
                                }
                            }
                        }
                    }
                }

                // The active pane's active tab, with two panes (spec 10 §4.3).
                if item.active && root.marked: Rectangle {
                    x: Theme.radius;
                    width: parent.width - 2 * Theme.radius;
                    height: 2px;
                    background: Theme.accent;
                }

                // The active tab's accent bar.
                if item.active: Rectangle {
                    x: 12px;
                    y: parent.height - 3px - self.height;
                    width: parent.width - 24px;
                    height: 2px;
                    border-radius: 1px;
                    background: Theme.accent;
                }
            }
        }

        // Drop position while dragging.
        if root.drag-from >= 0 && !root.away: Rectangle {
            // Between two tabs; at either end, kept just inside the strip.
            x: clamp((root.drag-to > root.drag-from ? root.drag-to + 1 : root.drag-to) * root.tab-width - 1px, 0px, parent.width - self.width);
            y: (parent.height - Theme.control-height) / 2;
            width: 2px;
            height: Theme.control-height;
            background: Theme.accent;
        }
        // Where a tab dragged from the other pane would go.
        if root.insert-at >= 0: Rectangle {
            x: clamp(root.insert-at * root.tab-width - 1px, 0px, parent.width - self.width);
            y: (parent.height - Theme.control-height) / 2;
            width: 2px;
            height: Theme.control-height;
            background: Theme.accent;
        }
    }

    plus := Rectangle {
        x: strip.x + strip.width;
        width: root.height;
        height: root.height;
        accessible-role: button;
        accessible-label: "New tab";
        accessible-action-default => { root.new-tab(); }
        Rectangle {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            border-radius: Theme.radius;
            background: plus-touch.has-hover ? Theme.hover : transparent;
            animate background { duration: Theme.motion-hover; }
            Path {
                width: 16px;
                height: 16px;
                viewbox-width: 16;
                viewbox-height: 16;
                commands: Glyph.plus;
                stroke: Theme.foreground-muted;
                stroke-width: 1.5px;
                stroke-line-cap: round;
            }
            plus-touch := TouchArea {
                clicked => { root.new-tab(); }
            }
        }
    }

    if root.synced: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.accent;
    }
}
