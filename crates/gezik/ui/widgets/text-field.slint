import { Theme } from "../theme.slint";

// A single-line text box. Replaces the std-widgets LineEdit, whose colors cannot be themed.
export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <bool> enabled: true;
    // Shows dots instead of the text (a password).
    in property <bool> secret;
    callback accepted(string);
    callback edited(string);
    out property <bool> has-focus: input.has-focus;

    public function focus-and-select() {
        input.focus();
        input.select-all();
    }

    // Focuses and selects the text up to `end` (bytes): a name without its ending.
    public function focus-and-select-to(end: int) {
        input.focus();
        input.set-selection-offsets(0, end);
    }

    // Focuses with the cursor at `offset` (bytes), nothing selected.
    public function focus-at(offset: int) {
        input.focus();
        input.set-selection-offsets(offset, offset);
    }

    height: Theme.row-height + 4px;
    horizontal-stretch: 1;
    border-radius: Theme.radius;
    border-width: input.has-focus ? Theme.focus-width : 1px;
    border-color: input.has-focus ? Theme.focus-ring : Theme.border;
    background: Theme.input-background;
    forward-focus: input;
    accessible-role: text-input;
    // A password is never read out (Slint 1.18 has no password role).
    accessible-value: root.secret ? "" : root.text;

    input := TextInput {
        x: Theme.spacing + 2px;
        width: parent.width - 2 * (Theme.spacing + 2px);
        height: parent.height;
        vertical-alignment: center;
        single-line: true;
        input-type: root.secret ? InputType.password : InputType.text;
        // A TextInput's own value is its text, in clear.
        accessible-value: root.secret ? "" : root.text;
        text <=> root.text;
        color: root.enabled ? Theme.foreground : Theme.foreground-muted;
        selection-background-color: Theme.selection;
        selection-foreground-color: Theme.selection-foreground;
        enabled: root.enabled;
        accepted => { root.accepted(self.text); }
        edited => { root.edited(self.text); }
    }
}
