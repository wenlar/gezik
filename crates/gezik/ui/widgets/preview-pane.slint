import { Theme } from "../theme.slint";
import { FileIcon } from "file-icon.slint";
import { TextButton } from "text-button.slint";

// A colored piece of a viewer row at its column; `class` is gezik_core::syntax::Class (0 plain,
// 1 keyword, 2 type, 3 string, 4 number, 5 comment, 6 tag).
export struct PreviewPart {
    col: int,
    text: string,
    class: int,
    // Wide (East Asian) characters: drawn in the UI font, whose fallbacks cover them.
    wide: bool,
}

// A viewer row: its line number or offset ("" on a wrapped line's later rows) and its parts.
export struct PreviewRow {
    number: string,
    parts: [PreviewPart],
}

// A button of a PDF's or picture's bar: its text, what a screen reader says, and what it does
// (`PreviewActions.surface`'s first argument, with `step` as its dx; -1 is Hex).
export struct PreviewTool {
    text: string,
    label: string,
    what: int,
    step: int,
}

// What the preview shows; built by Rust (preview/mod.rs, preview/viewer.rs).
export struct PreviewInfo {
    // 0 nothing selected, 1 a picture, 2 text, 3 another file (its thumbnail or icon),
    // 4 a folder, 5 several items.
    kind: int,
    title: string,
    picture: image,
    has-picture: bool,
    // Lines of facts: type, size, dates, picture size, folder count.
    details: string,
    // `Kind` index, for the icon when there is no picture.
    item-kind: int,
    // The picture or text is still loading.
    loading: bool,
    // The viewer (spec 13 §3.2): 0 none, 1 text, 2 hex, 3 only a Hex button (another file),
    // 4 a PDF's pages and zoom, 5 a picture's zoom.
    bar: int,
    // The bar's right side (lines, size and place, offset) and a note before it.
    bar-text: string,
    bar-note: string,
    wrap: bool,
    // The rows from the top; `gutter` characters of line numbers or offsets before them.
    rows: [PreviewRow],
    gutter: int,
    // The widest row in columns (sideways scrolling stops at its end).
    max-cols: int,
    // The scroll bar: where the top is and how much shows, 0–1.
    scroll-pos: float,
    scroll-size: float,
    // The zoom surface (13b): `picture` drawn at this place of the preview area, not fitted.
    zoomed: bool,
    pic-x: length,
    pic-y: length,
    pic-w: length,
    pic-h: length,
    // A PDF's page from 1 (0: not a PDF) and its page count (0: not known yet).
    page: int,
    pages: int,
    // "Fit", "Fit Width" or "125%".
    zoom-text: string,
    // A button after the note ("Download", "Enter Password…"); "" for none.
    bar-link: string,
    // A PDF's or picture's bar buttons (13b), a video's or sound's (13c).
    tools: [PreviewTool],
    // A video's or sound's player (13c): the seek bar 0–1 (< 0: none), the volume 0–1 (< 0: no
    // room for its bar), muted,
    // and whether it plays (or is about to).
    seek: float,
    volume: float,
    muted: bool,
    playing: bool,
}

// The viewer's events, for Rust (one connection per window, not one per pane).
export global PreviewActions {
    // The viewer's room: whole characters across and rows down.
    callback resized(int, int);
    // Rows down (negative: up).
    callback scrolled(int);
    // To a place 0–1 (the scroll bar).
    callback jumped(float);
    callback toggle-hex();
    callback toggle-wrap();
    // A key while the viewer has the keyboard; returns whether it was used.
    callback key(KeyEvent) -> bool;
    // A right-click, at this window position.
    callback context-menu(length, length);
    // Bumped by Rust: the viewer says its room again (a window whose events were connected late).
    in property <int> ask;
    // The zoom surface (spec 13 §5), one callback for all: what (0 its size x × y, 1 dx pages,
    // 2 "Go to Page…", 3 zoom dx steps around x, y (x < 0: the middle), 4 Fit, 5 100% around
    // x, y, 6 a drag by dx, dy, 7 the wheel dx, dy at x, y, 8 the same with Ctrl or ⌘, 9 the
    // bar's link; the player (13c): 10 play or pause, 11 seek to x (0–1 in px), 12 the seek bar
    // dragged to x, 13 mute or not, 14 the volume x).
    callback surface(int, length, length, length, length);
    // The player's frame (13c), apart from `PreviewInfo`: a new frame redraws only the picture.
    in property <image> frame;
}

// A bar to drag along (the player's position and volume): `moved-to` gets 0–1, `done` on
// release.
component Track inherits TouchArea {
    in property <float> value;
    in property <string> label;
    callback moved-to(float, bool);
    min-width: 40px;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: "\{round(root.value * 100)}%";
    pointer-event(event) => {
        if event.button == PointerEventButton.left && (event.kind == PointerEventKind.down || event.kind == PointerEventKind.up) {
            root.moved-to(clamp(self.mouse-x / max(1px, self.width), 0, 1), event.kind == PointerEventKind.up);
        }
    }
    moved => {
        if self.pressed {
            root.moved-to(clamp(self.mouse-x / max(1px, self.width), 0, 1), false);
        }
    }
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.scrollbar;
    }
    Rectangle {
        x: 0;
        y: (parent.height - 4px) / 2;
        width: parent.width * clamp(root.value, 0, 1);
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
    }
}

export component PreviewPane inherits Rectangle {
    in property <PreviewInfo> info;
    // A fixed-width font for text files.
    in property <string> mono-font;
    property <bool> viewer: root.info.bar == 1 || root.info.bar == 2;
    // A playing video's frame over its poster.
    property <bool> frame-shown: root.info.bar == 6 && PreviewActions.frame.width > 0;

    background: Theme.surface;
    accessible-role: none;

    VerticalLayout {
        padding: Theme.spacing * 2;
        spacing: Theme.spacing * 2;

        Rectangle {
            vertical-stretch: 1;
            min-height: 80px;

            // The viewer's keyboard (spec 13 §3.2): a click gives it, on a file's icon too (H).
            scope := FocusScope {
                key-pressed(event) => {
                    if PreviewActions.key(event) {
                        return accept;
                    }
                    return reject;
                }
            }

            if root.viewer: viewer := Rectangle {
                // One character's width and a row's height in the fixed-width font.
                property <length> cw: max(1px, probe.preferred-width / 10);
                property <length> lh: max(1px, probe.preferred-height);
                property <length> gutter-width: root.info.gutter > 0 ? root.info.gutter * self.cw + 12px : 0px;
                property <length> text-width: self.width - self.gutter-width - 10px;
                // Sideways scroll of unwrapped lines.
                property <length> hx: 0px;
                property <int> cols: max(1, floor(self.text-width / self.cw));
                property <int> lines: max(1, floor(self.height / self.lh));
                property <int> ask: PreviewActions.ask;

                clip: true;
                init => {
                    PreviewActions.resized(self.cols, self.lines);
                }
                changed cols => {
                    PreviewActions.resized(self.cols, self.lines);
                }
                changed lines => {
                    PreviewActions.resized(self.cols, self.lines);
                }
                changed ask => {
                    PreviewActions.resized(self.cols, self.lines);
                }

                probe := Text {
                    text: "MMMMMMMMMM";
                    font-family: root.mono-font;
                    visible: false;
                }

                TouchArea {
                    clicked => {
                        scope.focus();
                    }
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                            scope.focus();
                            PreviewActions.context-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                    scroll-event(event) => {
                        if event.delta-x != 0 || event.modifiers.shift {
                            viewer.hx = root.info.wrap ? 0px : clamp(viewer.hx - (event.delta-x != 0 ? event.delta-x : event.delta-y), 0px, max(0px, root.info.max-cols * viewer.cw - viewer.text-width));
                        } else if event.delta-y > 0 {
                            PreviewActions.scrolled(-max(1, round(event.delta-y / viewer.lh)));
                        } else if event.delta-y < 0 {
                            PreviewActions.scrolled(max(1, round(-event.delta-y / viewer.lh)));
                        }
                        accept
                    }
                }

                for row[i] in root.info.rows: Rectangle {
                    y: i * viewer.lh;
                    height: viewer.lh;
                    if root.info.gutter > 0: Text {
                        x: 0;
                        width: viewer.gutter-width - 8px;
                        text: row.number;
                        horizontal-alignment: right;
                        font-family: root.mono-font;
                        color: Theme.foreground-muted;
                        accessible-role: none;
                    }
                    Rectangle {
                        x: viewer.gutter-width;
                        width: viewer.text-width;
                        clip: true;
                        for part in row.parts: Text {
                            x: part.col * viewer.cw - viewer.hx;
                            text: part.text;
                            font-family: part.wide ? Theme.font-family : root.mono-font;
                            color: part.class == 1 ? Theme.syntax-keyword
                                : part.class == 2 ? Theme.syntax-type
                                : part.class == 3 ? Theme.syntax-string
                                : part.class == 4 ? Theme.syntax-number
                                : part.class == 5 ? (root.info.bar == 2 ? Theme.foreground-muted : Theme.syntax-comment)
                                : part.class == 6 ? Theme.syntax-tag
                                : Theme.foreground;
                            accessible-role: text;
                        }
                    }
                }

                // The scroll bar: a press or a drag goes to that place.
                TouchArea {
                    property <length> thumb: min(self.height, max(24px, self.height * root.info.scroll-size));
                    x: parent.width - self.width;
                    width: 10px;
                    visible: root.info.scroll-size < 1;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            PreviewActions.jumped(clamp((self.mouse-y - self.thumb / 2) / max(1px, self.height - self.thumb), 0, 1));
                        }
                    }
                    moved => {
                        if self.pressed {
                            PreviewActions.jumped(clamp((self.mouse-y - self.thumb / 2) / max(1px, self.height - self.thumb), 0, 1));
                        }
                    }
                    Rectangle {
                        x: 2px;
                        y: (parent.height - parent.thumb) * root.info.scroll-pos;
                        width: 6px;
                        height: parent.thumb;
                        border-radius: 3px;
                        background: parent.has-hover || parent.pressed ? Theme.scrollbar-hover : Theme.scrollbar;
                    }
                }

            }

            // The picture fitted, or (zoomed, 13b) placed where Rust says and cut by the area.
            if !root.viewer && (root.info.has-picture || root.frame-shown): Rectangle {
                clip: true;
                Image {
                    x: root.info.zoomed ? root.info.pic-x : 0;
                    y: root.info.zoomed ? root.info.pic-y : 0;
                    width: root.info.zoomed ? root.info.pic-w : parent.width;
                    height: root.info.zoomed ? root.info.pic-h : parent.height;
                    source: root.frame-shown ? PreviewActions.frame : root.info.picture;
                    image-fit: root.info.zoomed ? fill : contain;
                    accessible-role: image;
                    accessible-label: root.info.pages > 0 ? "Page \{root.info.page} of \{root.info.pages}" : root.info.title;
                }
            }

            if !root.viewer && root.info.kind != 0 && !root.info.has-picture && !root.frame-shown: FileIcon {
                width: min(parent.width, parent.height, 96px);
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                kind: root.info.kind == 4 ? 0 : root.info.item-kind;
            }

            // A PDF or a picture: drag, wheel, Ctrl+wheel and double click (spec 13 §5); a video
            // or sound: a click plays or pauses (spec 13 §6).
            if root.info.bar >= 4: surface := TouchArea {
                property <length> sx;
                property <length> sy;
                property <int> ask: PreviewActions.ask;
                mouse-cursor: root.info.zoomed ? (self.pressed ? MouseCursor.grabbing : MouseCursor.grab) : MouseCursor.default;
                init => {
                    PreviewActions.surface(0, self.width, self.height, 0, 0);
                }
                changed width => {
                    PreviewActions.surface(0, self.width, self.height, 0, 0);
                }
                changed height => {
                    PreviewActions.surface(0, self.width, self.height, 0, 0);
                }
                changed ask => {
                    PreviewActions.surface(0, self.width, self.height, 0, 0);
                }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        scope.focus();
                        self.sx = self.mouse-x;
                        self.sy = self.mouse-y;
                        if event.button == PointerEventButton.right {
                            PreviewActions.context-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                }
                moved => {
                    if self.pressed && root.info.zoomed {
                        PreviewActions.surface(6, 0, 0, self.mouse-x - self.sx, self.mouse-y - self.sy);
                        self.sx = self.mouse-x;
                        self.sy = self.mouse-y;
                    }
                }
                clicked => {
                    if root.info.bar == 6 {
                        PreviewActions.surface(10, -1px, -1px, 0, 0);
                    }
                }
                double-clicked => {
                    PreviewActions.surface(5, self.mouse-x, self.mouse-y, 0, 0);
                }
                scroll-event(event) => {
                    PreviewActions.surface(event.modifiers.control || event.modifiers.meta ? 8 : 7, self.mouse-x, self.mouse-y, event.delta-x, event.delta-y);
                    accept
                }
            }

            if root.info.bar == 6 && !root.info.playing: Rectangle {
                width: 56px;
                height: 56px;
                border-radius: 28px;
                background: #000000a0;
                Text {
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    text: "▶";
                    font-size: 26px;
                    color: #ffffff;
                    accessible-role: none;
                }
            }

            if root.info.kind == 0: Text {
                width: parent.width;
                height: parent.height;
                text: "Select a file to preview";
                horizontal-alignment: center;
                vertical-alignment: center;
                color: Theme.foreground-muted;
            }

            if scope.has-focus && root.info.bar != 0: Rectangle {
                border-width: Theme.focus-width;
                border-color: Theme.focus-ring;
                border-radius: Theme.radius-small;
            }
        }

        // The viewer's bar: Text │ Hex, Wrap, a note and where it is; a PDF's pages and a
        // zoom; the player's Play, position, time and volume. In a narrow pane what does not fit gives way (the right-click menu has it all).
        if root.info.bar != 0: HorizontalLayout {
            spacing: Theme.spacing;
            if root.info.bar == 1 || root.info.bar == 2: TextButton {
                compact: true;
                text: "Text";
                checked: root.info.bar == 1;
                clicked => {
                    if root.info.bar == 2 {
                        PreviewActions.toggle-hex();
                    }
                }
            }
            if root.info.bar < 4: TextButton {
                compact: true;
                text: "Hex";
                checked: root.info.bar == 2;
                clicked => {
                    if root.info.bar != 2 {
                        PreviewActions.toggle-hex();
                    }
                }
            }
            // A PDF's or picture's buttons (Hex, ‹ page ›, − 125% +, Fit): one repeated button
            // costs far less than one each.
            for tool in root.info.tools: TextButton {
                compact: true;
                text: tool.text;
                label: tool.label;
                clicked => {
                    if tool.what < 0 {
                        PreviewActions.toggle-hex();
                    } else {
                        PreviewActions.surface(tool.what, -1px, -1px, tool.step * 1px, 0);
                    }
                }
            }
            if root.info.bar == 1: TextButton {
                compact: true;
                text: "Wrap";
                label: root.info.wrap ? "Wrap lines, on" : "Wrap lines, off";
                checked: root.info.wrap;
                clicked => {
                    PreviewActions.toggle-wrap();
                }
            }
            if root.info.bar == 6 && root.info.seek >= 0: Track {
                horizontal-stretch: 1;
                value: root.info.seek;
                label: "Position";
                moved-to(at, done) => {
                    PreviewActions.surface(done ? 11 : 12, at * 1px, 0, 0, 0);
                }
            }
            Text {
                text: root.info.bar-note;
                horizontal-stretch: root.info.bar == 6 && root.info.seek >= 0 ? 0 : 1;
                overflow: elide;
                vertical-alignment: center;
                color: Theme.foreground-muted;
            }
            Text {
                text: root.info.bar-text;
                overflow: elide;
                vertical-alignment: center;
                color: Theme.foreground-muted;
            }
            if root.info.bar == 6: TextButton {
                compact: true;
                text: "Mute";
                label: root.info.muted ? "Mute, on" : "Mute, off";
                checked: root.info.muted;
                clicked => {
                    PreviewActions.surface(13, 0, 0, 0, 0);
                }
            }
            if root.info.bar == 6 && root.info.volume >= 0: Track {
                width: 56px;
                value: root.info.muted ? 0 : root.info.volume;
                label: "Volume";
                moved-to(at, done) => {
                    PreviewActions.surface(14, at * 1px, 0, done ? 1px : 0, 0);
                }
            }
        }

        Text {
            text: root.info.title;
            font-weight: 600;
            wrap: word-wrap;
            color: Theme.foreground;
        }

        Text {
            text: root.info.details;
            wrap: word-wrap;
            color: Theme.foreground-muted;
        }
    }
}
