import { Theme } from "../theme.slint";
import { FileIcon } from "file-icon.slint";
import { TextButton } from "text-button.slint";
import { TextField } from "text-field.slint";

// A colored piece of a viewer row at its column; `class` is gezik_core::syntax::Class (0 plain,
// 1 keyword, 2 type, 3 string, 4 number, 5 comment, 6 tag).
export struct PreviewPart {
    col: int,
    text: string,
    class: int,
    // Wide (East Asian) characters: drawn in the UI font, whose fallbacks cover them.
    wide: bool,
}

// A viewer row: its line number or offset ("" on a wrapped line's later rows) and its parts.
export struct PreviewRow {
    number: string,
    parts: [PreviewPart],
}

// What the preview shows; built by Rust (preview/mod.rs, preview/viewer.rs).
export struct PreviewInfo {
    // 0 nothing selected, 1 a picture, 2 text, 3 another file (its thumbnail or icon),
    // 4 a folder, 5 several items.
    kind: int,
    title: string,
    picture: image,
    has-picture: bool,
    // Lines of facts: type, size, dates, picture size, folder count.
    details: string,
    // `Kind` index, for the icon when there is no picture.
    item-kind: int,
    // The picture or text is still loading.
    loading: bool,
    // The viewer (spec 13 §3.2): 0 none, 1 text, 2 hex, 3 only a Hex button (another file),
    // 4 a PDF's pages and zoom, 5 a picture's zoom.
    bar: int,
    // The bar's right side (lines, size and place, offset) and a note before it.
    bar-text: string,
    bar-note: string,
    wrap: bool,
    // The rows from the top; `gutter` characters of line numbers or offsets before them.
    rows: [PreviewRow],
    gutter: int,
    // The widest row in columns (sideways scrolling stops at its end).
    max-cols: int,
    // The scroll bar: where the top is and how much shows, 0–1.
    scroll-pos: float,
    scroll-size: float,
    // The zoom surface (13b): `picture` drawn at this place of the preview area, not fitted.
    zoomed: bool,
    pic-x: length,
    pic-y: length,
    pic-w: length,
    pic-h: length,
    // A PDF's page from 1 (0: not a PDF) and its page count (0: not known yet).
    page: int,
    pages: int,
    // "Fit", "Fit Width" or "125%".
    zoom-text: string,
    // A button after the note ("Download", "Enter Password…"); "" for none.
    bar-link: string,
}

// The viewer's events, for Rust (one connection per window, not one per pane).
export global PreviewActions {
    // The viewer's room: whole characters across and rows down.
    callback resized(int, int);
    // Rows down (negative: up).
    callback scrolled(int);
    // To a place 0–1 (the scroll bar).
    callback jumped(float);
    callback toggle-hex();
    callback toggle-wrap();
    // A key while the viewer has the keyboard; returns whether it was used.
    callback key(KeyEvent) -> bool;
    // A right-click, at this window position.
    callback context-menu(length, length);
    // Bumped by Rust: the viewer says its room again (a window whose events were connected late).
    in property <int> ask;
    // The zoom surface (spec 13 §5): its size; a page step or a typed page; zoom by steps
    // around a point (x < 0: the middle), Fit, 100% around a point; a drag by so much; the
    // wheel (dx, dy, with Ctrl or ⌘, at x, y); the bar's link.
    callback surface(length, length);
    callback page-step(int);
    callback go-to-page(string);
    callback zoom-step(int, length, length);
    callback fit();
    callback actual(length, length);
    callback panned(length, length);
    callback wheel(length, length, bool, length, length);
    callback link();
}

export component PreviewPane inherits Rectangle {
    in property <PreviewInfo> info;
    // A fixed-width font for text files.
    in property <string> mono-font;
    property <bool> viewer: root.info.bar == 1 || root.info.bar == 2;

    background: Theme.surface;
    accessible-role: none;

    VerticalLayout {
        padding: Theme.spacing * 2;
        spacing: Theme.spacing * 2;

        Rectangle {
            vertical-stretch: 1;
            min-height: 80px;

            // The viewer's keyboard (spec 13 §3.2): a click gives it, on a file's icon too (H).
            scope := FocusScope {
                key-pressed(event) => {
                    if PreviewActions.key(event) {
                        return accept;
                    }
                    return reject;
                }
            }

            if root.viewer: viewer := Rectangle {
                // One character's width and a row's height in the fixed-width font.
                property <length> cw: max(1px, probe.preferred-width / 10);
                property <length> lh: max(1px, probe.preferred-height);
                property <length> gutter-width: root.info.gutter > 0 ? root.info.gutter * self.cw + 12px : 0px;
                property <length> text-width: self.width - self.gutter-width - 10px;
                // Sideways scroll of unwrapped lines.
                property <length> hx: 0px;
                property <int> cols: max(1, floor(self.text-width / self.cw));
                property <int> lines: max(1, floor(self.height / self.lh));
                property <int> ask: PreviewActions.ask;

                clip: true;
                init => {
                    PreviewActions.resized(self.cols, self.lines);
                }
                changed cols => {
                    PreviewActions.resized(self.cols, self.lines);
                }
                changed lines => {
                    PreviewActions.resized(self.cols, self.lines);
                }
                changed ask => {
                    PreviewActions.resized(self.cols, self.lines);
                }

                probe := Text {
                    text: "MMMMMMMMMM";
                    font-family: root.mono-font;
                    visible: false;
                }

                TouchArea {
                    clicked => {
                        scope.focus();
                    }
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                            scope.focus();
                            PreviewActions.context-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                    scroll-event(event) => {
                        if event.delta-x != 0 || event.modifiers.shift {
                            viewer.hx = root.info.wrap ? 0px : clamp(viewer.hx - (event.delta-x != 0 ? event.delta-x : event.delta-y), 0px, max(0px, root.info.max-cols * viewer.cw - viewer.text-width));
                        } else if event.delta-y > 0 {
                            PreviewActions.scrolled(-max(1, round(event.delta-y / viewer.lh)));
                        } else if event.delta-y < 0 {
                            PreviewActions.scrolled(max(1, round(-event.delta-y / viewer.lh)));
                        }
                        accept
                    }
                }

                for row[i] in root.info.rows: Rectangle {
                    y: i * viewer.lh;
                    height: viewer.lh;
                    if root.info.gutter > 0: Text {
                        x: 0;
                        width: viewer.gutter-width - 8px;
                        text: row.number;
                        horizontal-alignment: right;
                        font-family: root.mono-font;
                        color: Theme.foreground-muted;
                        accessible-role: none;
                    }
                    Rectangle {
                        x: viewer.gutter-width;
                        width: viewer.text-width;
                        clip: true;
                        for part in row.parts: Text {
                            x: part.col * viewer.cw - viewer.hx;
                            text: part.text;
                            font-family: part.wide ? Theme.font-family : root.mono-font;
                            color: part.class == 1 ? Theme.syntax-keyword
                                : part.class == 2 ? Theme.syntax-type
                                : part.class == 3 ? Theme.syntax-string
                                : part.class == 4 ? Theme.syntax-number
                                : part.class == 5 ? (root.info.bar == 2 ? Theme.foreground-muted : Theme.syntax-comment)
                                : part.class == 6 ? Theme.syntax-tag
                                : Theme.foreground;
                            accessible-role: text;
                        }
                    }
                }

                // The scroll bar: a press or a drag goes to that place.
                TouchArea {
                    property <length> thumb: min(self.height, max(24px, self.height * root.info.scroll-size));
                    x: parent.width - self.width;
                    width: 10px;
                    visible: root.info.scroll-size < 1;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            PreviewActions.jumped(clamp((self.mouse-y - self.thumb / 2) / max(1px, self.height - self.thumb), 0, 1));
                        }
                    }
                    moved => {
                        if self.pressed {
                            PreviewActions.jumped(clamp((self.mouse-y - self.thumb / 2) / max(1px, self.height - self.thumb), 0, 1));
                        }
                    }
                    Rectangle {
                        x: 2px;
                        y: (parent.height - parent.thumb) * root.info.scroll-pos;
                        width: 6px;
                        height: parent.thumb;
                        border-radius: 3px;
                        background: parent.has-hover || parent.pressed ? Theme.scrollbar-hover : Theme.scrollbar;
                    }
                }

            }

            if !root.viewer && root.info.zoomed: Rectangle {
                clip: true;
                Image {
                    x: root.info.pic-x;
                    y: root.info.pic-y;
                    width: root.info.pic-w;
                    height: root.info.pic-h;
                    source: root.info.picture;
                    image-fit: fill;
                    accessible-role: image;
                    accessible-label: root.info.pages > 0 ? "Page \{root.info.page} of \{root.info.pages}" : root.info.title;
                }
            }

            if !root.viewer && root.info.has-picture && !root.info.zoomed: Image {
                width: parent.width;
                height: parent.height;
                source: root.info.picture;
                image-fit: contain;
                accessible-role: image;
                accessible-label: root.info.title;
            }

            if !root.viewer && root.info.kind != 0 && !root.info.has-picture: FileIcon {
                width: min(parent.width, parent.height, 96px);
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                kind: root.info.kind == 4 ? 0 : root.info.item-kind;
            }

            // A PDF or a picture: drag, wheel, Ctrl+wheel and double click (spec 13 §5).
            if root.info.bar == 4 || root.info.bar == 5: surface := TouchArea {
                property <length> sx;
                property <length> sy;
                property <int> ask: PreviewActions.ask;
                mouse-cursor: root.info.zoomed ? (self.pressed ? MouseCursor.grabbing : MouseCursor.grab) : MouseCursor.default;
                init => {
                    PreviewActions.surface(self.width, self.height);
                }
                changed width => {
                    PreviewActions.surface(self.width, self.height);
                }
                changed height => {
                    PreviewActions.surface(self.width, self.height);
                }
                changed ask => {
                    PreviewActions.surface(self.width, self.height);
                }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        scope.focus();
                        self.sx = self.mouse-x;
                        self.sy = self.mouse-y;
                        if event.button == PointerEventButton.right {
                            PreviewActions.context-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                }
                moved => {
                    if self.pressed && root.info.zoomed {
                        PreviewActions.panned(self.mouse-x - self.sx, self.mouse-y - self.sy);
                        self.sx = self.mouse-x;
                        self.sy = self.mouse-y;
                    }
                }
                double-clicked => {
                    PreviewActions.actual(self.mouse-x, self.mouse-y);
                }
                scroll-event(event) => {
                    PreviewActions.wheel(event.delta-x, event.delta-y, event.modifiers.control || event.modifiers.meta, self.mouse-x, self.mouse-y);
                    accept
                }
            }

            if root.info.kind == 0: Text {
                width: parent.width;
                height: parent.height;
                text: "Select a file to preview";
                horizontal-alignment: center;
                vertical-alignment: center;
                color: Theme.foreground-muted;
            }

            if scope.has-focus && root.info.bar != 0: Rectangle {
                border-width: Theme.focus-width;
                border-color: Theme.focus-ring;
                border-radius: Theme.radius-small;
            }
        }

        // The viewer's bar: Text │ Hex, Wrap, a note and where it is.
        if root.info.bar != 0: HorizontalLayout {
            spacing: Theme.spacing;
            if root.info.bar == 1 || root.info.bar == 2: TextButton {
                compact: true;
                text: "Text";
                checked: root.info.bar == 1;
                clicked => {
                    if root.info.bar == 2 {
                        PreviewActions.toggle-hex();
                    }
                }
            }
            TextButton {
                compact: true;
                text: "Hex";
                checked: root.info.bar == 2;
                clicked => {
                    if root.info.bar != 2 {
                        PreviewActions.toggle-hex();
                    }
                }
            }
            // A PDF's pages: ‹ the page (a click types one) of all ›.
            if root.info.bar == 4: TextButton {
                compact: true;
                text: "‹";
                label: "Previous page";
                clicked => {
                    PreviewActions.page-step(-1);
                }
            }
            if root.info.bar == 4: Rectangle {
                property <bool> editing;
                min-width: self.editing ? 48px : page-text.preferred-width;
                horizontal-stretch: 0;
                accessible-role: none;
                page-text := Text {
                    visible: !parent.editing;
                    text: root.info.pages > 0 ? "\{root.info.page} / \{root.info.pages}" : "\{root.info.page}";
                    vertical-alignment: center;
                    color: Theme.foreground;
                    accessible-role: text;
                    accessible-label: root.info.pages > 0 ? "Page \{root.info.page} of \{root.info.pages}" : "Page \{root.info.page}";
                }
                TouchArea {
                    visible: !parent.editing;
                    clicked => {
                        parent.editing = true;
                        field.focus-and-select();
                    }
                }
                field := TextField {
                    visible: parent.editing;
                    width: 48px;
                    text: root.info.page;
                    accepted(text) => {
                        parent.editing = false;
                        PreviewActions.go-to-page(text);
                        scope.focus();
                    }
                    changed has-focus => {
                        if !self.has-focus {
                            parent.editing = false;
                            self.text = root.info.page;
                        }
                    }
                }
            }
            if root.info.bar == 4: TextButton {
                compact: true;
                text: "›";
                label: root.info.pages > 0 ? "Next page, page \{root.info.page} of \{root.info.pages}" : "Next page";
                clicked => {
                    PreviewActions.page-step(1);
                }
            }
            // The zoom: − 125% + Fit.
            if root.info.bar >= 4: TextButton {
                compact: true;
                text: "−";
                label: "Zoom out";
                clicked => {
                    PreviewActions.zoom-step(-1, -1px, -1px);
                }
            }
            if root.info.bar >= 4: Text {
                text: root.info.zoom-text;
                vertical-alignment: center;
                color: Theme.foreground-muted;
            }
            if root.info.bar >= 4: TextButton {
                compact: true;
                text: "+";
                label: "Zoom in";
                clicked => {
                    PreviewActions.zoom-step(1, -1px, -1px);
                }
            }
            if root.info.bar >= 4: TextButton {
                compact: true;
                text: "Fit";
                label: root.info.bar == 4 ? "Fit the page or its width" : "Fit the picture";
                clicked => {
                    PreviewActions.fit();
                }
            }
            if root.info.bar == 1: TextButton {
                compact: true;
                text: "Wrap";
                label: root.info.wrap ? "Wrap lines, on" : "Wrap lines, off";
                checked: root.info.wrap;
                clicked => {
                    PreviewActions.toggle-wrap();
                }
            }
            Text {
                text: root.info.bar-note;
                horizontal-stretch: 1;
                overflow: elide;
                vertical-alignment: center;
                color: Theme.foreground-muted;
            }
            if root.info.bar-link != "": TextButton {
                compact: true;
                text: root.info.bar-link;
                clicked => {
                    PreviewActions.link();
                }
            }
            Text {
                text: root.info.bar-text;
                overflow: elide;
                vertical-alignment: center;
                color: Theme.foreground-muted;
            }
        }

        Text {
            text: root.info.title;
            font-weight: 600;
            wrap: word-wrap;
            color: Theme.foreground;
        }

        Text {
            text: root.info.details;
            wrap: word-wrap;
            color: Theme.foreground-muted;
        }
    }
}
