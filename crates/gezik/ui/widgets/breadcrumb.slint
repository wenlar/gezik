import { Theme } from "../theme.slint";
import { TextField } from "text-field.slint";
import { Glyph } from "../glyphs.slint";

export struct CrumbItem {
    label: string,
}

// The address bar: clickable path parts; click empty space (or call edit()) to type a path.
export component Breadcrumb inherits Rectangle {
    in property <[CrumbItem]> crumbs;
    in property <string> path-text;
    in-out property <bool> editing;
    callback crumb-clicked(int);
    callback accepted(string);
    // Where part `int` is (window x and width), each time it moves: drag.rs finds the parts
    // by it (their widths follow their text).
    callback crumb-span(int, length, length);
    // While files are dragged: the part they would drop on (-1: none).
    in property <int> drop-crumb: -1;

    height: Theme.control-height;
    horizontal-stretch: 1;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.input-background;
    accessible-role: groupbox;
    accessible-label: "Address";

    // The field's text changed by typing (not when set).
    callback edited(string);

    // Puts `text` in the field with the cursor at byte `at` (a suggestion taken).
    public function set-text(text: string, at: int) {
        field.text = text;
        field.focus-at(at);
    }

    public function edit() {
        root.editing = true;
        field.text = root.path-text;
        field.focus-and-select();
    }

    if !root.editing: Rectangle {
        // Narrower than its parts' arrows (a narrow pane): the last parts stay in view.
        min-width: 0px;
        clip: true;
        // Clicking empty space switches to typing.
        TouchArea {
            clicked => { root.edit(); }
        }
        // Puts the address in the Tab order (the field is hidden, so Tab skipped it): reached
        // by Tab or Shift+Tab, it switches to typing like Ctrl+L.
        FocusScope {
            focus-on-click: false;
            focus-gained(reason) => {
                if reason == FocusReason.tab-navigation {
                    root.edit();
                }
            }
        }
        HorizontalLayout {
            x: min(0px, parent.width - self.min-width);
            width: max(parent.width, self.min-width);
            padding-left: Theme.spacing;
            padding-right: Theme.spacing;
            alignment: start;
            for crumb[i] in root.crumbs: HorizontalLayout {
                if i > 0: Rectangle {
                    width: 8px + Theme.spacing;
                    Path {
                        width: 8px;
                        height: 8px;
                        viewbox-width: 8;
                        viewbox-height: 8;
                        commands: Glyph.chevron-right;
                        stroke: Theme.foreground-muted;
                        stroke-width: 1.2px;
                        stroke-line-cap: round;
                        stroke-line-join: round;
                    }
                }
                part := Rectangle {
                    property <length> left: self.absolute-position.x;
                    property <length> span: self.width;
                    init => { root.crumb-span(i, self.left, self.span); }
                    changed left => { root.crumb-span(i, self.left, self.span); }
                    changed span => { root.crumb-span(i, self.left, self.span); }
                    border-radius: Theme.radius-small;
                    background: i == root.drop-crumb ? Theme.drop-target : part-touch.has-hover ? Theme.hover : transparent;
                    animate background { duration: Theme.motion-hover; }
                    border-width: i == root.drop-crumb ? 1px : 0px;
                    border-color: Theme.accent;
                    // The current folder keeps its name (up to a point); the others give way first.
                    min-width: i == root.crumbs.length - 1 ? min(self.preferred-width, 120px) : 0px;
                    preferred-width: part-label.preferred-width + Theme.spacing * 2;
                    accessible-role: button;
                    accessible-label: crumb.label;
                    accessible-action-default => { root.crumb-clicked(i); }
                    part-label := Text {
                        x: Theme.spacing;
                        width: parent.width - Theme.spacing * 2;
                        height: parent.height;
                        text: crumb.label;
                        overflow: elide;
                        vertical-alignment: center;
                        color: i == root.crumbs.length - 1 ? Theme.foreground : Theme.foreground-muted;
                    }
                    part-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.crumb-clicked(i); }
                    }
                }
            }
        }
    }

    field := TextField {
        visible: root.editing;
        width: root.width;
        height: root.height;
        edited(text) => { root.edited(text); }
        accepted(text) => {
            root.editing = false;
            root.accepted(text);
        }
        // Losing the focus ends typing; the owner moves the focus on (see `editing`).
        changed has-focus => {
            if !self.has-focus { root.editing = false; }
        }
    }
}
