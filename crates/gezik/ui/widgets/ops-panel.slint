import { Theme } from "../theme.slint";
import { ToolButton } from "button.slint";
import { ScrollBar } from "scrollbar.slint";

// One row of the panel, as Rust (operations.rs) builds it: a running (or just finished)
// operation on the Current tab, or a finished job of the History (op_history.rs), which has
// a time.
export struct OpRow {
    id: int,
    // A History row: its buttons act on the History, and it has no bar and no Close.
    history: bool,
    // When a History job ended ("14:05"); empty on the Current tab.
    time: string,
    title: string,
    detail: string,
    // 0–1; below 0 while the amount is not known (scanning).
    progress: float,
    // 0 running, 1 waiting, 2 paused, 3 deciding, 4 done, 5 failed (RowState in operations.rs).
    state: int,
    can-pause: bool,
    can-resume: bool,
    can-start-now: bool,
    can-retry: bool,
    can-details: bool,
    can-show: bool,
    finished: bool,
}

// A link-like text button for the panel; without width unless `shown`.
component LinkButton inherits Rectangle {
    in property <string> text;
    in property <bool> shown: true;
    // The chosen one of a row of tabs: bold, and said so to screen readers.
    in property <bool> checked;
    callback clicked();

    width: root.shown ? label.preferred-width + Theme.spacing * 2 : 0px;
    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checked: root.checked;
    accessible-action-default => { root.clicked(); }

    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: Theme.accent;
        font-weight: root.checked ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The operations panel above the status bar. Current: one line per operation with a bar, the
// progress text and its buttons. History: the finished jobs, newest first. Both tabs use the
// same rows; a button or the bar a row does not have takes no room and is not drawn.
export component OpsPanel inherits Rectangle {
    in property <[OpRow]> rows;
    callback pause(int);
    callback resume(int);
    callback cancel(int);
    callback start-now(int);
    callback details(int);
    callback retry(int);
    callback dismiss(int);
    // 0 Current, 1 History.
    in property <int> tab;
    in property <[OpRow]> history;
    // The tabs show once there is a History to switch to.
    in property <bool> history-available;
    callback tab-chosen(int);
    callback history-show(int);
    callback history-details(int);

    property <[OpRow]> shown: root.tab == 0 ? root.rows : root.history;
    property <length> row-height: Theme.row-height + (root.tab == 0 ? 6px : 2px);
    // At most 8 rows show; the wheel scrolls the rest, and a button that gets the keyboard
    // focus scrolls its row into view (Tab reaches rows a Flickable hides, not clipped ones).
    property <length> list-height: min(root.shown.length, 8) * root.row-height;
    property <length> scroll-min: min(0px, root.list-height - root.shown.length * root.row-height);
    changed tab => { rows-list.content-y = 0; }
    // Fewer rows: the offset stays within them, so adding rows back does not jump.
    changed scroll-min => { rows-list.content-y = clamp(rows-list.content-y, root.scroll-min, 0px); }

    function reveal(index: int) {
        rows-list.content-y = clamp(rows-list.content-y, root.list-height - (index + 1) * root.row-height,
            -index * root.row-height);
    }


    background: Theme.surface;

    VerticalLayout {
        padding-left: Theme.spacing + 4px;
        padding-right: Theme.spacing;
        Rectangle {
            height: root.history-available ? Theme.row-height : 0px;
            visible: root.history-available;
            accessible-role: tab-list;
            current := LinkButton {
                x: 0;
                text: "Current";
                checked: root.tab == 0;
                accessible-role: AccessibleRole.tab;
                clicked => { root.tab-chosen(0); }
            }
            LinkButton {
                x: current.width + Theme.spacing;
                text: "History";
                checked: root.tab == 1;
                accessible-role: AccessibleRole.tab;
                clicked => { root.tab-chosen(1); }
            }
        }
        Text {
            height: root.tab == 1 && root.history.length == 0 ? Theme.row-height + 2px : 0px;
            visible: root.tab == 1 && root.history.length == 0;
            text: "No operations yet";
            vertical-alignment: center;
            color: Theme.foreground-muted;
            accessible-role: text;
        }
        Rectangle {
            height: root.list-height;
            accessible-role: list;
            accessible-label: root.tab == 0 ? "Operations" : "Operation history";
            TouchArea {
                scroll-event(event) => {
                    rows-list.content-y = clamp(rows-list.content-y + event.delta-y, root.scroll-min, 0px);
                    accept
                }
            }
            rows-list := Flickable {
              interactive: false;
              content-height: root.shown.length * root.row-height;
              VerticalLayout {
                for row[index] in root.shown: HorizontalLayout {
                    height: root.row-height;
                    accessible-role: list-item;
                    accessible-label: row.title;
                    accessible-description: row.detail;

                    Text {
                        width: row.history ? 64px + Theme.spacing * 2 : 0px;
                        text: row.time;
                        vertical-alignment: center;
                        color: Theme.foreground-muted;
                    }
                    Text {
                        text: row.title;
                        horizontal-stretch: 1;
                        min-width: 120px;
                        vertical-alignment: center;
                        overflow: elide;
                        color: Theme.foreground;
                    }
                    // The bar with a gap on each side; only the gap once the job ended.
                    Rectangle {
                        width: row.finished ? Theme.spacing * 2 : 160px + Theme.spacing * 4;
                        Rectangle {
                            x: Theme.spacing * 2;
                            y: (parent.height - self.height) / 2;
                            width: 160px;
                            height: 6px;
                            visible: !row.finished;
                            border-radius: 3px;
                            background: Theme.border;
                            accessible-role: progress-indicator;
                            accessible-value: row.progress >= 0 ? round(row.progress * 100) + "%" : "";
                            Rectangle {
                                x: 0;
                                width: row.progress >= 0 ? parent.width * clamp(row.progress, 0, 1) : parent.width * 0.3;
                                height: parent.height;
                                border-radius: 3px;
                                background: row.state == 2 || row.state == 3 ? Theme.progress-paused
                                    : row.state == 5 ? Theme.progress-error : Theme.progress;
                            }
                        }
                    }
                    Text {
                        text: row.detail;
                        min-width: row.history ? 0px : 160px;
                        vertical-alignment: center;
                        overflow: elide;
                        color: row.state == 5 ? Theme.danger : Theme.foreground-muted;
                    }
                    Rectangle { width: Theme.spacing; }
                    LinkButton {
                        text: "Show in folder";
                        shown: row.can-show;
                        visible: row.can-show;
                        clicked => { root.history-show(row.id); }
                    }
                    LinkButton {
                        text: "Start now";
                        shown: row.can-start-now;
                        visible: row.can-start-now;
                        clicked => { root.start-now(row.id); }
                    }
                    LinkButton {
                        text: "Details";
                        shown: row.can-details;
                        visible: row.can-details;
                        clicked => {
                            if row.history {
                                root.history-details(row.id);
                            } else {
                                root.details(row.id);
                            }
                        }
                    }
                    LinkButton {
                        text: "Retry";
                        shown: row.can-retry;
                        visible: row.can-retry;
                        clicked => { root.retry(row.id); }
                    }
                    ToolButton {
                        width: row.can-pause || row.can-resume ? self.height : 0px;
                        visible: row.can-pause || row.can-resume;
                        changed focused => { if self.focused { root.reveal(index); } }
                        text: row.can-pause ? "Pause" : "Resume";
                        icon: row.can-pause ? "M 5 3 L 5 13 M 11 3 L 11 13" : "M 5 3 L 13 8 L 5 13 Z";
                        clicked => {
                            if row.can-pause {
                                root.pause(row.id);
                            } else {
                                root.resume(row.id);
                            }
                        }
                    }
                    // History rows have no Close.
                    ToolButton {
                        width: row.history ? 0px : self.height;
                        visible: !row.history;
                        changed focused => { if self.focused { root.reveal(index); } }
                        text: row.finished ? "Close" : "Cancel";
                        icon: "M 4 4 L 12 12 M 12 4 L 4 12";
                        clicked => {
                            if row.finished {
                                root.dismiss(row.id);
                            } else {
                                root.cancel(row.id);
                            }
                        }
                    }
                }
              }
            }
            // Where the rows shown are, when there are more than eight.
            ScrollBar {
                x: parent.width - self.width;
                height: root.list-height;
                value <=> rows-list.content-y;
                maximum: -root.scroll-min;
                page-size: root.list-height;
            }
        }
    }
}
