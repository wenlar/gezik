import { Theme } from "../theme.slint";
import { TextButton } from "text-button.slint";
import { TextField } from "text-field.slint";
import { Check } from "check.slint";
import { ListView } from "scrollbar.slint";

// A row of a tool table: a name, the values in a fixed-width font (padded by Rust so they line
// up under `columns`), a status.
export struct ToolRow {
    name: string,
    values: string,
    status: string,
    // 0 plain, 1 good, 2 bad.
    tone: int,
    selected: bool,
}

// A box over the table (an algorithm, a filter).
export struct ToolToggle {
    label: string,
    checked: bool,
}

// The one table every tool layer shows (spec 11 §3.1: Checksums now; later the copy check,
// folder compare and duplicates): a title with boxes, an optional field, column titles, the
// rows, a status line and a strip of buttons. One instance in app.slint serves them all, so a
// new tool adds Rust, not Slint. Keys (Esc, Ctrl+C, Ctrl+A) are routed by main.rs.
export component ToolTable inherits Rectangle {
    in property <bool> open;
    in property <bool> dialog-open;
    in property <int> focus-request;
    in property <string> title;
    in property <string> mono-font;
    in property <[ToolToggle]> toggles;
    // Empty: no field.
    in property <string> field-label;
    in-out property <string> field-text;
    // The field has the keyboard: Ctrl+C and Ctrl+A are its own then.
    in-out property <bool> field-focused;
    // The titles of the fixed-width part, padded like the rows' values.
    in property <string> columns;
    in property <[ToolRow]> rows;
    in property <string> summary;
    // 0 plain, 1 good, 2 bad.
    in property <int> summary-tone;
    // The last one is the close button.
    in property <[string]> buttons;
    in-out property <length> scroll;
    callback toggle(int);
    callback field-edited();
    callback pressed(int, bool, bool);
    callback button(int);

    // Built when it opens (an `if` in app.slint): the list takes the keyboard then, and again
    // each time `focus-request` changes.
    init => {
        if root.open && !root.dialog-open {
            scope.focus();
        }
    }
    changed focus-request => {
        if !root.dialog-open {
            scope.focus();
        }
    }

    background: Theme.overlay;
    // Clicks outside the box go nowhere.
    TouchArea { }

    Rectangle {
        width: min(1100px, root.width - 48px);
        height: min(640px, root.height - 48px);
        x: (root.width - self.width) / 2;
        y: max(24px, (root.height - self.height) / 3);
        background: Theme.surface-raised;
        border-radius: Theme.radius * 1.5;
        border-width: 1px;
        border-color: Theme.border;
        accessible-role: groupbox;
        accessible-label: root.title;

        VerticalLayout {
            padding: Theme.spacing * 3;
            spacing: Theme.spacing * 1.5;

            HorizontalLayout {
                spacing: Theme.spacing * 2;
                Text {
                    text: root.title;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                    color: Theme.foreground;
                }
                for toggle[i] in root.toggles: Check {
                    text: toggle.label;
                    checked: toggle.checked;
                    toggled => { root.toggle(i); }
                }
            }
            if root.field-label != "": HorizontalLayout {
                spacing: Theme.spacing;
                Text {
                    text: root.field-label;
                    vertical-alignment: center;
                    color: Theme.foreground-muted;
                }
                TextField {
                    text <=> root.field-text;
                    edited => { root.field-edited(); }
                    changed has-focus => { root.field-focused = self.has-focus; }
                }
            }

            header := HorizontalLayout {
                property <length> name-width: (self.width - 120px) * 0.3;
                padding-left: Theme.spacing;
                padding-right: 10px;
                spacing: Theme.spacing * 2;
                Text { text: "Name"; width: header.name-width; color: Theme.foreground-muted; }
                Text {
                    text: root.columns;
                    font-family: root.mono-font;
                    overflow: elide;
                    color: Theme.foreground-muted;
                }
                Text { text: "Status"; width: 110px; color: Theme.foreground-muted; }
            }
            Rectangle { height: 1px; background: Theme.border; }

            scope := FocusScope {
                vertical-stretch: 1;
                ListView {
                    content-y <=> root.scroll;
                    for row[i] in root.rows: line := Rectangle {
                        property <color> fg: row.selected ? Theme.selection-foreground : Theme.foreground;
                        height: Theme.row-height;
                        background: row.selected ? Theme.selection : touch.has-hover ? Theme.hover : transparent;
                        accessible-role: list-item;
                        accessible-label: row.name;
                        accessible-value: row.values;
                        accessible-description: row.status;
                        accessible-item-selectable: true;
                        accessible-item-selected: row.selected;
                        accessible-item-index: i;

                        touch := TouchArea {
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                    scope.focus();
                                    root.pressed(i, event.modifiers.control || event.modifiers.meta, event.modifiers.shift);
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: Theme.spacing;
                            spacing: Theme.spacing * 2;
                            Text {
                                text: row.name;
                                width: header.name-width;
                                vertical-alignment: center;
                                overflow: elide;
                                color: line.fg;
                            }
                            Text {
                                text: row.values;
                                font-family: root.mono-font;
                                vertical-alignment: center;
                                overflow: elide;
                                color: line.fg;
                            }
                            Text {
                                text: row.status;
                                width: 110px;
                                vertical-alignment: center;
                                overflow: elide;
                                color: row.tone == 1 ? Theme.success : row.tone == 2 ? Theme.danger : line.fg;
                            }
                        }
                    }
                }
            }

            Text {
                text: root.summary;
                wrap: word-wrap;
                color: root.summary-tone == 1 ? Theme.success : root.summary-tone == 2 ? Theme.danger : Theme.foreground-muted;
            }
            HorizontalLayout {
                spacing: Theme.spacing;
                for label[k] in root.buttons: TextButton {
                    text: label;
                    primary: k == root.buttons.length - 1;
                    clicked => { root.button(k); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}
