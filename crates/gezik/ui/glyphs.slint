// Gezik's glyphs (design round 1, glyph sheet): SVG path commands, each drawn by one Path.
// 16×16 box, stroke 1.5, unless noted; the 8×8 ones are stroked 1.2. Round caps and joins.
export global Glyph {
    out property <string> back: "M13 8H3.5M7.5 4 3.5 8l4 4";
    out property <string> forward: "M3 8h9.5M8.5 4l4 4-4 4";
    out property <string> up: "M8 13V3.5M4 7.5l4-4 4 4";
    out property <string> refresh: "M12.5 8a4.5 4.5 0 1 1-1.3-3.2M12.5 2.5v2.8H9.7";
    out property <string> plus: "M8 3.5v9M3.5 8h9";
    // Three lines (the View button).
    out property <string> view: "M2.5 3.5h11M2.5 8h11M2.5 12.5h11";
    // A clock (History).
    out property <string> history: "M8 4.5V8l2.5 1.5M14 8A6 6 0 1 1 2 8a6 6 0 0 1 12 0Z";
    // Filled, not stroked: the tab's folder.
    out property <string> folder: "M1.5 4a1 1 0 0 1 1-1h3.8l1.5 1.6h5.7a1 1 0 0 1 1 1V12a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1Z";
    // 8×8 box.
    out property <string> close: "M1.5 1.5l5 5M6.5 1.5l-5 5";
    out property <string> chevron-down: "M1.5 3 4 5.5 6.5 3";
    out property <string> chevron-up: "M1.5 5 4 2.5 6.5 5";
    out property <string> chevron-right: "M3 1.5 5.5 4 3 6.5";
    out property <string> lock: "M2 3.5V2.5a2 2 0 0 1 4 0v1M1.5 3.5h5v4h-5Z";
}
