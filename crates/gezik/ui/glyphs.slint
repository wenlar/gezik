    out property <string> two-panes: "M2.5 3h4.5v10H2.5ZM9 3h4.5v10H9Z";
    out property <string> stack: "M2.5 6 8 3l5.5 3L8 9ZM2.5 9.5 8 12.5l5.5-3";
    // Three dots (the ⋯ button), stroked 2.2: the round caps draw them.
    out property <string> more: "M3.5 8h.01M8 8h.01M12.5 8h.01";
