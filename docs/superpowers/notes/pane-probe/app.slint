// 10a-0 probe window: one or two PaneViews from a [PaneData] model (the spec's §3.2 way).
import { PaneView, PaneData, Row } from "pane.slint";
export { PaneData, Row }

export component AppWindow inherits Window {
    in property <[PaneData]> panes;
    in property <bool> own-tab: true;
    in property <bool> drag-active;
    in property <length> drag-x;
    in property <length> drag-y;
    in-out property <length> col-size: 80px;

    callback item-pressed(int, int);
    callback key(int, string) -> bool;
    callback window-key(KeyEvent) -> bool;
    callback tab(int, bool);
    callback scrolled(int, length);
    callback rename-edited(int, string);
    callback rename-done(int, string);
    callback focus-changed(int, bool);
    callback drag-start(int, int);
    callback drag-move(int, length, length);
    callback drag-end(int, length, length);
    callback drop-target(int, int);
    callback ready(int, length);
    callback geometry(int, length, length, length, length);
    pure callback row-eval(int, string) -> bool;

    width: 1000px;
    height: 700px;
    title: "pane probe";

    // Gezik's window-wide key capture (app.slint `keys`), kept: Rust knows the active pane.
    FocusScope {
        focus-on-click: false;
        changed has-focus => { root.focus-changed(99, self.has-focus); }
        capture-key-pressed(e) => { return root.window-key(e) ? accept : reject; }
        HorizontalLayout {
            spacing: 2px;
            for p[i] in root.panes: PaneView {
                data: p;
                index: i;
                own-tab: root.own-tab;
                drag-active: root.drag-active;
                drag-x: root.drag-x;
                drag-y: root.drag-y;
                col-size: root.col-size;
                item-pressed(a, b) => { root.item-pressed(a, b); }
                key(a, b) => { return root.key(a, b); }
                tab(a, b) => { root.tab(a, b); }
                scrolled(a, b) => { root.scrolled(a, b); }
                rename-edited(a, b) => { root.rename-edited(a, b); }
                rename-done(a, b) => { root.rename-done(a, b); }
                focus-changed(a, b) => { root.focus-changed(a, b); }
                drag-start(a, b) => { root.drag-start(a, b); }
                drag-move(a, b, c) => { root.drag-move(a, b, c); }
                drag-end(a, b, c) => { root.drag-end(a, b, c); }
                drop-target(a, b) => { root.drop-target(a, b); }
                ready(a, b) => { root.ready(a, b); }
                geometry(a, b, c, d, e) => { root.geometry(a, b, c, d, e); }
                row-eval(a, b) => { return root.row-eval(a, b); }
            }
        }
    }
}
